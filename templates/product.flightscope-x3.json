    "faq_XCJKJW": {
      "type": "faq",
      "blocks": {
        "question_gYV6hJ": {
          "type": "question",
          "settings": {
            "title": "Fusion Tracking",
            "answer": "<p>The X3 with patented Fusion Tracking technology introduces a new level of accuracy and consistency on full swing and short game data parameters</p>"
          }
        },
        "question_L8qgfT": {
          "type": "question",
          "settings": {
            "title": "50 Data Parameters",
            "answer": "<p>With 50 data parameters, including the essential data like club path, face angle, angle of attack, and face impact location, the X3 provides a world class offering and experience.</p>"
          }
        },
        "question_xB9Y3P": {
          "type": "question",
          "settings": {
            "title": "Face Impact Location",
            "answer": "<p>Choose from different Face Impact Location screens to view and analyze the precise ball impact location on the club face for every shot.</p>"
          }
        },
        "question_pEJtiB": {
          "type": "question",
          "settings": {
            "title": "Advanced Chipping and Putting Data",
            "answer": "<p>Powered by patented FlightScope Fusion Tracking technology, the X3 provides accurate and consistent chipping and putting data giving users short game insights for teaching, fitting, and practice.</p>"
          }
        },
        "question_7PNgNp": {
          "type": "question",
          "settings": {
            "title": "Practice Anywhere",
            "answer": "<p>Mevo+ Limited Edition includes ownership of 12 E6 Connect simulated golf courses straight out of the box - no additional license fee or subscription required.</p>"
          }
        },
        "question_N7gMKE": {
          "type": "question",
          "settings": {
            "title": "Video and Data Lesson Recordings",
            "answer": "<p>Automatically records, clips and saves action video clips with data overlay for users to review their swing and data together. Users also have the ability to draw lines and circles as well as record a voiceover with comments and tips to send after a lesson, fitting, or practice.</p>"
          }
        },
        "question_7xDEEW": {
          "type": "question",
          "settings": {
            "title": "Environmental Optimizer",
            "answer": "<p>Adjust your environment to plan and prepare for all weather conditions and landscapes. The Environmental Optimizer allows you to configure the impact of altitude, air temperature, humidity, wind speed, wind direction, and relative landing height.</p>"
          }
        },
        "question_pfNqNB": {
          "type": "question",
          "settings": {
            "title": "Specifications",
            "answer": "<p><strong>Product Dimensions: ‎8.2 x 8 x 2.4 inches; 16 Ounces</strong></p><p>Batteries: ‎ 1 Lithium Polymer batteries required. (included)</p><p>Apple:</p><ul><li>iPhones / iPads with:</li></ul><p></p><ul><li>iOS 14 or later</li><li>Bluetooth LE 4.0 - supports UART/Serial Port Emulation service with RX and TX characteristics</li><li>Visit Apple Support for more information.</li></ul><p></p><p><strong>Android:</strong></p><p></p><ul><li>Android 6.0 or later (devices made in 2015 or later)</li><li>Bluetooth LE 4.0 - supports UART/Serial Port Emulation service with RX and TX characteristics</li></ul>"
          }
        },
        "question_FhfDyD": {
          "type": "question",
          "settings": {
            "title": "Shipping & Returns",
            "answer": "<p>FREE UPS Ground Shipping in the USA. Note: There are <span style=\"text-decoration:underline\">no returns </span>on this item.</p>"
          }
        }
