        "question_3wAELt": {
          "type": "question",
          "settings": {
            "title": "What's the difference between the Net Return Simulator Series golf bay and the regular Net Return nets?",
            "answer": "<p>A <a href=\"https://www.thenetreturn.com/collections/simulation/?simulator-bays\" title=\"https://www.thenetreturn.com/collections/simulation/?simulator-bays\">Simulator Series Golf Bay</a> is exclusively designed for indoor use and more practical for stationary settings.</p><p>In contrast, a Home or Pro Series net is more portable and versatile, suitable for both indoor and outdoor use, and equipped for multisport activities.</p>"
          }
        },
        "question_kUfUfG": {
          "type": "question",
          "settings": {
            "title": "Can I turn my Home or Pro Series into a golf simulator?",
            "answer": "<p>Yes, we offer Sim Kits for both the Home and Pro Series, allowing you to attach a simulator screen and darkening <a href=\"https://www.thenetreturn.com/products/simulator-valence\"><span style=\"text-decoration:underline\">valance</span></a> to your net. This is a great option for golfers who want a hybrid setup for both traditional and simulator-based practice. Explore our line of Simulator kits tailored to your specific Pro or Home Series net for a seamless conversion.</p>"
          }
        },
