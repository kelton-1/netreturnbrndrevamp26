          }
        },
        "question_CrK7KV": {
          "type": "question",
          "settings": {
            "title": "What all is included in a Net Return Package?",
            "answer": "<p>Net Return Packages include a Net, Side Barriers, Turf, 4 Sandbags, 2 Rubber Tees, and a Duffle Bag.</p>"
