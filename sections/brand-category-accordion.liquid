{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign show_badge = section.settings.show_concept_badge
-%}

<section
  class="brand-category-accordion"
  data-brand-category-accordion
  {% if heading != blank %}aria-labelledby="brand-category-accordion-heading-{{ section.id }}"{% endif %}
>
  {%- if show_badge -%}
    <span class="brand-category-accordion__badge" aria-hidden="true">Concept A · Accordion</span>
  {%- endif -%}

  <div class="brand-container brand-category-accordion__container">
    {%- if eyebrow != blank or heading != blank -%}
      <header class="brand-category-accordion__header">
        {%- if eyebrow != blank -%}
          <p class="brand-eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 id="brand-category-accordion-heading-{{ section.id }}" class="brand-category-accordion__heading">{{ heading }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ul class="brand-category-accordion__panels" role="list">
      {%- for block in section.blocks limit: 4 -%}
        {%- liquid
          assign label = block.settings.label
          assign description = block.settings.description
          assign link = block.settings.link
          assign cta = block.settings.cta_text | default: 'Shop now'
          assign image = block.settings.image
          assign default_image_filename = block.settings.default_image_filename
          assign featured_product = block.settings.featured_product
          assign featured_label = block.settings.featured_label | default: 'Featured'
          assign panel_index_str = forloop.index | prepend: '0' | slice: -2, 2
        -%}
        {%- if label != blank -%}
          <li
            class="brand-category-accordion__panel"
            data-panel-index="{{ forloop.index }}"
            {{ block.shopify_attributes }}
          >
            <a
              class="brand-category-accordion__link"
              href="{{ link | default: '#' }}"
              aria-label="{{ label | escape }}"
            >
              <div class="brand-category-accordion__photo" aria-hidden="true">
                {%- if image != blank -%}
                  <img
                    class="brand-category-accordion__image"
                    src="{{ image | image_url: width: 1400 }}"
                    srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1000 }} 1000w, {{ image | image_url: width: 1400 }} 1400w"
                    sizes="(max-width: 999px) 100vw, (max-width: 1400px) 60vw, 800px"
                    alt="{{ image.alt | default: label | escape }}"
                    loading="lazy"
                    width="1400"
                    height="1750">
                {%- elsif default_image_filename != blank -%}
                  <img
                    class="brand-category-accordion__image"
                    src="{{ default_image_filename | asset_url }}"
                    alt="{{ label | escape }}"
                    loading="lazy"
                    width="1400"
                    height="1750">
                {%- endif -%}
              </div>

              <div class="brand-category-accordion__content">
                <p class="brand-category-accordion__index" aria-hidden="true">
                  <span class="brand-plus" aria-hidden="true"></span>
                  {{ panel_index_str }} · Category
                </p>

                <h3 class="brand-category-accordion__label">{{ label }}</h3>

                <div class="brand-category-accordion__expanded">
                  {%- if description != blank -%}
                    <p class="brand-category-accordion__description">{{ description }}</p>
                  {%- endif -%}

                  {%- if featured_product != blank -%}
                    <div class="brand-category-accordion__featured">
                      {%- if featured_product.featured_image != blank -%}
                        <img
                          class="brand-category-accordion__featured-image"
                          src="{{ featured_product.featured_image | image_url: width: 160 }}"
                          alt="{{ featured_product.title | escape }}"
                          loading="lazy"
                          width="80"
                          height="80">
                      {%- endif -%}
                      <div class="brand-category-accordion__featured-text">
                        <p class="brand-category-accordion__featured-label">{{ featured_label }}</p>
                        <p class="brand-category-accordion__featured-title">{{ featured_product.title }}</p>
                        {%- if featured_product.price != blank -%}
                          <p class="brand-category-accordion__featured-price">{{ featured_product.price | money }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}

                  <span class="brand-btn brand-btn--primary brand-category-accordion__cta">
                    {{ cta }}
                    <span class="brand-category-accordion__cta-arrow" aria-hidden="true">→</span>
                  </span>
                </div>
              </div>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% javascript %}
  (function () {
    var sections = document.querySelectorAll('[data-brand-category-accordion]:not([data-brand-accordion-bound])');
    if (!sections.length) return;

    sections.forEach(function (section) {
      section.setAttribute('data-brand-accordion-bound', '1');

      // Viewport gate for the Ken Burns drift on the expanded photo so the
      // motion only starts once the section is genuinely on-screen.
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              section.classList.add('is-in-view');
              io.unobserve(section);
            }
          });
        }, { threshold: 0.25 });
        io.observe(section);
      } else {
        section.classList.add('is-in-view');
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Brand category accordion",
  "tag": "section",
  "class": "brand-category-accordion-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Horizontal accordion of 4 category panels. At rest each is equal width, showing photo + label. Hovering any panel expands it to ~58% width and reveals a description, optional featured product, and an Emerald CTA — the other panels compress to ~14%. Mobile collapses to a static vertical stack with everything visible."
    },
    {
      "type": "checkbox",
      "id": "show_concept_badge",
      "label": "Show 'Concept A' badge (for preview)",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (mono caps)",
      "default": "Shop the system"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start with the net. Build around your space."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category panel",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description (shown when panel is expanded)",
          "default": "Describe this category in one or two short sentences."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Panel link"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Shop now"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "default_image_filename",
          "label": "Fallback theme asset filename"
        },
        {
          "type": "header",
          "content": "Featured product (optional)"
        },
        {
          "type": "product",
          "id": "featured_product",
          "label": "Featured product"
        },
        {
          "type": "text",
          "id": "featured_label",
          "label": "Featured label",
          "default": "Featured"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand category accordion",
      "settings": {
        "eyebrow": "Shop the system",
        "heading": "Start with the net. Build around your space."
      },
      "blocks": [
        { "type": "category", "settings": { "label": "Nets",        "description": "Patented S-shape returns the ball to your feet. Five sizes — garage to backyard to commercial-grade.",       "cta_text": "Shop nets",        "link": "/collections/nets-1",              "default_image_filename": "brand-category-nets.jpg" } },
        { "type": "category", "settings": { "label": "Packages",    "description": "Net, mat, side barriers, sandbags, tees, and a duffel — bundled to swing the day it lands.",                  "cta_text": "Shop packages",    "link": "/collections/packages",            "default_image_filename": "brand-category-packages.jpg" } },
        { "type": "category", "settings": { "label": "Simulation",  "description": "Pair a Net Return with a launch monitor and screen. Tour-grade simulation, at home.",                          "cta_text": "Shop simulation",  "link": "/collections/simulation",          "default_image_filename": "brand-category-simulation.jpg" } },
        { "type": "category", "settings": { "label": "Accessories", "description": "Frame pads, training aids, and sim add-ons. Finish, protect, and extend your setup.",                          "cta_text": "Shop accessories", "link": "/collections/general-accessories", "default_image_filename": "brand-category-accessories.jpg" } }
      ]
    }
  ]
}
{% endschema %}
