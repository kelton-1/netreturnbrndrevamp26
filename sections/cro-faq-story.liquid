{%- if section.settings.background != 'rgba(0,0,0,0)' and section.settings.background != blank -%}
  {%- assign section_background = section.settings.background -%}
{%- else -%}
  {%- assign section_background = settings.background -%}
{%- endif -%}

{%- if section.settings.text_color != 'rgba(0,0,0,0)' and section.settings.text_color != blank -%}
  {%- assign section_text = section.settings.text_color -%}
{%- else -%}
  {%- assign section_text = settings.text_color -%}
{%- endif -%}

{%- assign story_media = product.media | where: 'media_type', 'image' -%}

<style>
  #shopify-section-{{ section.id }}{
    --cro-faq-bg: {{ section_background.red }}, {{ section_background.green }}, {{ section_background.blue }};
    --cro-faq-text: {{ section_text.red }}, {{ section_text.green }}, {{ section_text.blue }};
  }
</style>

<section class="section section--flush cro-faq-story-section">
  <div class="section__color-wrapper" style="background: rgb(var(--cro-faq-bg)); color: rgb(var(--cro-faq-text));">
    <div class="container">
      <div class="cro-faq-story">
        <div class="cro-faq-story__intro">
          {%- if section.settings.title != blank -%}
            <h2 class="cro-faq-story__title heading h1">{{ section.settings.title | escape }}</h2>
          {%- endif -%}

          {%- if story_media.size > 0 -%}
            <div class="cro-faq-story__avatars" aria-hidden="true">
              {%- for media in story_media limit: 3 -%}
                {{ media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 90, 120', class: 'cro-faq-story__avatar' }}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if section.settings.content != blank -%}
            <div class="rte cro-faq-story__content">
              {{ section.settings.content }}
            </div>
          {%- endif -%}
        </div>

        <div class="cro-faq-story__items">
          {%- for block in section.blocks -%}
            {%- if block.type == 'question' and block.settings.title != blank -%}
              <details class="cro-faq-story__item" {{ block.shopify_attributes }}>
                <summary class="cro-faq-story__question">
                  <span>{{ block.settings.title }}</span>
                  <span class="cro-faq-story__plus" aria-hidden="true"></span>
                </summary>
                {%- if block.settings.answer != blank -%}
                  <div class="rte cro-faq-story__answer">
                    {{ block.settings.answer }}
                  </div>
                {%- endif -%}
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .cro-faq-story{
    display:grid;
    grid-template-columns:minmax(280px, 480px) minmax(0, 1fr);
    gap:56px;
    align-items:start;
    padding:72px 0;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__intro{
    min-width:0;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__title{
    margin:0 0 28px;
    font-size:clamp(42px, 5vw, 58px);
    line-height:0.98;
    letter-spacing:-0.04em;
    color:#101828;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__avatars{
    display:flex;
    align-items:center;
    margin:0 0 20px;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__avatar{
    width:60px;
    height:60px;
    border-radius:999px;
    object-fit:cover;
    border:3px solid #fff;
    box-shadow:0 8px 24px rgba(16,16,16,.08);
  }
  #shopify-section-{{ section.id }} .cro-faq-story__avatar + .cro-faq-story__avatar{
    margin-left:-12px;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__content{
    max-width:480px;
    font-size:17px;
    line-height:1.6;
    color:#5a6473;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__items{
    min-width:0;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__item{
    border-bottom:1px solid rgba(16,16,16,.08);
  }
  #shopify-section-{{ section.id }} .cro-faq-story__question{
    list-style:none;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    width:100%;
    padding:26px 0;
    cursor:pointer;
    font-size:18px;
    font-weight:700;
    line-height:1.35;
    color:#18243a;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__question::-webkit-details-marker{
    display:none;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__plus{
    position:relative;
    flex:0 0 18px;
    width:18px;
    height:18px;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__plus::before,
  #shopify-section-{{ section.id }} .cro-faq-story__plus::after{
    content:"";
    position:absolute;
    top:50%;
    left:50%;
    width:18px;
    height:2px;
    border-radius:999px;
    background:#18243a;
    transform:translate(-50%, -50%);
    transition:transform .2s ease, opacity .2s ease;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__plus::after{
    transform:translate(-50%, -50%) rotate(90deg);
  }
  #shopify-section-{{ section.id }} .cro-faq-story__item[open] .cro-faq-story__plus::after{
    opacity:0;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__answer{
    padding:0 0 24px;
    color:#4b5563;
  }
  #shopify-section-{{ section.id }} .cro-faq-story__answer p:last-child{
    margin-bottom:0;
  }

  @media(max-width:999px){
    #shopify-section-{{ section.id }} .cro-faq-story{
      grid-template-columns:1fr;
      gap:28px;
      padding:48px 0;
    }
  }

  @media(max-width:767px){
    #shopify-section-{{ section.id }} .cro-faq-story__title{
      font-size:clamp(34px, 10vw, 44px);
      margin-bottom:20px;
    }
    #shopify-section-{{ section.id }} .cro-faq-story__avatar{
      width:52px;
      height:52px;
    }
    #shopify-section-{{ section.id }} .cro-faq-story__content{
      font-size:16px;
    }
    #shopify-section-{{ section.id }} .cro-faq-story__question{
      padding:20px 0;
      font-size:16px;
    }
  }
</style>

{% schema %}
{
  "name": "CRO FAQ Story",
  "class": "shopify-section--cro-faq-story",
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "title", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Premium Practice. Zero Fluff." },
    { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Built for serious practice with premium materials and no gimmicks.</p>" },
    { "type": "checkbox", "id": "show_navigation", "label": "Show navigation", "default": false },
    { "type": "color", "id": "background", "label": "Background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "rgba(0,0,0,0)" }
  ],
  "presets": [
    {
      "name": "CRO FAQ Story"
    }
  ]
}
{% endschema %}
