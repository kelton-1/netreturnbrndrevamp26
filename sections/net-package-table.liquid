<section class="comparison-wrapper">

  <!-- ===== Heading ===== -->
  <div class="compare-heading">
    <p class="compare-label">{{ section.settings.small_text }}</p>
    <h2 class="compare-title">{{ section.settings.heading }}</h2>
  </div>

  <!-- ===== Comparison Table ===== -->
  <div class="compare-table-scroll">
    <table class="compare-table">
      <thead>
        <tr>
          <th></th>
          <th data-key="home_package">Home Package</th>
          <th data-key="pro_package">Pro Package</th>
          <th data-key="pro_8_package">Pro 8 Package</th>
          <th data-key="pro_9_package">Pro 9 Package</th>
          <th data-key="pro_10_package">Pro 10 Package</th>
          <th data-key="mini_package">Mini Package</th>
          <th data-key="pro_xl_package">Pro XL Package</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td class="text-left">Size (W × H)</td>
          <td data-key="home_package">7' × 7'</td>
          <td data-key="pro_package">8' × 7'6"</td>
          <td data-key="pro_8_package">8' × 8'</td>
          <td data-key="pro_9_package">9' × 8'</td>
          <td data-key="pro_10_package">10' × 8'</td>
          <td data-key="mini_package">5' × 6'</td>
          <td data-key="pro_xl_package">10' × 9'6"</td>
        </tr>

        <tr>
          <td class="text-left">Ideal For</td>
          <td data-key="home_package">Home/Garage</td>
          <td data-key="pro_package">Home/Garage</td>
          <td data-key="pro_8_package">Garage/Yard</td>
          <td data-key="pro_9_package">Large Yard</td>
          <td data-key="pro_10_package">Commercial</td>
          <td data-key="mini_package">Small Spaces</td>
          <td data-key="pro_xl_package">Pro Training</td>
        </tr>

        <tr>
          <td class="text-left">Ball Return</td>
          <td data-key="home_package">✔</td>
          <td data-key="pro_package">✔</td>
          <td data-key="pro_8_package">✔</td>
          <td data-key="pro_9_package">✔</td>
          <td data-key="pro_10_package">✔</td>
          <td data-key="mini_package">✔</td>
          <td data-key="pro_xl_package">✔</td>
        </tr>

        <tr>
          <td class="text-left">Max Ball Speed</td>
          <td data-key="home_package">225 MPH</td>
          <td data-key="pro_package">225 MPH</td>
          <td data-key="pro_8_package">225 MPH</td>
          <td data-key="pro_9_package">225 MPH</td>
          <td data-key="pro_10_package">225 MPH</td>
          <td data-key="mini_package">225 MPH</td>
          <td data-key="pro_xl_package">225 MPH</td>
        </tr>

        <tr>
          <td class="text-left">Price</td>
          <td data-key="home_package">$1499</td>
          <td data-key="pro_package">$1599</td>
          <td data-key="pro_8_package">$1699</td>
          <td data-key="pro_9_package">$1799</td>
          <td data-key="pro_10_package">$2497</td>
          <td data-key="mini_package">$1199</td>
          <td data-key="pro_xl_package">$1399</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<!-- ===== Styles ===== -->
<style>
.text-left{text-align:left;}
.comparison-wrapper {
  max-width: 1266px;
  margin: auto;
  padding: 60px 20px;
}

.compare-heading {
  text-align: left;
  margin-bottom: 30px;
}

.compare-label {
  color: #00a651;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.compare-title {
  font-size: 32px;
  font-weight: 700;
  margin-top: 0;
}

.compare-table-scroll {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.compare-table {
  width: 100%;
  min-width: 900px;
  border-collapse: collapse;
  text-align: center;
}

.compare-table th,
.compare-table td {
  padding: 14px;
  border-bottom: 1px solid #eee;
}

/* 🔥 Highlight active column */
.compare-table .active-product {
  color: #00a651;
  font-weight: 600;
  {% comment %} background: rgba(0, 166, 81, 0.08); {% endcomment %}
}
</style>

<!-- ===== Script ===== -->
<script>
document.addEventListener("DOMContentLoaded", function () {

  /* 🔑 Product handle → column key mapping */
  var handleMap = {
    "home-golf-net-package": "home_package",
    "pro-package-golf-net-setup": "pro_package",
    "pro-series-large-8-pro-package": "pro_8_package",
    "pro-series-large-9-pro-package-golf-net": "pro_9_package",
    "pro-series-10-large-package-golf-net": "pro_10_package",
    "mini-package-golf-net": "mini_package",
    "pro-series-xl-package-golf-net": "pro_xl_package"
  };

  var currentHandle = "{{ product.handle }}";
  if (!currentHandle || !handleMap[currentHandle]) return;

  var activeKey = handleMap[currentHandle];

  document
    .querySelectorAll('[data-key="' + activeKey + '"]')
    .forEach(function (el) {
      el.classList.add("active-product");
    });

});
</script>

{% schema %}
{
  "name": "Compare Package Models",
  "settings": [
    {
      "type": "text",
      "id": "small_text",
      "label": "Small label text",
      "default": "COMPARE MODELS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure which net to choose?"
    }
  ],
  "presets": [
    {
      "name": "Compare Package Models"
    }
  ]
}
{% endschema %}
