<style>
  #shopify-section-{{ section.id }} {
    --academy-padding-top: {{ section.settings.padding_top }}px;
    --academy-padding-bottom: {{ section.settings.padding_bottom }}px;
    --academy-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --academy-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --academy-card-background: {{ section.settings.card_background }};
    --academy-card-border: {{ section.settings.card_border }};
    {%- render 'section-variables', section: section -%}
  }
</style>
{{ 'academy-landing.css' | asset_url | stylesheet_tag }}

<section class="academy-section academy-social-proof {{ section.settings.custom_class }}">
  {%- if section.settings.anchor_id != blank -%}
    <div id="{{ section.settings.anchor_id }}" class="academy-section__anchor"></div>
  {%- endif -%}
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} academy-section__inner">
    {%- render 'academy-heading', section: section -%}

    <div class="academy-social-proof__grid">
      {%- for block in section.blocks -%}
        <div class="academy-social-proof__item academy-card" {{ block.shopify_attributes }}>
          <div class="academy-social-proof__header">
            <div class="academy-social-proof__avatar">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 180
                  | image_tag:
                    loading: 'lazy',
                    widths: '60,90,120,180',
                    alt: block.settings.image.alt
                }}
              {%- else -%}
                {{- 'image' | placeholder_svg_tag: 'placeholder-svg' -}}
              {%- endif -%}
            </div>
            <div>
              {%- if block.settings.heading != blank -%}
                <p class="heading font-medium text-lg">{{ block.settings.heading }}</p>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <p class="academy-eyebrow">{{ block.settings.subheading }}</p>
              {%- endif -%}
            </div>
          </div>

          {%- if block.settings.text != blank -%}
            <div class="academy-description rte">
              {{- block.settings.text -}}
            </div>
          {%- endif -%}

          {%- if block.settings.badge_text != blank -%}
            <div class="academy-badge">
              {%- render 'academy-icon', block: block, size: 'sm' -%}
              <span>{{ block.settings.badge_text }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Academy Social Proof",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id" },
    { "type": "text", "id": "custom_class", "label": "Custom class" },
    { "type": "checkbox", "id": "full_width", "label": "Full width" },
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "Featured coaches" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Built with instruction you can trust." },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "default": "h2", "options": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "div", "label": "Div" }] },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "title-lg tracking-heading", "options": [{ "value": "title-xl tracking-heading", "label": "XL" }, { "value": "title-lg tracking-heading", "label": "Large" }, { "value": "title-md", "label": "Medium" }] },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Use this strip for instructors, ambassadors, trust markers, or quick social proof.</p>" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_text", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "color_background", "label": "Background color", "default": "#101818" },
    { "type": "color_background", "id": "gradient_background", "label": "Background gradient" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#163129" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#2d5a4d" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 0, "max": 160, "step": 4, "default": 36, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 0, "max": 160, "step": 4, "default": 36, "unit": "px" },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top padding", "min": 0, "max": 120, "step": 4, "default": 24, "unit": "px" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom padding", "min": 0, "max": 120, "step": 4, "default": 24, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Proof card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Avatar or logo" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Coach Name" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Instructor" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Use a short quote, role, or proof point.</p>" },
        { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Featured" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "star", "options": [{ "value": "none", "label": "None" }, { "value": "star", "label": "Star" }, { "value": "award", "label": "Award" }, { "value": "trophy", "label": "Trophy" }, { "value": "rocket", "label": "Rocket" }, { "value": "users", "label": "Users" }, { "value": "check_mark", "label": "Check" }, { "value": "chat_bubble", "label": "Chat" }] },
        { "type": "html", "id": "custom_icon", "label": "Custom SVG icon" },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Academy Social Proof",
      "blocks": [{ "type": "proof" }, { "type": "proof" }, { "type": "proof" }, { "type": "proof" }]
    }
  ]
}
{% endschema %}
