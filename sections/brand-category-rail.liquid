{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign scroll_seconds = section.settings.scroll_seconds | default: 60
  assign show_badge = section.settings.show_concept_badge

  comment
    Continuous horizontal rail. Blocks render twice in the track for a
    seamless translateX(-50%) loop (same pattern as brand-marquee). Hover
    pauses the animation; the tile under the cursor scales up and reveals
    its CTA. Mobile drops the auto-scroll and gives users a native
    scroll-snap rail with finger-drag.
  endcomment
-%}

<section
  class="brand-category-rail"
  data-brand-category-rail
  style="--brand-rail-duration: {{ scroll_seconds }}s;"
  {% if heading != blank %}aria-labelledby="brand-category-rail-heading-{{ section.id }}"{% endif %}
>
  {%- if show_badge -%}
    <span class="brand-category-rail__badge" aria-hidden="true">Concept C · Rail</span>
  {%- endif -%}

  {%- if eyebrow != blank or heading != blank -%}
    <header class="brand-category-rail__header brand-container">
      {%- if eyebrow != blank -%}
        <p class="brand-eyebrow">{{ eyebrow }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 id="brand-category-rail-heading-{{ section.id }}" class="brand-category-rail__heading">{{ heading }}</h2>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div class="brand-category-rail__viewport">
    <ul class="brand-category-rail__track" role="list">
      {%- for pass in (1..2) -%}
        {%- assign aria_hidden_attr = '' -%}
        {%- if pass == 2 -%}{%- assign aria_hidden_attr = 'aria-hidden="true"' -%}{%- endif -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign label = block.settings.label
            assign link = block.settings.link
            assign image = block.settings.image
            assign default_image_filename = block.settings.default_image_filename
            assign cta = block.settings.cta_text | default: 'Shop now'
          -%}
          {%- if label != blank -%}
            <li
              class="brand-category-rail__tile"
              {% if pass == 1 %}{{ block.shopify_attributes }}{% else %}{{ aria_hidden_attr }}{% endif %}
            >
              <a
                class="brand-category-rail__link"
                href="{{ link | default: '#' }}"
                {% if pass == 2 %}tabindex="-1" aria-hidden="true"{% else %}aria-label="{{ label | escape }}"{% endif %}
              >
                <span class="brand-category-rail__frame">
                  {%- if image != blank -%}
                    <img
                      class="brand-category-rail__image"
                      src="{{ image | image_url: width: 900 }}"
                      srcset="{{ image | image_url: width: 480 }} 480w, {{ image | image_url: width: 720 }} 720w, {{ image | image_url: width: 900 }} 900w"
                      sizes="(max-width: 749px) 78vw, 360px"
                      alt="{% if pass == 1 %}{{ image.alt | default: label | escape }}{% endif %}"
                      loading="lazy"
                      width="900"
                      height="1200">
                  {%- elsif default_image_filename != blank -%}
                    <img
                      class="brand-category-rail__image"
                      src="{{ default_image_filename | asset_url }}"
                      alt="{% if pass == 1 %}{{ label | escape }}{% endif %}"
                      loading="lazy"
                      width="900"
                      height="1200">
                  {%- endif -%}
                </span>
                <div class="brand-category-rail__content">
                  <h3 class="brand-category-rail__label">
                    <span class="brand-plus" aria-hidden="true"></span>
                    {{ label }}
                  </h3>
                  <span class="brand-category-rail__cta">
                    {{ cta }}
                    <span class="brand-category-rail__cta-arrow" aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Brand category rail",
  "tag": "section",
  "class": "brand-category-rail-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Concept C — Marquee rail. Tall portrait tiles scroll continuously left-to-right. Hover any tile to pause the loop and reveal its CTA. Mobile gives a native finger-drag scroll with snap points."
    },
    {
      "type": "checkbox",
      "id": "show_concept_badge",
      "label": "Show 'Concept C' badge (for preview comparison)",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (mono caps)",
      "default": "Shop the system"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start with the net. Build around your space."
    },
    {
      "type": "range",
      "id": "scroll_seconds",
      "label": "Scroll duration",
      "info": "Seconds for one full loop. Higher = slower.",
      "min": 30,
      "max": 120,
      "step": 5,
      "default": 60,
      "unit": "s"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tile",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (portrait recommended)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Shop now"
        },
        {
          "type": "text",
          "id": "default_image_filename",
          "label": "Fallback theme asset filename"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand category rail",
      "settings": {
        "eyebrow": "Shop the system",
        "heading": "Start with the net. Build around your space."
      },
      "blocks": [
        { "type": "category", "settings": { "label": "Nets",        "cta_text": "Shop nets",        "link": "/collections/nets-1",            "default_image_filename": "brand-category-nets.jpg" } },
        { "type": "category", "settings": { "label": "Packages",    "cta_text": "Shop packages",    "link": "/collections/packages",          "default_image_filename": "brand-category-packages.jpg" } },
        { "type": "category", "settings": { "label": "Simulation",  "cta_text": "Shop simulation",  "link": "/collections/simulation",        "default_image_filename": "brand-category-simulation.jpg" } },
        { "type": "category", "settings": { "label": "Accessories", "cta_text": "Shop accessories", "link": "/collections/general-accessories", "default_image_filename": "brand-category-accessories.jpg" } }
      ]
    }
  ]
}
{% endschema %}
