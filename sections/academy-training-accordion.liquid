<style>
  #shopify-section-{{ section.id }} {
    --academy-padding-top: {{ section.settings.padding_top }}px;
    --academy-padding-bottom: {{ section.settings.padding_bottom }}px;
    --academy-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --academy-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --academy-card-background: {{ section.settings.accordion_background }};
    --academy-card-border: {{ section.settings.accordion_border }};
    --academy-media-radius: {{ section.settings.media_radius }}px;
    {%- render 'section-variables', section: section -%}
  }
</style>
{{ 'academy-landing.css' | asset_url | stylesheet_tag }}

<section class="academy-section academy-training-accordion {{ section.settings.custom_class }}">
  {%- if section.settings.anchor_id != blank -%}
    <div id="{{ section.settings.anchor_id }}" class="academy-section__anchor"></div>
  {%- endif -%}
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} academy-section__inner">
    <div class="academy-training__layout">
      <div>
        {%- render 'academy-heading', section: section -%}
        <div class="academy-training__accordion">
          {%- for block in section.blocks -%}
            <details class="academy-card details" {% if forloop.first and section.settings.open_first_row %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="details__summary">
                <span class="heading font-medium text-lg">{{ block.settings.heading }}</span>
                {%- render 'icon', icon: 'chevron', width: 12, height: 8, inline: true -%}
              </summary>
              <div class="details__content rte">
                {{- block.settings.text -}}
              </div>
            </details>
          {%- endfor -%}
        </div>
      </div>

      <div class="academy-training__media-stack">
        <div class="academy-media-frame">
          {%- render 'academy-picture',
            image: section.settings.image,
            mobile_image: section.settings.image_mobile,
            sizes: '(max-width: 989px) 100vw, 46vw'
          -%}
        </div>

        {%- if section.settings.badge_heading != blank or section.settings.badge_text != blank or section.settings.badge_image != blank -%}
          <div class="academy-training__badge academy-card">
            {%- if section.settings.badge_image != blank -%}
              {{
                section.settings.badge_image
                | image_url: width: 160
                | image_tag:
                  loading: 'lazy',
                  widths: '60,90,120,160',
                  alt: section.settings.badge_image.alt,
                  class: 'academy-training__badge-image'
              }}
            {%- endif -%}
            {%- if section.settings.badge_heading != blank -%}
              <p class="heading font-medium text-lg">{{ section.settings.badge_heading }}</p>
            {%- endif -%}
            {%- if section.settings.badge_text != blank -%}
              <div class="academy-description rte">
                {{- section.settings.badge_text -}}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Academy Training Accord",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id" },
    { "type": "text", "id": "custom_class", "label": "Custom class" },
    { "type": "checkbox", "id": "full_width", "label": "Full width" },
    { "type": "checkbox", "id": "open_first_row", "label": "Open first accordion row", "default": true },
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "Training that meets you exactly where you are" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Move from problem to plan with guided training blocks." },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "default": "h2", "options": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "div", "label": "Div" }] },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "title-lg tracking-heading", "options": [{ "value": "title-xl tracking-heading", "label": "XL" }, { "value": "title-lg tracking-heading", "label": "Large" }, { "value": "title-md", "label": "Medium" }] },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Use accordion rows for pathways, modules, FAQs, or feature explanations.</p>" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "image_picker", "id": "badge_image", "label": "Badge image" },
    { "type": "text", "id": "badge_heading", "label": "Badge heading", "default": "Track progress" },
    { "type": "richtext", "id": "badge_text", "label": "Badge text", "default": "<p>Highlight a supporting proof point with an image and short copy.</p>" },
    { "type": "range", "id": "media_radius", "label": "Media radius", "min": 0, "max": 40, "step": 2, "default": 32, "unit": "px" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_text", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "color_background", "label": "Background color", "default": "#101818" },
    { "type": "color_background", "id": "gradient_background", "label": "Background gradient" },
    { "type": "color", "id": "accordion_background", "label": "Accordion background", "default": "#163129" },
    { "type": "color", "id": "accordion_border", "label": "Accordion border", "default": "#2d5a4d" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 0, "max": 160, "step": 4, "default": 72, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 0, "max": 160, "step": 4, "default": 72, "unit": "px" },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top padding", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom padding", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Build a plan around your exact misses." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Use this content area for detail on the training sequence, curriculum, or benefit.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Academy Training Accord",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
