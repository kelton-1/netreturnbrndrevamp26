<!-- ✅ BEGIN: Full-Width Responsive Badge Scroller -->
<style>
  #shopify-section-{{ section.id }}.section{
  margin-top: 0 !important;          /* gap above */
  margin-bottom: 0 !important;       /* gap below */
  padding-top: 0 !important;         /* some themes use padding for section spacing */
  padding-bottom: 0 !important;
}
  .badge-scroller-wrapper {
    background: #FFFFFF;
    padding: 48px 0;
    width: 100%;
    overflow-x: hidden;
  }

  .badge-scroller {
    display: flex;
    overflow-x: auto;
    gap: 150px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: auto;
  }

  .badge-scroller::-webkit-scrollbar {
    display: none;
  }

  .badge-item {
    flex: 0 0 auto;
    scroll-snap-align: start;
    text-align: center;
    width: 100px;
  }

  .badge-item img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    margin: 0 auto;
    display: block;
  }

  .badge-item p {
    font-size: 16px;        
  font-weight: 500;      
  margin-top: 0px;        
  padding: 0 0px;         
  line-height: 1.2;
  color: #4A250A;
  font-family: 'Lora', serif;
  white-space: nowrap;
  width: 100%;   
   
  }

  @media (min-width: 1200px) {
    .badge-scroller {
      justify-content: center;
      overflow-x: hidden;
    }
  }
  @media (max-width: 600px) {
    .badge-scroller {
      gap: 30px;
      padding: 0px 10px;
    }

    .badge-item {
      width: 96px;
    }

    .badge-item img {
      width: 48px;
      height: 48px;
    }

    .badge-item p {
      font-size: 12px;
    }
  }
</style>

<div class="badge-scroller-wrapper">
  <div class="badge-scroller">
      {% assign badges = 
      "Performance,Trust & Service,Free Shipping,Tech Ready,Multi-Sport" | split: "," %}
    {% assign badge_urls = 
      "
       https://cdn.shopify.com/s/files/1/0405/2925/files/good-feedback.png?v=1761568541,
       https://cdn.shopify.com/s/files/1/0405/2925/files/trust.png?v=1761568659,
       https://cdn.shopify.com/s/files/1/0405/2925/files/free-shipping.png?v=1761640554,
       https://cdn.shopify.com/s/files/1/0405/2925/files/simulation_5a537312-c684-4671-9e74-1748b5cd9142.png?v=1761568658,
       https://cdn.shopify.com/s/files/1/0405/2925/files/scheme.png?v=1761568659" | split: "," %}

    {% for badge in badges %}
      <div class="badge-item">
        <img 
          src="{{ badge_urls[forloop.index0] | strip }}" 
          alt="{{ badge | escape }}"
          width="64"
          height="64"
          loading="lazy"
        >
        <p>{{ badge }}</p>
      </div>
    {% endfor %}
  </div>
</div>
<!-- ✅ END: Full-Width Responsive Badge Scroller -->

{% schema %}
{
  "name": "Badge Scroller",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Badge Scroller",
      "category": "Custom"
    }
  ]
}
{% endschema %}


