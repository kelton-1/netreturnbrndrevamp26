{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body = section.settings.body
  assign cta_text = section.settings.cta_text
  assign cta_link = section.settings.cta_link
  assign image = section.settings.image
  assign default_image_filename = section.settings.default_image_filename
  assign image_alt = image.alt | default: heading | default: shop.name
-%}

<section
  class="brand-proof-cinematic brand-surface brand-surface--pattern"
  aria-labelledby="brand-proof-cinematic-heading-{{ section.id }}"
>
  <div class="brand-proof-cinematic__inner brand-container">
    <div class="brand-proof-cinematic__copy">
      {%- if eyebrow != blank -%}
        <p class="brand-eyebrow brand-proof-cinematic__eyebrow">
          <span class="brand-plus" aria-hidden="true"></span>
          {{ eyebrow }}
        </p>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 id="brand-proof-cinematic-heading-{{ section.id }}" class="brand-proof-cinematic__heading">{{ heading }}</h2>
      {%- endif -%}

      {%- if body != blank -%}
        <div class="brand-body brand-proof-cinematic__body">{{ body }}</div>
      {%- endif -%}

      {%- if cta_text != blank -%}
        <a class="brand-btn brand-btn--primary brand-proof-cinematic__cta" href="{{ cta_link | default: '#' }}">{{ cta_text }}</a>
      {%- endif -%}
    </div>

    <div class="brand-proof-cinematic__media">
      {%- if image != blank -%}
        {{ image | image_url: width: 1600 | image_tag:
            class: 'brand-proof-cinematic__image',
            loading: 'lazy',
            sizes: '(max-width: 749px) 96vw, 52vw',
            widths: '600, 900, 1200, 1600',
            alt: image_alt
        }}
      {%- elsif default_image_filename != blank -%}
        <img
          class="brand-proof-cinematic__image"
          src="{{ default_image_filename | asset_url }}"
          alt="{{ heading | default: shop.name | escape }}"
          loading="lazy"
          width="1600"
          height="1200">
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="brand-proof-cinematic__band">
      <div class="brand-proof-cinematic__band-inner brand-container">
        <ul class="brand-proof-cinematic__stats" role="list">
          {%- for block in section.blocks -%}
            <li class="brand-proof-cinematic__stat" {{ block.shopify_attributes }}>
              {%- if block.settings.stat != blank -%}
                <p class="brand-proof-cinematic__stat-value">{{ block.settings.stat }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="brand-proof-cinematic__stat-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="brand-proof-cinematic__stat-text">{{ block.settings.text }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Brand proof — cinematic",
  "tag": "section",
  "class": "brand-proof-cinematic-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Concept A — dark cinematic rebuild of the proof system. Shadow Green surface with full-bleed photo, Emerald CTA, and a stat band below."
    },
    {
      "type": "checkbox",
      "id": "show_concept_badge",
      "label": "Show 'Concept A' badge (for preview comparison)",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why golfers choose it"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built around the return."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>The patented S-shape frame absorbs impact and sends the ball back to your feet. Set it up without tools, use it indoors or outdoors, and build from a standalone net to a simulator setup when you are ready.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Build your setup"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "default_image_filename",
      "label": "Fallback theme asset filename"
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "stat",
          "label": "Stat",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Automatic ball return"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "The patented S-shape frame absorbs the shot and returns the ball to your feet."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand proof — cinematic",
      "settings": {
        "eyebrow": "Why golfers choose it",
        "heading": "Built around the return.",
        "cta_text": "Build your setup"
      },
      "blocks": [
        { "type": "proof", "settings": { "stat": "Patented", "title": "Automatic ball return", "text": "The patented S-shape frame absorbs the shot and returns the ball to your feet." } },
        { "type": "proof", "settings": { "stat": "250K", "title": "Built for real golf balls", "text": "Commercial-grade netting and a stable frame are made for repeat practice." } },
        { "type": "proof", "settings": { "stat": "10 min", "title": "Tool-free setup", "text": "Quick Color Connect pieces make setup and breakdown simple." } },
        { "type": "proof", "settings": { "stat": "Any space", "title": "Indoor, outdoor, simulator-ready", "text": "Use it in a garage, backyard, studio, or as the foundation for a simulator build." } }
      ]
    }
  ]
}
{% endschema %}
