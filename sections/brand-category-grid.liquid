{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign columns = section.settings.columns | default: 4
-%}

<section
  class="brand-category-grid"
  style="--brand-category-cols: {{ columns }};"
  {% if heading != blank %}aria-labelledby="brand-category-grid-heading-{{ section.id }}"{% endif %}
>
  <div class="brand-container">
    {%- if eyebrow != blank or heading != blank -%}
      <header class="brand-category-grid__header">
        {%- if eyebrow != blank -%}
          <p class="brand-eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 id="brand-category-grid-heading-{{ section.id }}" class="brand-headline brand-category-grid__heading">{{ heading }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ul class="brand-category-grid__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign label = block.settings.label
          assign link = block.settings.link
          assign image = block.settings.image
          assign default_image_filename = block.settings.default_image_filename
          assign cta = block.settings.cta_text | default: 'Shop now'
        -%}
        {%- if label != blank -%}
          <li {{ block.shopify_attributes }}>
            <a class="brand-category-card" href="{{ link | default: '#' }}" aria-label="{{ label | escape }}">
              {%- if image != blank -%}
                <img
                  class="brand-category-card__image"
                  src="{{ image | image_url: width: 1200 }}"
                  srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1200 }} 1200w"
                  sizes="(max-width: 540px) 100vw, (max-width: 999px) 50vw, 25vw"
                  alt="{{ image.alt | default: label | escape }}"
                  loading="lazy"
                  width="1200"
                  height="800">
              {%- elsif default_image_filename != blank -%}
                <img
                  class="brand-category-card__image"
                  src="{{ default_image_filename | asset_url }}"
                  alt="{{ label | escape }}"
                  loading="lazy"
                  width="1200"
                  height="800">
              {%- endif -%}
              <div class="brand-category-card__inner">
                <h3 class="brand-category-card__label">{{ label }}</h3>
                <span class="brand-category-card__cta">{{ cta }}</span>
              </div>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Brand category grid",
  "tag": "section",
  "class": "brand-category-grid-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Photo-led category grid (4 cards by default). Each card: a hero photo, Precision+ glyph, display caps label, mono CTA. Sits under the homepage hero in the mockup."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (mono caps)",
      "default": "Shop the system"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for every part of the work."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Shop now"
        },
        {
          "type": "text",
          "id": "default_image_filename",
          "label": "Fallback theme asset filename",
          "info": "Used only when no image is picked above. Example: brand-category-nets.jpg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand category grid",
      "settings": {
        "eyebrow": "Shop the system",
        "heading": "Built for every part of the work.",
        "columns": 4
      },
      "blocks": [
        { "type": "category", "settings": { "label": "Nets",        "cta_text": "Shop nets" } },
        { "type": "category", "settings": { "label": "Packages",    "cta_text": "Shop packages" } },
        { "type": "category", "settings": { "label": "Simulation",  "cta_text": "Shop simulation" } },
        { "type": "category", "settings": { "label": "Accessories", "cta_text": "Shop accessories" } }
      ]
    }
  ]
}
{% endschema %}
