{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body = section.settings.body
  assign cta_text = section.settings.cta_text
  assign cta_link = section.settings.cta_link
  assign featured_label = section.settings.featured_label
-%}

<section class="brand-testimonial-wall brand-surface--shadow brand-surface--pattern" aria-labelledby="brand-testimonial-wall-heading-{{ section.id }}" data-brand-reveal>
  <div class="brand-container brand-testimonial-wall__inner">
    <header class="brand-testimonial-wall__header">
      <div>
        {%- if eyebrow != blank -%}
          <p class="brand-eyebrow brand-testimonial-wall__eyebrow">{{ eyebrow }}</p>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 id="brand-testimonial-wall-heading-{{ section.id }}" class="brand-headline brand-testimonial-wall__heading" data-reveal-headline>{{ heading }}</h2>
        {%- endif -%}
      </div>

      {%- if body != blank -%}
        <div class="brand-body brand-testimonial-wall__body" data-reveal-body>{{ body }}</div>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="brand-testimonial-wall__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign quote = block.settings.quote
            assign author = block.settings.author
            assign context = block.settings.context
            assign product = block.settings.product
            assign rating_label = block.settings.rating_label
            assign image = block.settings.image
            assign default_image_filename = block.settings.default_image_filename
            assign is_featured = false
            if forloop.first
              assign is_featured = true
            endif
          -%}

          <article
            class="brand-testimonial-card {% if is_featured %}brand-testimonial-card--featured{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="brand-testimonial-card__content">
              <div class="brand-testimonial-card__meta">
                {%- if rating_label != blank -%}
                  <span class="brand-testimonial-card__rating">{{ rating_label }}</span>
                {%- endif -%}
                {%- if is_featured and featured_label != blank -%}
                  <span class="brand-testimonial-card__featured">{{ featured_label }}</span>
                {%- endif -%}
              </div>

              {%- if quote != blank -%}
                <blockquote class="brand-testimonial-card__quote">
                  <p>{{ quote }}</p>
                </blockquote>
              {%- endif -%}

              <footer class="brand-testimonial-card__footer">
                {%- if author != blank -%}
                  <p class="brand-testimonial-card__author">{{ author }}</p>
                {%- endif -%}
                {%- if context != blank -%}
                  <p class="brand-testimonial-card__context">{{ context }}</p>
                {%- endif -%}
                {%- if product != blank -%}
                  <p class="brand-testimonial-card__product">{{ product }}</p>
                {%- endif -%}
              </footer>
            </div>

            {%- if image != blank or default_image_filename != blank -%}
              <div class="brand-testimonial-card__media">
                {%- if image != blank -%}
                  {{ image | image_url: width: 900 | image_tag: class: 'brand-testimonial-card__image', loading: 'lazy', sizes: '(max-width: 749px) 92vw, 30vw', widths: '360, 540, 720, 900', alt: image.alt | default: author }}
                {%- else -%}
                  <img
                    class="brand-testimonial-card__image"
                    src="{{ default_image_filename | asset_url }}"
                    alt="{{ author | default: heading | escape }}"
                    loading="lazy"
                    width="900"
                    height="1100">
                {%- endif -%}
              </div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if cta_text != blank -%}
      <div class="brand-testimonial-wall__action">
        <a class="brand-btn brand-btn--outline" href="{{ cta_link | default: '#' }}">{{ cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand testimonial wall",
  "tag": "section",
  "class": "brand-testimonial-wall-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Editorial testimonial wall for homepage social proof. Use real review excerpts, customer context, and optional customer/setup images."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer proof"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted in garages, backyards, and studios."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Real setups, real reps, and the same reason people keep coming back: the ball returns, the setup holds, and practice feels easier to repeat.</p>"
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Featured card label",
      "default": "Featured setup"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Read more reviews"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 8,
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The setup was simple, the net feels solid, and getting the ball back makes practice way easier to stick with."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Customer"
        },
        {
          "type": "text",
          "id": "context",
          "label": "Context",
          "default": "Home practice setup"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product or setup",
          "default": "Pro Series"
        },
        {
          "type": "text",
          "id": "rating_label",
          "label": "Rating label",
          "default": "5.0 verified"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "default_image_filename",
          "label": "Fallback theme asset filename",
          "info": "Used only when no image is picked above."
        }
      ]
    }
  ],
  "presets": [
    {
