{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body = section.settings.body
  assign show_bundle_total = section.settings.show_bundle_total
  assign surface = section.settings.surface | default: 'white'
  assign surface_class = 'brand-surface--white'
  if surface == 'shadow'
    assign surface_class = 'brand-surface brand-surface--shadow'
  elsif surface == 'glow'
    assign surface_class = 'brand-surface brand-surface--glow'
  endif
-%}

<section
  class="brand-setup-rooms {{ surface_class }}"
  aria-labelledby="brand-setup-rooms-heading-{{ section.id }}"
>
  <div class="brand-setup-rooms__inner brand-container">
    {%- if eyebrow != blank or heading != blank or body != blank -%}
      <header class="brand-setup-rooms__header">
        {%- if eyebrow != blank -%}
          <p class="brand-eyebrow brand-setup-rooms__eyebrow">
            <span class="brand-plus" aria-hidden="true"></span>
            {{ eyebrow }}
          </p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 id="brand-setup-rooms-heading-{{ section.id }}" class="brand-setup-rooms__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if body != blank -%}
          <p class="brand-body brand-setup-rooms__body">{{ body }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ul class="brand-setup-rooms__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign room_name = block.settings.name
          assign room_tagline = block.settings.tagline
          assign image = block.settings.image
          assign default_image_filename = block.settings.default_image_filename
          assign layout = block.settings.layout | default: 'image-left'
          assign cta_text = block.settings.cta_text | default: 'Shop this setup'
          assign cta_link = block.settings.cta_link

          assign bundle_total = 0
          assign product_count = 0
          for i in (1..5)
            assign key = 'product_' | append: i
            assign p = block.settings[key]
            if p != blank
              assign product_count = product_count | plus: 1
              assign bundle_total = bundle_total | plus: p.price
            endif
          endfor
        -%}
        <li
          class="brand-setup-room brand-setup-room--{{ layout }}"
          style="--brand-room-index: {{ forloop.index0 }};"
          {{ block.shopify_attributes }}
        >
          <div class="brand-setup-room__media">
            {%- if image != blank -%}
              {{ image | image_url: width: 1600 | image_tag:
                  class: 'brand-setup-room__image',
                  loading: 'lazy',
                  sizes: '(max-width: 749px) 96vw, 56vw',
                  widths: '600, 900, 1200, 1600',
                  alt: image.alt | default: room_name
              }}
            {%- elsif default_image_filename != blank -%}
              <img
                class="brand-setup-room__image"
                src="{{ default_image_filename | asset_url }}"
                alt="{{ room_name | escape }}"
                loading="lazy"
                width="1600"
                height="1067">
            {%- endif -%}
            <span class="brand-setup-room__scrim" aria-hidden="true"></span>

            {%- if room_name != blank -%}
              <p class="brand-setup-room__label" aria-hidden="true">
                <span class="brand-setup-room__step">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span class="brand-setup-room__step-name">{{ room_name }}</span>
              </p>
            {%- endif -%}
          </div>

          <div class="brand-setup-room__panel">
            {%- if room_name != blank -%}
              <h3 class="brand-setup-room__title">{{ room_name }}</h3>
            {%- endif -%}

            {%- if room_tagline != blank -%}
              <p class="brand-setup-room__tagline">{{ room_tagline }}</p>
            {%- endif -%}

            {%- if product_count > 0 -%}
              <ul class="brand-setup-room__products" role="list">
                {%- for i in (1..5) -%}
                  {%- assign key = 'product_' | append: i -%}
                  {%- assign p = block.settings[key] -%}
                  {%- if p != blank -%}
                    {%- assign note_key = 'product_' | append: i | append: '_note' -%}
                    {%- assign note = block.settings[note_key] -%}
                    <li class="brand-setup-room__product">
                      <a class="brand-setup-room__product-link" href="{{ p.url }}">
                        <span class="brand-setup-room__product-name">{{ p.title }}</span>
                        {%- if note != blank -%}
                          <span class="brand-setup-room__product-note">{{ note }}</span>
                        {%- endif -%}
                      </a>
                      <span class="brand-setup-room__product-price">{{ p.price | money }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

              {%- if show_bundle_total -%}
                <div class="brand-setup-room__total">
                  <span class="brand-setup-room__total-label">Bundle starts at</span>
                  <span class="brand-setup-room__total-value">{{ bundle_total | money }}</span>
                </div>
              {%- endif -%}
            {%- endif -%}

            {%- if cta_text != blank and cta_link != blank -%}
              <a class="brand-btn brand-btn--primary brand-setup-room__cta" href="{{ cta_link }}">
                {{ cta_text }}
                <span aria-hidden="true">&rarr;</span>
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Brand setup rooms",
  "tag": "section",
  "class": "brand-setup-rooms-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Scenario-based product browser. One block per 'room' (Garage / Backyard / Studio / Pro Shop). Each room hosts up to 5 curated products with a 'Shop this setup' CTA."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Setup rooms"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where will you train?"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Different spaces. Same system. Pick the room you're building for and we'll show you the gear that fits."
    },
    {
      "type": "checkbox",
      "id": "show_bundle_total",
      "label": "Show bundle subtotal under product list",
      "default": true
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Surface",
      "options": [
        { "value": "white",  "label": "White (default)" },
        { "value": "shadow", "label": "Shadow Green" },
        { "value": "glow",   "label": "Glow Green" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "scenario",
      "name": "Setup room",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Room name",
          "default": "The Garage"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "info": "One short evocative line shown beneath the room name.",
          "default": "Concrete floor, low ceiling, big swings."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Scene image",
          "info": "16:11 landscape works best. Falls back to default_image_filename if blank."
        },
        {
          "type": "text",
          "id": "default_image_filename",
          "label": "Fallback theme asset filename",
          "info": "Used only when no image is picked. e.g. home-packages.jpg"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Panel position",
          "info": "Alternate per row for editorial rhythm.",
          "options": [
            { "value": "image-left",  "label": "Image left / panel right" },
            { "value": "image-right", "label": "Image right / panel left" }
          ],
          "default": "image-left"
        },
        { "type": "header", "content": "Products in this room" },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "text",    "id": "product_1_note", "label": "Product 1 note", "info": "Optional one-line context (e.g. 'Anchor of the setup')." },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "text",    "id": "product_2_note", "label": "Product 2 note" },
        { "type": "product", "id": "product_3", "label": "Product 3" },
        { "type": "text",    "id": "product_3_note", "label": "Product 3 note" },
        { "type": "product", "id": "product_4", "label": "Product 4" },
        { "type": "text",    "id": "product_4_note", "label": "Product 4 note" },
        { "type": "product", "id": "product_5", "label": "Product 5" },
        { "type": "text",    "id": "product_5_note", "label": "Product 5 note" },
        { "type": "header", "content": "Call to action" },
        { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop this setup" },
        { "type": "url",  "id": "cta_link", "label": "CTA link", "info": "Point to a curated collection or the build-your-setup page." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand setup rooms",
      "settings": {
        "eyebrow": "Setup rooms",
        "heading": "Where will you train?",
        "show_bundle_total": true,
        "surface": "white"
      },
      "blocks": [
        { "type": "scenario", "settings": { "name": "The Garage",   "tagline": "Concrete floor, low ceiling, big swings.",     "layout": "image-left",  "default_image_filename": "home-packages.jpg",               "cta_text": "Shop this setup" } },
        { "type": "scenario", "settings": { "name": "The Backyard", "tagline": "Sun, breeze, and a real range vibe.",          "layout": "image-right", "default_image_filename": "home-packages-backyard-patio.jpg", "cta_text": "Shop this setup" } },
        { "type": "scenario", "settings": { "name": "The Studio",   "tagline": "Indoor reps, tour-grade simulation.",          "layout": "image-left",  "default_image_filename": "home-sim-series.jpg",             "cta_text": "Shop this setup" } },
        { "type": "scenario", "settings": { "name": "The Pro Shop", "tagline": "Commercial-grade bay built to hold up.",       "layout": "image-right", "default_image_filename": "home-sim-series.jpg",             "cta_text": "Shop this setup" } }
      ]
    }
  ]
}
{% endschema %}
