<style>
  #shopify-section-{{ section.id }} {
    --academy-padding-top: {{ section.settings.padding_top }}px;
    --academy-padding-bottom: {{ section.settings.padding_bottom }}px;
    --academy-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --academy-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --academy-card-background: {{ section.settings.panel_background }};
    --academy-card-border: {{ section.settings.panel_border }};
    {%- render 'section-variables', section: section -%}
  }
</style>
{{ 'academy-landing.css' | asset_url | stylesheet_tag }}

<section class="academy-section academy-skill-tabs {{ section.settings.custom_class }}">
  {%- if section.settings.anchor_id != blank -%}
    <div id="{{ section.settings.anchor_id }}" class="academy-section__anchor"></div>
  {%- endif -%}
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} academy-section__inner">
    {%- render 'academy-heading', section: section -%}

    <tabs-element class="academy-skill-tabs__tabs">
      <div class="scroll-area grid">
        <div class="flex gap-4" role="tablist">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="academy-skill-tabs__tab button{% if forloop.first %} button--primary{% else %} button--secondary{% endif %}"
              role="tab"
              aria-controls="AcademySkillPanel-{{ block.id }}"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {%- render 'academy-icon', block: block, size: 'sm' -%}
              <span class="academy-skill-tabs__label">
                <span class="font-medium">{{ block.settings.label }}</span>
                {%- if block.settings.meta != blank -%}
                  <span class="text-sm">{{ block.settings.meta }}</span>
                {%- endif -%}
              </span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div id="AcademySkillPanel-{{ block.id }}" role="tabpanel" {% unless forloop.first %}hidden{% endunless %}>
          <div class="academy-skill-tabs__panel academy-card">
            <div>
              {%- if block.settings.kicker != blank -%}
                <p class="academy-eyebrow">{{ block.settings.kicker | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="academy-title heading font-bold title-md">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="academy-description rte" style="margin-top: 16px;">
                  {{- block.settings.text -}}
                </div>
              {%- endif -%}
              {%- if block.settings.stat_text != blank -%}
                <div class="academy-badge" style="margin-top: 18px;">
                  {%- if block.settings.stat_icon != blank -%}
                    {{
                      block.settings.stat_icon
                      | image_url: width: 80
                      | image_tag:
                        loading: 'lazy',
                        widths: '40,60,80',
                        alt: block.settings.stat_icon.alt
                    }}
                  {%- endif -%}
                  <span>{{ block.settings.stat_text }}</span>
                </div>
              {%- endif -%}
            </div>

            <div class="academy-media-frame">
              {%- render 'academy-picture',
                image: block.settings.image,
                mobile_image: block.settings.image_mobile,
                sizes: '(max-width: 989px) 100vw, 44vw'
              -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </tabs-element>
  </div>
</section>

{% schema %}
{
  "name": "Academy Skill Tabs",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id" },
    { "type": "text", "id": "custom_class", "label": "Custom class" },
    { "type": "checkbox", "id": "full_width", "label": "Full width" },
    { "type": "text", "id": "subheading", "label": "Eyebrow", "default": "Train every skill" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Choose the training path that lowers your score." },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "default": "h2", "options": [{ "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "div", "label": "Div" }] },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "title-lg tracking-heading", "options": [{ "value": "title-xl tracking-heading", "label": "XL" }, { "value": "title-lg tracking-heading", "label": "Large" }, { "value": "title-md", "label": "Medium" }] },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Tabs switch the visual and supporting content while keeping all copy editable from the Theme Editor.</p>" },
    { "type": "color", "id": "panel_background", "label": "Panel background", "default": "#17332e" },
    { "type": "color", "id": "panel_border", "label": "Panel border", "default": "#2d5a4d" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_text", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "color_background", "label": "Background color", "default": "#101818" },
    { "type": "color_background", "id": "gradient_background", "label": "Background gradient" },
    { "type": "color", "id": "color_button_text", "label": "Button text color", "default": "#101818" },
    { "type": "color", "id": "color_button_background", "label": "Button background color", "default": "#b8ff2c" },
    { "type": "color_background", "id": "color_button_gradient", "label": "Button gradient" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 0, "max": 160, "step": 4, "default": 72, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 0, "max": 160, "step": 4, "default": 72, "unit": "px" },
    { "type": "range", "id": "padding_top_mobile", "label": "Mobile top padding", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Mobile bottom padding", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Short game" },
        { "type": "text", "id": "meta", "label": "Tab meta", "default": "Technique + reps" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "trophy", "options": [{ "value": "none", "label": "None" }, { "value": "award", "label": "Award" }, { "value": "trophy", "label": "Trophy" }, { "value": "rocket", "label": "Rocket" }, { "value": "lightning", "label": "Lightning" }, { "value": "users", "label": "Users" }, { "value": "calendar", "label": "Calendar" }, { "value": "eye", "label": "Eye" }, { "value": "chat_bubble", "label": "Chat" }, { "value": "check_mark", "label": "Check" }] },
        { "type": "html", "id": "custom_icon", "label": "Custom SVG icon" },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Skill focus" },
        { "type": "text", "id": "heading", "label": "Panel heading", "default": "Train smarter with a clear focus each week." },
        { "type": "richtext", "id": "text", "label": "Panel text", "default": "<p>Use this panel to explain what the user gets when they tap into this skill tab.</p>" },
        { "type": "text", "id": "stat_text", "label": "Badge text", "default": "Step-by-step modules" },
        { "type": "image_picker", "id": "stat_icon", "label": "Badge icon" },
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Academy Skill Tabs",
      "blocks": [{ "type": "tab" }, { "type": "tab" }, { "type": "tab" }]
    }
  ]
}
{% endschema %}
