{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body = section.settings.body
-%}

<section
  class="brand-series-cards__tiles"
  {% if heading != blank %}aria-labelledby="brand-series-cards__tiles-heading-{{ section.id }}"{% endif %}
>
  <div class="brand-container brand-series-cards__tiles__container">
    {%- if eyebrow != blank or heading != blank or body != blank -%}
      <header class="brand-series-cards__tiles__header">
        {%- if eyebrow != blank -%}
          <p class="brand-eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 id="brand-series-cards__tiles-heading-{{ section.id }}" class="brand-series-cards__tiles__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if body != blank -%}
          <div class="brand-series-cards__tiles__body">{{ body }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ul class="brand-series-cards__tiles__grid" role="list">
      {%- for block in section.blocks limit: 2 -%}
        {%- liquid
          assign label = block.settings.label
          assign description = block.settings.description
          assign link = block.settings.link
          assign cta = block.settings.cta_text | default: 'Shop now'
          assign image = block.settings.image
          assign default_image_filename = block.settings.default_image_filename
          assign card_eyebrow = block.settings.card_eyebrow
          assign card_index_str = forloop.index | prepend: '0' | slice: -2, 2
        -%}
        {%- if label != blank -%}
          <li class="brand-series-cards__tiles__item" {{ block.shopify_attributes }}>
            <a
              class="brand-series-cards__tile"
              href="{{ link | default: '#' }}"
              aria-label="{{ label | escape }}"
            >
              <div class="brand-series-cards__tile__media" aria-hidden="true">
                {%- if image != blank -%}
                  <img
                    class="brand-series-cards__tile__image"
                    src="{{ image | image_url: width: 1400 }}"
                    srcset="{{ image | image_url: width: 700 }} 700w, {{ image | image_url: width: 1100 }} 1100w, {{ image | image_url: width: 1400 }} 1400w, {{ image | image_url: width: 1800 }} 1800w"
                    sizes="(max-width: 749px) 100vw, 50vw"
                    alt="{{ image.alt | default: label | escape }}"
                    loading="lazy"
                    width="1400"
                    height="1750">
                {%- elsif default_image_filename != blank -%}
                  <img
                    class="brand-series-cards__tile__image"
                    src="{{ default_image_filename | asset_url }}"
                    alt="{{ label | escape }}"
                    loading="lazy"
                    width="1400"
                    height="1750">
                {%- endif -%}
              </div>

              <div class="brand-series-cards__tile__overlay" aria-hidden="true"></div>

              <div class="brand-series-cards__tile__content">
                <p class="brand-series-cards__tile__index">
                  <span class="brand-plus" aria-hidden="true"></span>
                  {{ card_index_str }}
                  {%- if card_eyebrow != blank %} · {{ card_eyebrow }}{% endif -%}
                </p>
                <h3 class="brand-series-cards__tile__label">{{ label }}</h3>
                {%- if description != blank -%}
                  <p class="brand-series-cards__tile__description">{{ description }}</p>
                {%- endif -%}
                <span class="brand-series-cards__tile__cta">
                  <span class="brand-series-cards__tile__cta-text">{{ cta }}</span>
                  <span class="brand-series-cards__tile__cta-arrow" aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Brand series cards",
  "tag": "section",
  "class": "brand-series-cards__tiles-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Two large hero cards side by side. Each card has a full-bleed product photo with content overlaid at the bottom. On hover the image scales and the overlay darkens. Mobile stacks vertically."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (mono caps)",
      "default": "Shop the system"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick the series built for your space."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Subhead (optional)"
    }
  ],
  "blocks": [
    {
      "type": "series",
      "name": "Series card",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Series label",
          "default": "Series"
        },
        {
          "type": "text",
          "id": "card_eyebrow",
          "label": "Card eyebrow (after the index)",
          "info": "Renders as '01 · Eyebrow' in the top-left of the card.",
          "default": "Series"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Shop now"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Hero image",
          "info": "Recommended: portrait 4:5 (e.g. 1200×1500)."
        },
        {
          "type": "text",
          "id": "default_image_filename",
          "label": "Fallback theme asset filename"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand series cards",
      "settings": {
        "eyebrow": "Shop the system",
        "heading": "Pick the series built for your space."
      },
      "blocks": [
        { "type": "series", "settings": { "label": "Home Series", "card_eyebrow": "Series", "cta_text": "Shop Home Series", "description": "Compact builds for tight spaces, kids, and quick warm-ups. Junior, Mini, and Home — same patented return, smaller footprint." } },
        { "type": "series", "settings": { "label": "Pro Series",  "card_eyebrow": "Series", "cta_text": "Shop Pro Series",  "description": "For dedicated practice. Garage to commercial-grade footprints, all with the same 225 MPH ball return." } }
      ]
    }
  ]
}
{% endschema %}
