{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body = section.settings.body
  assign surface = section.settings.surface
  assign surface_class = 'brand-surface--white'
  if surface == 'shadow'
    assign surface_class = 'brand-surface brand-surface--shadow'
  elsif surface == 'glow'
    assign surface_class = 'brand-surface brand-surface--glow'
  endif
-%}

<section
  class="brand-compare-grid {{ surface_class }}"
  aria-labelledby="brand-compare-grid-heading-{{ section.id }}"
>
  <div class="brand-compare-grid__inner brand-container">
    <header class="brand-compare-grid__header">
      {%- if eyebrow != blank -%}
        <p class="brand-eyebrow brand-compare-grid__eyebrow">
          <span class="brand-plus" aria-hidden="true"></span>
          {{ eyebrow }}
        </p>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 id="brand-compare-grid-heading-{{ section.id }}" class="brand-compare-grid__heading">{{ heading }}</h2>
      {%- endif -%}

      {%- if body != blank -%}
        <p class="brand-body brand-compare-grid__body">{{ body }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <ul class="brand-compare-grid__list" role="list" data-card-count="{{ section.blocks.size }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_product = block.settings.product
            assign card_url = block.settings.link_url
            assign card_image = block.settings.image

            if card_url == blank and card_product != blank
              assign card_url = card_product.url
            endif

            if card_image == blank and card_product != blank
              assign card_image = card_product.featured_image
            endif

            assign card_price = block.settings.price_text
            if block.settings.use_product_price and card_product != blank
              assign card_price = card_product.price | money
            endif

            assign card_title = block.settings.title | default: card_product.title
          -%}

          <li class="brand-compare-card" {{ block.shopify_attributes }}>
            <div class="brand-compare-card__media">
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 720 | image_tag:
                    class: 'brand-compare-card__image',
                    loading: 'lazy',
                    sizes: '(max-width: 749px) 90vw, (max-width: 1199px) 45vw, 280px',
                    widths: '240, 360, 480, 640, 720',
                    alt: card_title
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'brand-compare-card__placeholder' }}
              {%- endif -%}
            </div>

            <div class="brand-compare-card__body">
              {%- if card_title != blank -%}
                <h3 class="brand-compare-card__title">{{ card_title }}</h3>
              {%- endif -%}

              {%- if block.settings.dimensions != blank -%}
                <p class="brand-compare-card__spec">{{ block.settings.dimensions }}</p>
              {%- endif -%}

              {%- if block.settings.weight != blank -%}
                <p class="brand-compare-card__spec">{{ block.settings.weight }}</p>
              {%- endif -%}

              {%- if card_price != blank -%}
                <p class="brand-compare-card__price">{{ card_price }}</p>
              {%- endif -%}

              {%- if card_url != blank -%}
                <a class="brand-btn brand-btn--primary brand-compare-card__cta" href="{{ card_url }}">
                  {{ block.settings.cta_label | default: 'Shop now' }}
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand compare grid",
  "tag": "section",
  "class": "brand-compare-grid-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "Series grid for the Compare Nets page. Add one block per model — the grid auto-fits 3 to 5 cards across at desktop."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pro Series"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built to last. Sized to fit."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Surface",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "shadow", "label": "Shadow Green" },
        { "value": "glow", "label": "Glow Green" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Net model",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Linked product"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Fallback link",
          "info": "Used when no linked product is set."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Falls back to the linked product's featured image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Model name",
          "default": "Pro"
        },
        {
          "type": "text",
          "id": "dimensions",
          "label": "Dimensions line",
          "default": "8'w × 7'6\"h × 3'6\"d"
        },
        {
          "type": "text",
          "id": "weight",
          "label": "Weight line",
          "default": "Weight: 28 lbs."
        },
        {
          "type": "checkbox",
          "id": "use_product_price",
          "label": "Use linked product price",
          "default": true
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Fallback price",
          "default": "$795"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Shop now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand compare grid",
      "settings": {
        "eyebrow": "Pro Series",
        "heading": "Built to last. Sized to fit."
      }
    }
  ]
}
{% endschema %}
