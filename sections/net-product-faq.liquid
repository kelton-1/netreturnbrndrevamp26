<style>
  #faq-{{ section.id }} {
    max-width: 800px;
    margin: 60px auto;
    padding: 0 20px;
    font-family: Arial, sans-serif;
  }

  #faq-{{ section.id }} h2 {
    text-align: center;
    margin-bottom: 30px;
    font-size: 28px;
    color: #222;
  }

  #faq-{{ section.id }} .faq-item {
    border: 1px solid #eee;
    border-radius: 8px;
    margin-bottom: 12px;
    background: #fff;
    overflow: hidden;
  }

  #faq-{{ section.id }} .faq-question {
    padding: 16px 18px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 15px;
    color: #222;
  }

  #faq-{{ section.id }} .faq-question .icon {
    display: flex;
    transition: transform 0.3s ease;
  }

  #faq-{{ section.id }} .faq-answer {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    padding: 0 18px;
    font-size: 14px;
    color: #666;
    line-height: 1.6;
    transition: max-height 0.4s ease, opacity 0.3s ease;
    transition-delay: 0.05s; /* delay before opening */
    }

    #faq-{{ section.id }} .faq-item.active .faq-answer {
    max-height: 200px; /* enough height for content */
    opacity: 1;
    padding: 0 18px 16px;
    }

  #faq-{{ section.id }} .faq-item.active .faq-question .icon {
    transform: rotate(180deg);
  }
</style>

<section id="faq-{{ section.id }}">
  <h2>Frequently Asked Questions</h2>

  <div class="faq-item">
    <div class="faq-question">
      How long does it take to assemble?
      <span class="icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <path d="M6 9L12 15L18 9" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
    <div class="faq-answer">Assembly typically takes 5–10 minutes with no tools required.</div>
  </div>

  <div class="faq-item">
    <div class="faq-question">
      Can I leave it outside?
      <span class="icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <path d="M6 9L12 15L18 9" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
    <div class="faq-answer">Yes, the net is weather-resistant. For maximum lifespan, store it during extreme weather.</div>
  </div>

  <div class="faq-item">
    <div class="faq-question">
      Is it compatible with golf simulators?
      <span class="icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <path d="M6 9L12 15L18 9" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
    <div class="faq-answer">Yes, it works with most major golf simulator systems and does not interfere with sensors.</div>
  </div>

  <div class="faq-item">
    <div class="faq-question">
      What is the warranty coverage?
      <span class="icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <path d="M6 9L12 15L18 9" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
    <div class="faq-answer">It includes a 3-year comprehensive warranty covering manufacturing defects.</div>
  </div>

  <div class="faq-item">
    <div class="faq-question">
      Does this net work for baseball or softball?
      <span class="icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <path d="M6 9L12 15L18 9" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
    <div class="faq-answer">Yes, the net is suitable for baseball and softball practice as well.</div>
  </div>

  <div class="faq-item">
    <div class="faq-question">
      How do I clean and maintain the net?
      <span class="icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <path d="M6 9L12 15L18 9" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
    <div class="faq-answer">Wipe with a damp cloth or rinse with water. Let it air dry completely before storing.</div>
  </div>

  <div class="faq-item">
    <div class="faq-question">
      What is the return policy?
      <span class="icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <path d="M6 9L12 15L18 9" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
    <div class="faq-answer">We offer a 30-day return policy if you’re not completely satisfied.</div>
  </div>

  <div class="faq-item">
    <div class="faq-question">
      Can I use foam or plastic balls instead of real golf balls?
      <span class="icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
          <path d="M6 9L12 15L18 9" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
    <div class="faq-answer">Yes, foam and plastic balls work perfectly and are great for indoor practice.</div>
  </div>
</section>

<script>
  document.querySelectorAll('#faq-{{ section.id }} .faq-question').forEach(function (q) {
    q.addEventListener('click', function () {
      this.parentElement.classList.toggle('active');
    });
  });
</script>

{% schema %}
{
  "name": "Product FAQ",
  "settings": [],
  "presets": [
    {
      "name": "Product FAQ",
      "category": "Custom"
    }
  ]
}
{% endschema %}
