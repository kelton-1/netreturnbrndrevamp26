{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body = section.settings.body
  assign cta_text = section.settings.cta_text
  assign cta_link = section.settings.cta_link
  assign image = section.settings.image
  assign default_image_filename = section.settings.default_image_filename
  assign image_alt = image.alt | default: heading | default: shop.name
-%}

<section
  class="brand-proof-diagram brand-surface brand-surface--pattern"
  aria-labelledby="brand-proof-diagram-heading-{{ section.id }}"
  data-proof-diagram
>
  <div class="brand-proof-diagram__inner brand-container">
    <div class="brand-proof-diagram__copy">
      {%- if eyebrow != blank -%}
        <p class="brand-eyebrow brand-proof-diagram__eyebrow">
          <span class="brand-plus" aria-hidden="true"></span>
          {{ eyebrow }}
        </p>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 id="brand-proof-diagram-heading-{{ section.id }}" class="brand-proof-diagram__heading">{{ heading }}</h2>
      {%- endif -%}

      {%- if body != blank -%}
        <div class="brand-body brand-proof-diagram__body">{{ body }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ol class="brand-proof-diagram__list" role="list">
          {%- for block in section.blocks -%}
            {%- assign index_str = forloop.index | prepend: '0' | slice: -2, 2 -%}
            <li
              class="brand-proof-diagram__list-item"
              data-callout-id="{{ forloop.index }}"
              tabindex="0"
              {{ block.shopify_attributes }}
            >
              <span class="brand-proof-diagram__list-number" aria-hidden="true">{{ index_str }}</span>
              <div class="brand-proof-diagram__list-body">
                {%- if block.settings.stat != blank -%}
                  <p class="brand-proof-diagram__list-stat">{{ block.settings.stat }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="brand-proof-diagram__list-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="brand-proof-diagram__list-text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if cta_text != blank -%}
        <a class="brand-btn brand-btn--primary brand-proof-diagram__cta" href="{{ cta_link | default: '#' }}">{{ cta_text }}</a>
      {%- endif -%}
    </div>

    <figure class="brand-proof-diagram__figure">
      <div class="brand-proof-diagram__photo">
        {%- if image != blank -%}
          {{ image | image_url: width: 1400 | image_tag:
              class: 'brand-proof-diagram__image',
              loading: 'lazy',
              sizes: '(max-width: 999px) 92vw, 52vw',
              widths: '600, 900, 1200, 1400',
              alt: image_alt
          }}
        {%- elsif default_image_filename != blank -%}
          <img
            class="brand-proof-diagram__image"
            src="{{ default_image_filename | asset_url }}"
            alt="{{ heading | default: shop.name | escape }}"
            loading="lazy"
            width="1400"
            height="1400">
        {%- endif -%}

        <ol class="brand-proof-diagram__dots" role="list">
          {%- for block in section.blocks -%}
            {%- assign index_str = forloop.index | prepend: '0' | slice: -2, 2 -%}
            {%- assign x = block.settings.dot_x | default: 50 -%}
            {%- assign y = block.settings.dot_y | default: 50 -%}
            <li class="brand-proof-diagram__dot" style="--x: {{ x }}%; --y: {{ y }}%;">
              <button
                type="button"
                class="brand-proof-diagram__dot-mark"
                data-callout-id="{{ forloop.index }}"
                aria-label="{{ 'Highlight selling point ' | append: index_str }}{% if block.settings.title != blank %} — {{ block.settings.title | escape }}{% endif %}"
              >{{ index_str }}</button>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </figure>
  </div>
</section>

{% javascript %}
  function initProofDiagram(section) {
    if (!section || section.dataset.diagramInit === 'true') return;
    section.dataset.diagramInit = 'true';

    var items = section.querySelectorAll('[data-callout-id]');
    if (items.length === 0) return;

    items.forEach(function (el) {
      var id = el.dataset.calloutId;
      // Cache the matching set once. Section markup is static after render.
      var matches = Array.prototype.slice.call(
        section.querySelectorAll('[data-callout-id="' + id + '"]')
      );

      function setActive(active) {
        matches.forEach(function (m) {
          m.classList.toggle('is-active', active);
        });
      }

      el.addEventListener('mouseenter', function () { setActive(true); });
      el.addEventListener('mouseleave', function () { setActive(false); });
      el.addEventListener('focusin',    function () { setActive(true); });
      el.addEventListener('focusout',   function () { setActive(false); });
    });
  }

  document.querySelectorAll('[data-proof-diagram]').forEach(initProofDiagram);

  document.addEventListener('shopify:section:load', function (event) {
    var s = event.target.querySelector('[data-proof-diagram]');
    if (s) initProofDiagram(s);
  });
{% endjavascript %}

{% schema %}
{
  "name": "Brand proof — diagram",
  "tag": "section",
  "class": "brand-proof-diagram-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Desktop layout for the proof system. Two-column: copy + numbered list on the left, product image with anchored dots on the right. Hovering a dot or a list item highlights its match. Hidden on mobile — paired with the cinematic mobile section."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built to return more than the ball."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>The S-shape frame absorbs impact, sends the ball back, and keeps every rep moving.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Build your setup"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (isolated product shot recommended)"
    },
    {
      "type": "text",
      "id": "default_image_filename",
      "label": "Fallback theme asset filename"
    }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Selling point",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "stat",
          "label": "Stat",
          "default": "1 ball"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Instant return"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Patented return geometry keeps every rep moving."
        },
        {
          "type": "range",
          "id": "dot_x",
          "label": "Dot X position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "dot_y",
          "label": "Dot Y position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand proof — diagram",
      "settings": {
        "eyebrow": "Why it works",
        "heading": "Built to return more than the ball.",
        "cta_text": "Build your setup"
      },
      "blocks": [
        { "type": "callout", "settings": { "stat": "Patented",  "title": "Patented S-shape frame", "text": "Curved side panels absorb impact and feed the ball back to your feet — every rep, no chasing.", "dot_x": 14, "dot_y": 55 } },
        { "type": "callout", "settings": { "stat": "250K",      "title": "250,000-shot guarantee", "text": "Tour-grade netting backed by our warranty. Train as hard as you want — it holds.",            "dot_x": 55, "dot_y": 42 } },
        { "type": "callout", "settings": { "stat": "10 min",    "title": "10-minute setup",        "text": "Color-coded push-button connections — no tools, no manual. Breaks down just as fast.",          "dot_x": 84, "dot_y": 16 } },
        { "type": "callout", "settings": { "stat": "Any sport", "title": "Durable & versatile",    "text": "Indoor or outdoor, multi-sport ready, sleek enough to live in your space — not just your garage.", "dot_x": 12, "dot_y": 92 } }
      ]
    }
  ]
}
{% endschema %}
