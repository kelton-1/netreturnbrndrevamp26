<section class="comparison-wrapper">

  <!-- ===== Heading ===== -->
  <div class="compare-heading">
    <p class="compare-label">{{ section.settings.small_text }}</p>
    <h2 class="compare-title">{{ section.settings.heading }}</h2>
  </div>

  <!-- ===== Comparison Table ===== -->
  <div class="compare-table-scroll">
    <table class="compare-table">
      <thead>
        <tr>
          <th></th>
          <th data-key="junior">Junior</th>
          <th data-key="mini">Mini</th>
          <th data-key="home">Home</th>
          <th data-key="pro">Pro</th>
          <th data-key="pro-8">Pro 8</th>
          <th data-key="pro-9">Pro 9</th>
          <th data-key="pro-10">Pro 10</th>
          <th data-key="pro-xl">Pro XL</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td class="text-left">Size (W × H)</td>
          <td data-key="junior">4'6" × 4'6"</td>
          <td data-key="mini">5' × 6'</td>
          <td data-key="home">7' × 7'</td>
          <td data-key="pro">8' × 7'6"</td>
          <td data-key="pro-8">8' × 8'</td>
          <td data-key="pro-9">9' × 8'</td>
          <td data-key="pro-10">10' × 8'</td>
          <td data-key="pro-xl">10' × 9'6"</td>
        </tr>

        <tr>
          <td class="text-left">Net Depth</td>
          <td data-key="junior">3'6"</td>
          <td data-key="mini">2'4"</td>
          <td data-key="home">3'6"</td>
          <td data-key="pro">3'6"</td>
          <td data-key="pro-8">3'6"</td>
          <td data-key="pro-9">3'6"</td>
          <td data-key="pro-10">3'6"</td>
          <td data-key="pro-xl">3'6"</td>
        </tr>

        <tr>
          <td class="text-left">Ideal For</td>
          <td data-key="junior">Kids</td>
          <td data-key="mini">Small Spaces</td>
          <td data-key="home">Home / Garage</td>
          <td data-key="pro">Home / Garage</td>
          <td data-key="pro-8">Garage / Yard</td>
          <td data-key="pro-9">Large Yard</td>
          <td data-key="pro-10">Commercial</td>
          <td data-key="pro-xl">Pro Training</td>
        </tr>

        <tr>
          <td class="text-left">Ball Return</td>
          <td data-key="junior">✔</td>
          <td data-key="mini">✔</td>
          <td data-key="home">✔</td>
          <td data-key="pro">✔</td>
          <td data-key="pro-8">✔</td>
          <td data-key="pro-9">✔</td>
          <td data-key="pro-10">✔</td>
          <td data-key="pro-xl">✔</td>
        </tr>

        <tr>
          <td class="text-left">Max Ball Speed</td>
          <td data-key="junior">225 MPH</td>
          <td data-key="mini">225 MPH</td>
          <td data-key="home">225 MPH</td>
          <td data-key="pro">225 MPH</td>
          <td data-key="pro-8">225 MPH</td>
          <td data-key="pro-9">225 MPH</td>
          <td data-key="pro-10">225 MPH</td>
          <td data-key="pro-xl">225 MPH</td>
        </tr>

        <tr>
          <td class="text-left">Price</td>
          <td data-key="junior">$295</td>
          <td data-key="mini">$549</td>
          <td data-key="home">$695</td>
          <td data-key="pro">$795</td>
          <td data-key="pro-8">$895</td>
          <td data-key="pro-9">$995</td>
          <td data-key="pro-10">$1095</td>
          <td data-key="pro-xl">$1599</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<!-- ===== Styles ===== -->
<style>
.text-left{text-align:left;}
.comparison-wrapper {
  max-width: 1266px;
  margin: auto;
  padding: 60px 20px;
}

.compare-heading {
  text-align: left;
  margin-bottom: 30px;
}

.compare-label {
  color: #00a651;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.compare-title {
  font-size: 32px;
  font-weight: 700;
  margin-top: 0;
}

.compare-table-scroll {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.compare-table {
  width: 100%;
  min-width: 900px;
  border-collapse: collapse;
  text-align: center;
}

.compare-table th,
.compare-table td {
  padding: 14px;
  border-bottom: 1px solid #eee;
}

/* 🔥 Highlight active column */
.compare-table .active-product {
  color: #00a651;
  font-weight: 600;
  {% comment %} background: rgba(0, 166, 81, 0.08); {% endcomment %}
}
</style>

<!-- ===== Script ===== -->
<script>
document.addEventListener("DOMContentLoaded", function () {

  /* 🔑 Product handle → column key mapping */
  var handleMap = {
    "junior-golf-net": "junior",
    "mini-pro-series-golf-net": "mini",
    "golf-and-multi-sport-nets": "home",
    "pro-series-golf-net": "pro",
    "large-8-pro-series-golf-net": "pro-8",
    "large-9-pro-series-golf-net": "pro-9",
    "large-10-pro-series-golf-net": "pro-10",
    "xl-pro-series-golf-net": "pro-xl"
  };

  var currentHandle = "{{ product.handle }}";
  if (!currentHandle || !handleMap[currentHandle]) return;

  var activeKey = handleMap[currentHandle];

  document
    .querySelectorAll('[data-key="' + activeKey + '"]')
    .forEach(function (el) {
      el.classList.add("active-product");
    });

});
</script>

{% schema %}
{
  "name": "Compare Models",
  "settings": [
    {
      "type": "text",
      "id": "small_text",
      "label": "Small label text",
      "default": "COMPARE MODELS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure which net to choose?"
    }
  ],
  "presets": [
    {
      "name": "Compare Models"
    }
  ]
}
{% endschema %}
