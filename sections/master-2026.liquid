{% comment %}
  Master's Sale 2026 Landing Page — The Net Return
  Section: /sections/master-2026.liquid
{% endcomment %}

<section id="bfcm-{{ section.id }}" class="bfcm">
  {%- assign nets_pct = 10 -%}
  {%- assign packages_pct = 10 -%}
  {%- assign acc_pct = 10 -%}
  {%- assign simbays_pct = 10 -%}
  {%- assign sims_pct = 0 -%}

  {% if section.settings.hero_image %}
    <div class="bfcm__hero-media">
      {{ section.settings.hero_image | image_url: width: 2560 | image_tag: loading: 'lazy', widths: '1200,1600,1920,2560', alt: section.settings.hero_title }}
    </div>
  {% endif %}

  <div class="bfcm__hero-copy">
    {% if section.settings.kicker != blank %}<p class="bfcm__kicker">{{ section.settings.kicker }}</p>{% endif %}
    <h1 class="bfcm__title">{{ section.settings.hero_title }}</h1>
    {% if section.settings.hero_sub %}<p class="bfcm__sub">{{ section.settings.hero_sub }}</p>{% endif %}

    <div class="bfcm__return-pill" role="note" aria-label="{{ section.settings.kicker | default: 'Sale' | escape }} promotion">
      <span class="bfcm__return-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <rect x="3" y="4" width="18" height="16" rx="3" stroke="#111" stroke-width="1.5"/>
          <path d="M3 9h18" stroke="#111" stroke-width="1.5"/>
          <circle cx="8.5" cy="13.5" r="1.4" fill="#111"/>
          <circle cx="12"  cy="13.5" r="1.4" fill="#111"/>
          <circle cx="15.5" cy="13.5" r="1.4" fill="#111"/>
        </svg>
      </span>
      <span class="bfcm__return-text">
        <strong>{{ section.settings.kicker | default: 'Sale' }} is live now. Shop limited-time savings while offers last.</strong>
      </span>
    </div>

    {% if section.settings.coupon_text != blank %}
      <div class="bfcm__coupon-pill" role="note" aria-label="{{ section.settings.kicker | default: 'Sale' | escape }} details">
        <span class="bfcm__coupon-copy">{{ section.settings.coupon_text }}</span>
        {% if section.settings.coupon_code != blank and section.settings.coupon_code != 'NONE' %}
          <span class="bfcm__coupon-code">{{ section.settings.coupon_code }}</span>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.hero_cta_label != blank %}
      <a class="btn btn--primary" href="{{ section.settings.hero_cta_url | default: '#' }}">{{ section.settings.hero_cta_label }}</a>
    {% endif %}
  </div>

  {%- comment -%} Helper: global manual overrides lines {%- endcomment -%}
  {% assign _ov_lines = section.settings.price_overrides | default: '' | replace: '\r','' | split: '\n' %}

  {% assign _dummy = '' %}

  <div class="bfcm__container">
    {%- comment -%} SHOP NETS {%- endcomment -%}
    {% if section.settings.nets_collection != blank %}
    <div class="bfcm__row">
      <div class="bfcm__row-head">
        <h2 class="bfcm__row-title">
          Shop Pro Nets
          <span class="tag tag--white tag--tight"><strong>10% OFF</strong></span>
        </h2>

        <a class="chip chip--white"
          href="{{ section.settings.compare_sizes_url | default: 'https://www.thenetreturn.com/pages/compare' }}"
          target="_blank" rel="noopener">Compare sizes</a>
      </div>

      <div class="bfcm-slider" data-slider>
        <button class="bfcm-nav bfcm-nav--prev" aria-label="Previous">{% render 'icon', icon: 'nav-arrow-left', width: 18, height: 12 %}</button>
        <div class="bfcm-track" data-track>
          {% for product in section.settings.nets_collection.products limit: section.settings.nets_limit %}
            {% assign ov_price = '' %}{% assign ov_compare = '' %}{% assign use_manual = false %}
            {% for line in _ov_lines %}
              {% assign line = line | strip %}
              {% if line != '' %}
                {% assign parts = line | split: '|' %}
                {% assign h = parts[0] | strip %}
                {% if h == product.handle %}
                  {% assign ov_price   = parts[1] | default: '' | strip %}
                  {% assign ov_compare = parts[2] | default: '' | strip %}
                  {% if ov_price != '' %}{% assign use_manual = true %}{% endif %}
                  {% break %}
                {% endif %}
              {% endif %}
            {% endfor %}

            {% assign show_badge = false %}{% assign pct = 0 %}
            {% if use_manual and ov_compare != '' %}
              {% assign mp = ov_price   | remove:'$' | remove:'₹' | remove:'€' | remove:'£' | remove:',' | remove:' ' | replace: '.','' %}
              {% assign mc = ov_compare | remove:'$' | remove:'₹' | remove:'€' | remove:'£' | remove:',' | remove:' ' | replace: '.','' %}
              {% assign mp_num = mp | plus: 0 %}{% assign mc_num = mc | plus: 0 %}
              {% assign diff = mc_num | minus: mp_num %}
              {% if mc_num > 0 and diff > 0 %}
                {% assign pct = diff | times: 100 | divided_by: mc_num | round %}
                {% assign show_badge = true %}
              {% endif %}
            {% endif %}
            {% if show_badge == false and product.compare_at_price_max and product.compare_at_price_max > product.price %}
              {% assign diff = product.compare_at_price_max | minus: product.price %}
              {% assign pct  = diff | times: 100 | divided_by: product.compare_at_price_max | round %}
              {% assign show_badge = true %}
            {% endif %}

            <a href="{{ product.url }}" class="bfcm-card">
              {% if section.settings.nets_show_badge and show_badge %}<span class="bfcm-badge">Save {{ pct }}%</span>{% endif %}
              <div class="bfcm-card__img">
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', alt: product.title }}
              </div>
              <div class="bfcm-card__meta">
                <h3 class="bfcm-card__title">{{ product.title }}</h3>

                <div class="bfcm-card__prices bfcm-card__prices--promo">
                  <span class="price price--promo">
                    {% if use_manual %}
                      {{ ov_price }}
                    {% else %}
                      {% if settings.currency_code_enabled %}{{ product.price | money_with_currency }}{% else %}{{ product.price | money }}{% endif %}
                    {% endif %}
                  </span>
                  {% if section.settings.nets_show_compare %}
                    {% if use_manual %}
                      {% if ov_compare != '' %}<span class="compare">{{ ov_compare }}</span>{% endif %}
                    {% else %}
                      {% if product.compare_at_price_max and product.compare_at_price_max > product.price %}
                        <span class="compare">
                          {% if settings.currency_code_enabled %}{{ product.compare_at_price_max | money_with_currency }}{% else %}{{ product.compare_at_price_max | money }}{% endif %}
                        </span>
                      {% endif %}
                    {% endif %}
                  {% endif %}
                </div>
              </div>
            </a>
          {% endfor %}
        </div>
        <button class="bfcm-nav bfcm-nav--next" aria-label="Next">{% render 'icon', icon: 'nav-arrow-right', width: 18, height: 12 %}</button>
      </div>
    </div>
    {% endif %}

    {%- comment -%} SHOP PACKAGES {%- endcomment -%}
    {% if section.settings.packages_collection != blank %}
    <div class="bfcm__row">
      <div class="bfcm__row-head">
