{%- comment -%}
  Brand cross-link block (brand-revamp 2026).
  Three editorial action cards typically dropped between the product grid
  and the FAQ. Default intent: "Still deciding? Here are three next steps."
  Each card: mono eyebrow + Crystal headline + body + Emerald arrow CTA.
{%- endcomment -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body = section.settings.body
  assign surface = section.settings.surface | default: 'glow'
  assign columns = section.settings.columns | default: 3
-%}

<section
  class="brand-cross-links brand-surface brand-surface--{{ surface }}"
  data-brand-cross-links
  data-brand-reveal
  style="--brand-cross-cols: {{ columns }};"
  {% if heading != blank %}aria-labelledby="brand-cross-links-heading-{{ section.id }}"{% endif %}
>
  <div class="brand-container brand-cross-links__inner">
    {%- if eyebrow != blank or heading != blank or body != blank -%}
      <header class="brand-cross-links__header">
        {%- if eyebrow != blank -%}
          <p class="brand-eyebrow brand-cross-links__eyebrow">
            <span class="brand-plus" aria-hidden="true"></span>
            {{ eyebrow }}
          </p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 id="brand-cross-links-heading-{{ section.id }}" class="brand-cross-links__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if body != blank -%}
          <p class="brand-body brand-cross-links__body">{{ body }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ul class="brand-cross-links__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_eyebrow = block.settings.eyebrow
          assign card_heading = block.settings.heading
          assign card_body = block.settings.body
          assign card_cta = block.settings.cta_text | default: 'Learn more'
          assign card_link = block.settings.link
        -%}
        {%- if card_heading != blank -%}
          <li {{ block.shopify_attributes }}>
            <a class="brand-cross-card" href="{{ card_link | default: '#' }}">
              {%- if card_eyebrow != blank -%}
                <span class="brand-cross-card__eyebrow">
                  <span class="brand-plus" aria-hidden="true"></span>
                  {{ card_eyebrow }}
                </span>
              {%- endif -%}
              <span class="brand-cross-card__heading">{{ card_heading }}</span>
              {%- if card_body != blank -%}
                <span class="brand-cross-card__body">{{ card_body }}</span>
              {%- endif -%}
              <span class="brand-cross-card__cta">
                {{ card_cta }}
                <span class="brand-cross-card__cta-arrow" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Brand cross-link block",
  "tag": "section",
  "class": "brand-cross-links-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Three editorial action cards. Default intent: pre-FAQ \"where to next?\" — Compare side-by-side, Take the fit quiz, Talk to an expert."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Still deciding?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three ways to land on the right net."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Surface color",
      "options": [
        { "value": "glow", "label": "Glow Green" },
        { "value": "shadow", "label": "Shadow Green" },
        { "value": "white", "label": "White" }
      ],
      "default": "glow"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "cross_link",
      "name": "Cross-link card",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow (mono caps)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Compare side-by-side"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Open compare"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand cross-link block",
      "settings": {
        "surface": "glow",
        "columns": 3
      },
      "blocks": [
        { "type": "cross_link", "settings": { "eyebrow": "Decide",  "heading": "Compare side-by-side",       "body": "See every net's dimensions, weight, and best-fit space in one table.", "cta_text": "Open compare" } },
        { "type": "cross_link", "settings": { "eyebrow": "Match",   "heading": "Take the 60-second fit quiz", "body": "Answer five questions about your space and we'll narrow it to one net.", "cta_text": "Start the quiz" } },
        { "type": "cross_link", "settings": { "eyebrow": "Ask",     "heading": "Talk to a Net Return expert", "body": "Real humans, fast answers. Free shipping advice on the way out.",      "cta_text": "Book a call" } }
      ]
    }
  ]
}
{% endschema %}
