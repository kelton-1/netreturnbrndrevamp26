    {% render 'footer-app-block' %}
    {% render 'wnw_footer' %} 
    
    <script type="lazyload_int">
      document.addEventListener('octane.quiz.completed', function (e) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'quizCompleted',
          quizName: e.detail.quiz_results_url || undefined,
          quizAnswers: e.detail.answers,
        });
      });
    </script>
    <script type="lazyload_int">
    (function() {
      function loadScript(src){
        var s = document.createElement('script');
        s.src = src;
        s.async = true;
        document.body.appendChild(s);
      }

      // IntersectionObserver approach: load loox when user scrolls near the page end
      var sentinel = document.createElement('div');
      sentinel.id = 'loox-loader-sentinel';
      sentinel.style.cssText = 'width:1px;height:1px;position:fixed;bottom:10px;left:0;pointer-events:none;opacity:0';
      document.body.appendChild(sentinel);

      var io = new IntersectionObserver(function(entries, observer) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            loadScript('https://cdn.loox.io/loox.js');
            observer.disconnect();
            sentinel.remove();
          }
        });
      }, {
        root: null,
        rootMargin: '300px', // load when user is within ~300px of bottom
        threshold: 0
      });

      // start observing once DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function(){ io.observe(sentinel); });
      } else {
        io.observe(sentinel);
      }
    })();
    (function() {
        function idleLoad(src, opts){
          var load = function(){
            var s = document.createElement('script');
            s.src = src;
            if (opts && opts.async) s.async = true;
            if (opts && opts.defer) s.defer = true;
            document.body.appendChild(s);
          };
          if ('requestIdleCallback' in window) {
            requestIdleCallback(load, {timeout: 2000});
          } else {
            setTimeout(load, 1500);
          }
        }

        // idle-load analytics/third-party only after first paint / idle
        // mm-uxrv (example)
        document.addEventListener('DOMContentLoaded', function(){
          // load on idle so critical render isn't blocked
          idleLoad('https://mm-uxrv.com/js/mm_f18f1911-b020-48d0-ae0d-00f656ad55da-85530283.js', {async: true});
        });

        // Facebook Pixel: idle-load instead of on window.load
        idleLoad('https://connect.facebook.net/en_US/fbevents.js', {async: true});
      })();
        (function(){
          var loaded = false;
          function loadRedo(){
            if (loaded) return;
            loaded = true;
            var s = document.createElement('script');
            // Replace with the exact Redo script URL you see in the Network tab / Lighthouse.
            s.src = 'https://cdn.redo.do/path/to/redo-widget.js';
            s.async = true;
            document.body.appendChild(s);
          }
          if ('IntersectionObserver' in window){
            var io = new IntersectionObserver(function(entries, ob){
              entries.forEach(function(e){
                if (e.isIntersecting) { loadRedo(); ob.disconnect(); }
              });
            }, {root:null, rootMargin:'300px', threshold:0});
            var t = document.getElementById('returns-widget-sentinel');
            if (t) io.observe(t); else loadRedo();
          } else {
            // older browsers - defer load
            setTimeout(loadRedo, 2000);
          }
        })();
      </script>
          
          
  </body>
</html>
