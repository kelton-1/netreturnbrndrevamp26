    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    
     {%- if canonical_url contains "tagged" or canonical_url contains "vendors?q=" or canonical_url contains "/collections/all"  or canonical_url contains "/apps/sitemap" -%}
    <meta name="robots" content="noindex">
    {%- endif -%}
    
    {%- if settings.favicon -%}
