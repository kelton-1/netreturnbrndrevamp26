  {%- if request.page_type == 'page' -%}
  {%- assign video_schema_page_handles = "3d-flex-screen-assembly,3d-net-assembly,adding-bounce-to-pro-turf,assembly,assembly-1,become-an-affiliate,classic-pro-assembly,copy-of-pro-series-jr-net-assembly,custom-sim-screens,extra-point-assembly,flex-screen-installation-video,frame-pads-assembly,home-series-and-pro-series-v2-side-barrier-installation,home-series-v2-assembly,home-series-v2-pro-package,horizontal-frame-pads,junior-side-barriers-assembly,large-10-pro-series-v2-assembly,large-10-v2-pro-package-assembly,large-8-pro-series-v2-assembly,large-8-v2-pro-package,large-9-pro-series-assembly,large-9-v2-pro-package,mini-pro-series-assembly,net-guardian-assembly,no-fly-zone-installation,no-fly-zone-v2-assembly,optoma-projector-installation-videos,outdoor-cover-assembly,platinum-package-assembly,platinum-turf-assembly,pro-series-jr-net-assembly,pro-series-v2-assembly,pro-series-v2-golf-package-assembly-videos,pro-turf-assembly,pro-turf-putting-cup-tees-assembly,projectot-mount-assembly,side-barriers-mini-assembly-video,sim-series-v3-assembly,simulator-kit-assembly,simulator-series-10-assembly,simulator-series-12-assembly,simulator-series-8-assembly-video,simulator-valence-assembly,split-screen-assembly,split-screen-introduction,target-2x2-assembly,top-videos,universal-side-barriers-home-series-v2-assembly-videos,universal-side-barriers-large-10-pro-series-v2-assembly-video,universal-side-barriers-large-8-pro-series-v2-assembly-video,universal-side-barriers-large-9-pro-series-v2-assembly-video,universal-side-barriers-pro-series-v2-assembly-video,valence-assembly,xl-pro-series-v2-assembly,xl-side-barriers-assembly,xl-simulator-valence-assembly,xl-v2-pro-package" | split: "," -%}
