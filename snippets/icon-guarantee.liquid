{%- liquid
  assign icon_name = icon | default: 'check_mark'
  assign icon_size = size | default: 'md'
  assign px = 24

  if icon_size == 'sm'
    assign px = 20
  endif
-%}
{%- case icon_name -%}
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" aria-hidden="true">
      <path d="M12 3.5l2.5 5.2 5.7.8-4.1 4 1 5.7L12 16.5 6.9 19.2l1-5.7-4.1-4 5.7-.8L12 3.5Z" fill="currentColor"></path>
    </svg>
  {%- when 'award' -%}
    <svg viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" aria-hidden="true">
      <circle cx="12" cy="9" r="5" stroke="currentColor" stroke-width="1.8"></circle>
      <path d="M9 13.2 7 20l5-2 5 2-2-6.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  {%- when 'trophy' -%}
    <svg viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" aria-hidden="true">
      <path d="M8 4h8v2a4 4 0 0 1-8 0V4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
      <path d="M8 5H5a2 2 0 0 0 2 2M16 5h3a2 2 0 0 1-2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      <path d="M12 10v4M9 20h6M10 16h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
  {%- when 'rocket' -%}
    <svg viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" aria-hidden="true">
      <path d="M14 4c3 1 5 3 6 6-2.3 1.2-4.6 1.7-7 1.7L12.3 13 11 14.3l-1.3-1.3 1.3-1.3C11 9.3 11.8 7 14 4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
      <path d="M8.5 15.5 5 19l1-4 2.5.5ZM9 8l-4 1 3-3 1 2Z" fill="currentColor"></path>
    </svg>
  {%- when 'users' -%}
    <svg viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" aria-hidden="true">
      <circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.8"></circle>
      <circle cx="16.5" cy="10" r="2.5" stroke="currentColor" stroke-width="1.8"></circle>
      <path d="M4.5 18a4.5 4.5 0 0 1 9 0M13 18a3.5 3.5 0 0 1 7 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
  {%- when 'check_mark' -%}
    <svg viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" aria-hidden="true">
      <path d="m5 12 4 4 10-10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  {%- when 'chat_bubble' -%}
    <svg viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" aria-hidden="true">
      <path d="M6 17.5 3.5 20V6.5A2.5 2.5 0 0 1 6 4h12A2.5 2.5 0 0 1 20.5 6.5v7A2.5 2.5 0 0 1 18 16H6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
      <path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
  {%- when 'lightning' -%}
    <svg viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" aria-hidden="true">
      <path d="M13.5 2 6 13h5l-1 9 8-11h-5l.5-9Z" fill="currentColor"></path>
    </svg>
  {%- when 'calendar' -%}
    <svg viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" aria-hidden="true">
      <rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.8"></rect>
      <path d="M8 3v4M16 3v4M4 9h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
  {%- when 'eye' -%}
    <svg viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" aria-hidden="true">
      <path d="M2.5 12s3.5-5 9.5-5 9.5 5 9.5 5-3.5 5-9.5 5-9.5-5-9.5-5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
      <circle cx="12" cy="12" r="2.8" stroke="currentColor" stroke-width="1.8"></circle>
    </svg>
  {%- when 'support' -%}
    <svg viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" aria-hidden="true">
      <path d="M5 11a7 7 0 1 1 14 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      <rect x="4" y="11" width="3" height="6" rx="1.5" fill="currentColor"></rect>
      <rect x="17" y="11" width="3" height="6" rx="1.5" fill="currentColor"></rect>
      <path d="M12 18v2h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.8"></circle>
    </svg>
{%- endcase -%}
