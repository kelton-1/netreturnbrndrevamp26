<desktop-navigation>
  <ul class="header__linklist list--unstyled {% unless bottom_navigation %}hidden-pocket hidden-lap{% endunless %}" role="list">
    {%- for link in menu.links -%}
      {%- assign link_title_downcase = link.title | strip | downcase -%}
      {%- assign mega_menu_block = '' -%}
      {%- assign mega_menu_images = '' -%}
      {%- assign is_shop_menu = false -%}
      {%- if link_title_downcase == 'shop' -%}
        {%- assign is_shop_menu = true -%}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- assign menu_item_downcase = block.settings.menu_item | strip | downcase -%}

        {%- if menu_item_downcase == link_title_downcase -%}
          {%- assign mega_menu_block = block -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      <li class="header__linklist-item {% if link.links.size > 0 or mega_menu_block != '' %}has-dropdown{% endif %}" data-item-title="{{ link.title | escape }}">
        <a class="header__linklist-link link--animated" href="{{ link.url }}" {% if link.links.size > 0 or mega_menu_block != '' %}aria-controls="desktop-menu-{{ forloop.index }}" aria-expanded="false"{% endif %}>
          {{- link.title -}}
        </a>

        {%- if mega_menu_block != '' and mega_menu_block.settings.enable_brand_layout -%}
          {%- comment -%}
            Brand mega-menu (Concept C): featured product card + featured collection card on the left,
            submenu links rendered as compact text columns on the right.
            Falls back to the legacy 6-image grid below when enable_brand_layout is off.
          {%- endcomment -%}

          {%- assign fp = mega_menu_block.settings.featured_product -%}
          {%- assign fp_image = mega_menu_block.settings.featured_product_image | default: fp.featured_image | default: mega_menu_block.settings.image_1 -%}
          {%- assign fp_title = mega_menu_block.settings.featured_product_title_override | default: fp.title | default: mega_menu_block.settings.image_1_heading -%}
          {%- assign fp_body = mega_menu_block.settings.featured_product_body | default: mega_menu_block.settings.image_1_text -%}
          {%- assign fp_url = fp.url | default: mega_menu_block.settings.image_1_link | default: '#' -%}

          {%- assign fc = mega_menu_block.settings.featured_collection -%}
          {%- assign fc_image = mega_menu_block.settings.featured_collection_image | default: fc.featured_image | default: mega_menu_block.settings.image_2 -%}
          {%- assign fc_title = mega_menu_block.settings.featured_collection_title_override | default: fc.title | default: mega_menu_block.settings.image_2_heading -%}
          {%- assign fc_body = mega_menu_block.settings.featured_collection_body | default: mega_menu_block.settings.image_2_text -%}
          {%- assign fc_url = fc.url | default: mega_menu_block.settings.image_2_link | default: '#' -%}

          <div hidden id="desktop-menu-{{ forloop.index }}" class="mega-menu mega-menu--brand mega-menu--brand--text-left {% if is_shop_menu %}mega-menu--brand--shop{% endif %}" {{ mega_menu_block.shopify_attributes }}>
            <div class="mega-menu--brand__grid">
              {%- if link.links.size > 0 -%}
                <div class="mega-menu--brand__nav">
                  <div class="mega-menu--brand__nav-header">
                    <p class="mega-menu--brand__section-label">{% if is_shop_menu %}Shop by category{% else %}Browse {{ link.title }}{% endif %}</p>
                    <p class="mega-menu--brand__nav-heading">{% if is_shop_menu %}Start with the right path.{% else %}Choose a path{% endif %}</p>
                  </div>

                  {%- for sub_link in link.links -%}
                    <div class="mega-menu--brand__nav-col">
                      {%- if sub_link.url == '#' -%}
                        <span class="mega-menu--brand__nav-eyebrow">{{ sub_link.title }}</span>
                      {%- else -%}
                        <a class="mega-menu--brand__nav-eyebrow" href="{{ sub_link.url }}">{{ sub_link.title }}</a>
                      {%- endif -%}
                      {%- if sub_link.links.size > 0 -%}
                        <ul class="mega-menu--brand__nav-links list--unstyled">
                          {%- for sub_sub_link in sub_link.links -%}
                            <li><a href="{{ sub_sub_link.url }}">{{ sub_sub_link.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              {%- if fp_image != blank or fp_title != blank -%}
                <a class="mega-menu--brand__card mega-menu--brand__card--product" href="{{ fp_url }}">
                  {%- if fp_image != blank -%}
                    {{ fp_image | image_url: width: 1000 | image_tag: class: 'mega-menu--brand__card-image', loading: 'lazy', sizes: '(min-width: 1200px) 30vw, 50vw', widths: '480, 720, 1000', alt: fp_title }}
                  {%- endif -%}
                  <div class="mega-menu--brand__card-body">
                    {%- if mega_menu_block.settings.featured_product_eyebrow != blank -%}
                      <p class="mega-menu--brand__card-eyebrow">{{ mega_menu_block.settings.featured_product_eyebrow }}</p>
                    {%- endif -%}
                    <h3 class="mega-menu--brand__card-title">{{ fp_title }}</h3>
                    {%- if fp_body != blank -%}
                      <p class="mega-menu--brand__card-meta">{{ fp_body }}</p>
                    {%- endif -%}
                    {%- if mega_menu_block.settings.featured_product_cta_text != blank -%}
                      <span class="brand-btn brand-btn--primary mega-menu--brand__card-cta">{{ mega_menu_block.settings.featured_product_cta_text }}</span>
                    {%- endif -%}
                  </div>
                </a>
              {%- endif -%}

              {%- if fc_image != blank or fc_title != blank -%}
                <a class="mega-menu--brand__card mega-menu--brand__card--collection" href="{{ fc_url }}">
                  {%- if fc_image != blank -%}
                    {{ fc_image | image_url: width: 1000 | image_tag: class: 'mega-menu--brand__card-image', loading: 'lazy', sizes: '(min-width: 1200px) 30vw, 50vw', widths: '480, 720, 1000', alt: fc_title }}
                  {%- endif -%}
                  <div class="mega-menu--brand__card-body">
                    {%- if mega_menu_block.settings.featured_collection_eyebrow != blank -%}
                      <p class="mega-menu--brand__card-eyebrow">{{ mega_menu_block.settings.featured_collection_eyebrow }}</p>
                    {%- endif -%}
                    <h3 class="mega-menu--brand__card-title">{{ fc_title }}</h3>
                    {%- if fc_body != blank -%}
                      <p class="mega-menu--brand__card-meta">{{ fc_body }}</p>
                    {%- endif -%}
                    {%- if mega_menu_block.settings.featured_collection_cta_text != blank -%}
                      <span class="brand-btn brand-btn--outline mega-menu--brand__card-cta">{{ mega_menu_block.settings.featured_collection_cta_text }}</span>
                    {%- endif -%}
                  </div>
                </a>
              {%- endif -%}
            </div>
          </div>

        {%- elsif mega_menu_block != '' -%}
          {%- assign images_count = 0 -%}

          {%- capture mega_menu_images -%}
            {%- for i in (1..6) -%}
              {%- capture image_setting -%}image_{{ i }}{%- endcapture -%}

              {%- if mega_menu_block.settings[image_setting] != blank -%}
                {%- assign images_count = images_count | plus: 1 -%}

                {%- capture image_heading_setting -%}image_{{ i }}_heading{%- endcapture -%}
                {%- capture image_text_setting -%}image_{{ i }}_text{%- endcapture -%}
                {%- capture image_link_setting -%}image_{{ i }}_link{%- endcapture -%}

                {%- capture image_push -%}
                  <div class="mega-menu__image-wrapper">
                    {%- assign menu_image = mega_menu_block.settings[image_setting] -%}
                    {{ menu_image | image_url: width: menu_image.width | image_tag: loading: 'lazy',fetchpriority:'high', sizes: '240px', sizes: '240,480,720', class: 'mega-menu__image' }}
                  </div>

                  {%- if mega_menu_block.settings[image_heading_setting] != '' -%}
                    <p class="mega-menu__heading heading heading--small">{{ mega_menu_block.settings[image_heading_setting] }}</p>
                  {%- endif -%}

                  {%- if mega_menu_block.settings[image_text_setting] != '' -%}
                    <span class="mega-menu__text">{{ mega_menu_block.settings[image_text_setting] }}</span>
                  {%- endif -%}
                {%- endcapture -%}

                {%- if mega_menu_block.settings[image_link_setting] != blank -%}
                  <a href="{{ mega_menu_block.settings[image_link_setting] }}" class="mega-menu__image-push image-zoom">
                    {{- image_push -}}
                  </a>
                {%- else -%}
                  <div class="mega-menu__image-push image-zoom">
                    {{- image_push -}}
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}

          {%- if link.links.size > 0 or mega_menu_images != blank -%}
            <div hidden id="desktop-menu-{{ forloop.index }}" class="mega-menu" {{ mega_menu_block.shopify_attributes }}>
              <div class="container">
                <div class="mega-menu__inner">
                  {%- if mega_menu_block.settings.images_position == 'left' and mega_menu_images != blank -%}
                    <div class="mega-menu__images-wrapper {% if images_count >= 3 %}mega-menu__images-wrapper--tight{% endif %}">
                      <p class="mega-menu__guided-title heading heading--xsmall">Not sure where to start?</p>
                      {{- mega_menu_images -}}
                    </div>
                  {%- endif -%}

                  {%- if link.links.size > 0 -%}
                    <div class="mega-menu__columns-wrapper">
                      {%- for sub_link in link.links -%}
                        <div class="mega-menu__column">
                          {%- if sub_link.url == '#' -%}
                            <span class="mega-menu__title heading heading--small">{{ sub_link.title }}</span>
                          {%- else -%}
                            <a href="{{ sub_link.url }}" class="mega-menu__title heading heading--small">{{ sub_link.title }}</a>
                          {%- endif -%}

                          {%- if sub_link.links.size > 0 -%}
                            <ul class="linklist list--unstyled" role="list">
                              {%- for sub_sub_link in sub_link.links -%}
                                <li class="linklist__item">
                                  <a href="{{ sub_sub_link.url }}" class="link--faded">{{ sub_sub_link.title }}</a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- if mega_menu_block.settings.images_position == 'right' and mega_menu_images != blank -%}
                    <div class="mega-menu__images-wrapper {% if images_count >= 3 %}mega-menu__images-wrapper--tight{% endif %}">
                      <p class="mega-menu__guided-title heading heading--xsmall">Not sure where to start?</p>
                      {{- mega_menu_images -}}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- elsif link.links.size > 0 -%}
          <ul hidden id="desktop-menu-{{ forloop.index }}" class="nav-dropdown {% if link.levels == 1 %}nav-dropdown--restrict{% endif %} list--unstyled" role="list">
            {%- for sub_link in link.links -%}
              <li class="nav-dropdown__item {% if sub_link.links.size > 0 %}has-dropdown{% endif %}">
                <a class="nav-dropdown__link link--faded" href="{{ sub_link.url }}" {% if sub_link.links.size > 0 %}aria-controls="desktop-menu-{{ forloop.parentloop.index }}-{{ forloop.index }}" aria-expanded="false"{% endif %}>
                  {{- sub_link.title -}}

                  {%- if sub_link.links.size > 0 -%}
                    {% render 'icon' with 'dropdown-arrow-right', direction_aware: true %}
                  {%- endif -%}
                </a>

                {%- if sub_link.links.size > 0 -%}
                  <ul hidden id="desktop-menu-{{ forloop.parentloop.index }}-{{ forloop.index }}" class="nav-dropdown list--unstyled" role="list">
                    {%- for sub_sub_link in sub_link.links -%}
                      <li class="nav-dropdown__item">
                        <a class="nav-dropdown__link link--faded" href="{{ sub_sub_link.url }}">{{ sub_sub_link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</desktop-navigation>
