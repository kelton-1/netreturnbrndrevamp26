{% doc %}
  @prompt
    best seller products with add to cart button 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bestsellers-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-bestsellers__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-bestsellers__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-bestsellers__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 10px;
  }

  .ai-bestsellers__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
  }

  .ai-bestsellers__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-bestsellers__product-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-bestsellers__product-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-bestsellers__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-bestsellers__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bestsellers__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .ai-bestsellers__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .ai-bestsellers__vendor-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 12px;
    text-transform: uppercase;
    margin-bottom: 8px;
    opacity: 0.7;
  }

  .ai-bestsellers__title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.product_title_size }}px;
    margin: 0 0 12px;
    line-height: 1.3;
  }

  .ai-bestsellers__title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-bestsellers__title-link-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-bestsellers__price-{{ ai_gen_id }} {
    margin-bottom: 16px;
    font-size: {{ block.settings.price_size }}px;
  }

  .ai-bestsellers__price-regular-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-weight: 600;
  }

  .ai-bestsellers__price-compare-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: line-through;
    margin-left: 8px;
    opacity: 0.6;
  }

  .ai-bestsellers__price-sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_color }};
    font-weight: 600;
  }

  .ai-bestsellers__button-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    margin-top: auto;
  }

  .ai-bestsellers__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-bestsellers__button-{{ ai_gen_id }}:disabled {
    background-color: {{ block.settings.sold_out_background }};
    color: {{ block.settings.sold_out_text_color }};
    cursor: not-allowed;
  }

  .ai-bestsellers__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
  }

  .ai-bestsellers__empty-icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-bestsellers__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-bestsellers__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.products_per_row_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-bestsellers__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.75 }}px;
    }

    .ai-bestsellers__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<bestseller-products-{{ ai_gen_id }}
  class="ai-bestsellers-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-bestsellers__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-bestsellers__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-bestsellers__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-bestsellers__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.collection != blank %}
      {% assign products = block.settings.collection.products | limit: block.settings.products_to_show %}
      
      {% if products.size > 0 %}
        <div class="ai-bestsellers__grid-{{ ai_gen_id }}">
          {% for product in products %}
            <div class="ai-bestsellers__product-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-bestsellers__image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-bestsellers__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-bestsellers__image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                
                {% if block.settings.show_badge %}
                  <span class="ai-bestsellers__badge-{{ ai_gen_id }}">{{ block.settings.badge_text }}</span>
                {% endif %}
              </a>

              <div class="ai-bestsellers__content-{{ ai_gen_id }}">
                {% if block.settings.show_vendor and product.vendor != blank %}
                  <div class="ai-bestsellers__vendor-{{ ai_gen_id }}">{{ product.vendor }}</div>
                {% endif %}

                <h3 class="ai-bestsellers__title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}" class="ai-bestsellers__title-link-{{ ai_gen_id }}">
                    {{ product.title }}
                  </a>
                </h3>

                <div class="ai-bestsellers__price-{{ ai_gen_id }}">
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-bestsellers__price-sale-{{ ai_gen_id }}">{{ product.price | money }}</span>
                    <span class="ai-bestsellers__price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                  {% else %}
                    <span class="ai-bestsellers__price-regular-{{ ai_gen_id }}">{{ product.price | money }}</span>
                  {% endif %}
                </div>

                <button
                  type="button"
                  class="ai-bestsellers__button-{{ ai_gen_id }}"
                  data-product-id="{{ product.id }}"
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  {% unless product.available %}disabled{% endunless %}
                >
                  {% if product.available %}
                    {{ block.settings.button_text }}
                  {% else %}
                    {{ block.settings.sold_out_text }}
                  {% endif %}
                </button>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-bestsellers__empty-{{ ai_gen_id }}">
          <div class="ai-bestsellers__empty-icon-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
          <p>No products found in this collection.</p>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-bestsellers__empty-{{ ai_gen_id }}">
        <div class="ai-bestsellers__empty-icon-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
        <p>Select a collection to display best sellers.</p>
      </div>
    {% endif %}
  </div>
</bestseller-products-{{ ai_gen_id }}>

<script>
  (function() {
    class BestsellerProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-bestsellers__button-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', this.handleAddToCart.bind(this));
        });
      }

      async handleAddToCart(event) {
        const button = event.target;
        const variantId = button.dataset.variantId;
        
        if (!variantId || button.disabled) return;

        const originalText = button.textContent;
        button.textContent = 'Adding...';
        button.disabled = true;

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1
            })
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          button.textContent = 'Added!';
          
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);

          document.dispatchEvent(new CustomEvent('cart:refresh'));
          
          const cartResponse = await fetch('/cart.js');
          const cart = await cartResponse.json();
          
          if (window.theme && window.theme.cart) {
            window.theme.cart.refresh();
          }

        } catch (error) {
          console.error('Error adding to cart:', error);
          button.textContent = 'Error';
          
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        }
      }
    }

    customElements.define('bestseller-products-{{ ai_gen_id }}', BestsellerProducts{{ ai_gen_id }});
  })();
</script>

