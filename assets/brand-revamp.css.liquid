}
.brand-category-rail__tile:hover .brand-category-rail__cta,
.brand-category-rail__tile:focus-within .brand-category-rail__cta {
  opacity: 1;
  transform: translateY(0);
}
.brand-category-rail__cta-arrow {
  display: inline-block;
  transition: transform .3s ease;
}
.brand-category-rail__tile:hover .brand-category-rail__cta-arrow,
.brand-category-rail__tile:focus-within .brand-category-rail__cta-arrow {
  transform: translateX(4px);
}

@media (max-width: 749px) {
  /* On touch, drop the auto-scroll loop entirely. The duplicated tiles are
     hidden (their aria-hidden marker doubles as the display selector) and
     the viewport becomes a native horizontal scroll-snap rail. */
  .brand-category-rail__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: clamp(16px, 4vw, 32px);
    -webkit-overflow-scrolling: touch;
    -webkit-mask-image: none;
            mask-image: none;
  }
  .brand-category-rail__track {
    animation: none;
    transform: none;
    width: max-content;
    padding-inline: clamp(16px, 4vw, 32px);
  }
  .brand-category-rail__tile[aria-hidden="true"] {
    display: none;
  }
  .brand-category-rail__tile {
    width: 78vw;
    max-width: 360px;
  }
}

/* ============================================================
   Category — Concept A (Cinematic Accordion)
   Horizontal stack of 4 equal panels at rest. Hovering or focusing
   any panel expands it to ~58% width and reveals a description,
   optional featured product, and an Emerald CTA. The other panels
   compress to ~14%. Mobile collapses to a static vertical stack
   with everything visible.

   :has() drives the row layout from a single condition so there is
   no JS state to manage — pointer leaves and CSS reverts. JS only
   adds .is-in-view via IntersectionObserver to gate the Ken Burns
   drift until the section is on-screen.
   ============================================================ */


/* ============================================================
   BRAND SERIES CARDS — sections/brand-series-cards__tiles.liquid
   Two side-by-side hero cards. Full-bleed photo, overlay,
   content stacked bottom-left, hover scales image + darkens
   overlay. Mobile collapses to a single stacked column.
   ============================================================ */

.brand-series-cards__tiles {
