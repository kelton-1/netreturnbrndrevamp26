}
.brand-collection-grid__sort-button:hover {
  border-color: rgb(var(--brand-emerald));
  color: rgb(var(--brand-emerald));
}
.brand-collection-grid__sort-label { color: rgba(var(--brand-shadow), .58); }
.brand-collection-grid__sort-value { font-weight: 600; }

.brand-collection-grid__list { display: block; }
.brand-collection-grid__inner-list {
  display: grid;
  gap: clamp(16px, 2vw, 28px);
  grid-template-columns: repeat(var(--brand-grid-cols-desktop, 4), 1fr);
}
@media (max-width: 1199px) {
  .brand-collection-grid__inner-list { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 899px) {
  .brand-collection-grid__inner-list { grid-template-columns: repeat(var(--brand-grid-cols-mobile, 2), 1fr); }
}
@media (max-width: 540px) {
