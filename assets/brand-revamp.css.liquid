/* Hero label is larger than siblings. */
.brand-category-mosaic[data-hero-id="1"] .brand-category-mosaic__card[data-card-id="1"] .brand-category-mosaic__label,
.brand-category-mosaic[data-hero-id="2"] .brand-category-mosaic__card[data-card-id="2"] .brand-category-mosaic__label,
.brand-category-mosaic[data-hero-id="3"] .brand-category-mosaic__card[data-card-id="3"] .brand-category-mosaic__label,
.brand-category-mosaic[data-hero-id="4"] .brand-category-mosaic__card[data-card-id="4"] .brand-category-mosaic__label {
