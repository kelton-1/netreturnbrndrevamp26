}
.brand-category-mosaic__cta-arrow {
  display: inline-block;
  transition: transform .25s ease;
}
/* Always show CTA on the hero card; reveal on hover for siblings. */
.brand-category-mosaic[data-hero-id="1"] .brand-category-mosaic__card[data-card-id="1"] .brand-category-mosaic__cta,
.brand-category-mosaic[data-hero-id="2"] .brand-category-mosaic__card[data-card-id="2"] .brand-category-mosaic__cta,
.brand-category-mosaic[data-hero-id="3"] .brand-category-mosaic__card[data-card-id="3"] .brand-category-mosaic__cta,
.brand-category-mosaic[data-hero-id="4"] .brand-category-mosaic__card[data-card-id="4"] .brand-category-mosaic__cta,
.brand-category-mosaic__card:hover .brand-category-mosaic__cta,
