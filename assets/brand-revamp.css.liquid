  color: rgb(var(--brand-shadow));
  background: transparent;
  border: 1px solid rgba(var(--brand-shadow), .2);
  padding: 8px 14px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
