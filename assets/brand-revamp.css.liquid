/* ============================================================
   Brand Revamp 2026 — foundation layer.
   Brand-prefixed classes only. No global element overrides.
   Composes on Focal's existing settings tokens
   (--primary-button-background, --header-background, etc.)
   ============================================================ */

:root {
  /* Brand palette as RGB triplets, so they can be used with rgb() / rgba(). */
  --brand-emerald: 0, 156, 67;        /* #009C43 */
  --brand-shadow:  35, 58, 53;        /* #233A35 */
  --brand-glow:    165, 230, 198;     /* #A5E6C6 */
  --brand-neon:    104, 253, 0;       /* #68FD00 */
  --brand-black:   0, 0, 0;
  --brand-white:   255, 255, 255;

  /* Pattern asset URLs (Liquid-rendered to Shopify CDN). */
  --brand-grid-tile-white: url('{{ "pattern-grid-tile-white.svg" | asset_url }}');
  --brand-grid-tile-black: url('{{ "pattern-grid-tile-black.svg" | asset_url }}');

  /* Single Precision+ glyph (the actual brand mark, not the grid tile).
     Used for inline glyphs and ::before markers where the mark needs to be
     visible at small sizes. The grid tile is a 80x80 array of plus marks —
     wrong asset to mask down to a 12px box. */
  --brand-plus-glyph: url('{{ "precision-plus-white.svg" | asset_url }}');
}

/* ---------- Surfaces ---------- */

.brand-surface {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
}
.brand-surface--shadow { background: rgb(var(--brand-shadow)); color: rgb(var(--brand-white)); }
.brand-surface--emerald { background: rgb(var(--brand-emerald)); color: rgb(var(--brand-white)); }
.brand-surface--glow    { background: rgb(var(--brand-glow)); color: rgb(var(--brand-black)); }
.brand-surface--white   { background: rgb(var(--brand-white)); color: rgb(var(--brand-black)); }

/* Grid pattern overlay on dark surfaces (Precision+ marks repeating at 80px). */
.brand-surface--pattern {
  background-image: var(--brand-grid-tile-white);
  background-repeat: repeat;
  background-size: 80px 80px;
}
.brand-surface--white.brand-surface--pattern,
.brand-surface--glow.brand-surface--pattern {
  background-image: var(--brand-grid-tile-black);
}

/* When a surface has both a base color and the pattern, stack them. */
.brand-surface.brand-surface--pattern,
.brand-surface--shadow.brand-surface--pattern,
.brand-surface--emerald.brand-surface--pattern {
  background-color: inherit; /* preserve base color from non-pattern class */
}

/* ---------- Containers ---------- */

.brand-container {
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: clamp(16px, 4vw, 48px);
}

.brand-section { padding-block: clamp(48px, 8vw, 120px); }
.brand-section--tight { padding-block: clamp(24px, 4vw, 48px); }

/* ---------- Typography ---------- */
/* Crystal-stand-in until licensed font lands.
   Mixed-weight headlines via .brand-headline + .brand-headline__em. */

.brand-eyebrow {
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  font-size: 11px;
  letter-spacing: .18em;
  text-transform: uppercase;
  font-weight: 500;
  margin: 0 0 12px;
  opacity: .8;
}

.brand-headline {
  font-family: inherit;
  font-weight: 300;
  font-size: clamp(40px, 7.5vw, 112px);
  line-height: .96;
  letter-spacing: -.015em;
  margin: 0;
  text-wrap: balance;
}
.brand-headline__em {
  font-weight: 900;
  font-stretch: 75%;     /* engages variable-font condensed axis when available */
  letter-spacing: -.03em;
}

.brand-headline--display {
  font-weight: 900;
  font-stretch: 60%;
  font-size: clamp(80px, 18vw, 280px);
  line-height: .85;
  letter-spacing: -.04em;
  text-transform: uppercase;
}
.brand-headline--stroke {
  -webkit-text-stroke: 1.5px currentColor;
  color: transparent;
}

.brand-body {
  font-family: inherit;
  font-weight: 300;
  font-size: 16px;
  line-height: 1.55;
  max-width: 56ch;
  margin: 0;
}

/* ---------- Buttons ---------- */

.brand-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  padding: 16px 32px;
  font-family: inherit;
  font-weight: 700;
  font-size: 13px;
  letter-spacing: .12em;
  line-height: 1;
  text-transform: uppercase;
  text-decoration: none;
  border: 0;
  border-radius: 2px;
  cursor: pointer;
  transition: background-color .18s ease, color .18s ease, transform .15s ease;
  white-space: nowrap;
}
.brand-btn:hover { transform: translateY(-1px); }

.brand-btn--primary {
  background: rgb(var(--brand-emerald));
  color: rgb(var(--brand-white));
}
.brand-btn--primary:hover {
  background: rgb(var(--brand-neon));
  color: rgb(var(--brand-black));
}

.brand-btn--outline {
  background: transparent;
  color: rgb(var(--brand-white));
  box-shadow: inset 0 0 0 1.5px currentColor;
}
.brand-btn--outline:hover {
  background: rgb(var(--brand-white));
  color: rgb(var(--brand-black));
}

.brand-btn--ghost-dark {
  background: transparent;
  color: rgb(var(--brand-black));
  box-shadow: inset 0 0 0 1.5px currentColor;
}
.brand-btn--ghost-dark:hover {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
}

/* ---------- Marquee announcement bar ---------- */
/* The Glow Green strip above the header in the mockup. */

.brand-marquee {
  background: rgb(var(--brand-glow));
  color: rgb(var(--brand-black));
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 1.4;
  letter-spacing: .14em;
  text-transform: uppercase;
  font-weight: 500;
  overflow: hidden;
  position: relative;
  min-height: 36px;
  display: flex;
  align-items: center;
}
.brand-marquee__track {
  display: flex;
  gap: 64px;
  padding: 10px 0;
  white-space: nowrap;
  animation: brand-marquee-scroll 28s linear infinite;
  will-change: transform;
  flex: 1 1 auto;
}
.brand-marquee__item { display: inline-flex; align-items: center; gap: 64px; }
@keyframes brand-marquee-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
@media (prefers-reduced-motion: reduce) {
  .brand-marquee__track { animation: none; justify-content: center; }
}

/* ---------- Precision+ inline mark helper ---------- */

.brand-plus {
  display: inline-block;
  width: 1em;
  height: 1em;
  vertical-align: -0.12em;
  background-color: currentColor;
  mask: var(--brand-plus-glyph) no-repeat center / contain;
  -webkit-mask: var(--brand-plus-glyph) no-repeat center / contain;
}

/* ============================================================
   Header restyle (Phase 3 / task #5)
   Overrides Focal's .header__* classes without touching markup.
   Settings tokens (header_background, header_text_color) are
   already Black/White from the Phase 1 token pass.
   ============================================================ */

.shopify-section--header,
.shopify-section-group-header-group .header,
.header {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
  border-bottom: 1px solid rgba(var(--brand-white), .08);
}

/* Tighten desktop padding to match mockup compact feel. */
@media (min-width: 1000px) {
  .header__wrapper { padding-block: 14px; }
}

/* Nav links: uppercase, condensed, with Precision+ glyph prefix. */
.header__linklist-item > .header__linklist-link {
  display: inline-flex;
  align-items: center;
  gap: .45em;
  font-family: inherit;
  font-weight: 700;
  font-size: 12px;
  letter-spacing: .14em;
  text-transform: uppercase;
  font-stretch: 80%;
  color: rgb(var(--brand-white));
  text-decoration: none;
  padding-block: 8px;
  transition: color .15s ease;
}
.header__linklist-item > .header__linklist-link::before {
  content: "";
  width: 12px;
  height: 12px;
  background-color: rgb(var(--brand-emerald));
  mask: var(--brand-plus-glyph) no-repeat center / contain;
  -webkit-mask: var(--brand-plus-glyph) no-repeat center / contain;
  flex-shrink: 0;
  transition: background-color .15s ease, transform .2s ease;
}
.header__linklist-item > .header__linklist-link:hover {
  color: rgb(var(--brand-emerald));
}
.header__linklist-item > .header__linklist-link:hover::before {
  background-color: rgb(var(--brand-neon));
  transform: rotate(90deg);
}

/* Icons: white, Emerald on hover. */
.header .header__icon-wrapper,
.header__icon-wrapper svg { color: rgb(var(--brand-white)); }
.header .header__icon-wrapper:hover { color: rgb(var(--brand-emerald)); }

/* Cart count badge in Emerald. */
.header__cart-count {
  background: rgb(var(--brand-emerald)) !important;
  color: rgb(var(--brand-white)) !important;
  font-weight: 700;
}

/* Locale / country popover trigger buttons match dark canvas. */
.header__cross-border .popover-button {
  color: rgba(var(--brand-white), .8);
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  font-weight: 500;
}
.header__cross-border .popover-button:hover { color: rgb(var(--brand-white)); }

/* Dropdown menus: dark surface to match. */
.nav-dropdown {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
  border: 1px solid rgba(var(--brand-white), .1);
}
.nav-dropdown__link {
  color: rgba(var(--brand-white), .85);
  font-family: inherit;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.nav-dropdown__link:hover {
  color: rgb(var(--brand-emerald));
}

/* Mega menu (if a link triggers Focal's mega menu) — dark canvas. */
.mega-menu {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
  border-top: 1px solid rgba(var(--brand-white), .08);
}

/* Mobile drawer + nav. */
.drawer { background: rgb(var(--brand-black)); color: rgb(var(--brand-white)); }
.drawer__header,
.drawer__footer { border-color: rgba(var(--brand-white), .08); }

.mobile-nav__item { border-bottom: 1px solid rgba(var(--brand-white), .06); }
.mobile-nav__link {
  display: flex;
  align-items: center;
  gap: .6em;
  color: rgb(var(--brand-white));
  font-family: inherit;
  font-weight: 700;
  font-size: 18px;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding-block: 18px;
}
.mobile-nav__link::before {
  content: "";
  width: 16px;
  height: 16px;
  background-color: rgb(var(--brand-emerald));
  mask: var(--brand-plus-glyph) no-repeat center / contain;
  -webkit-mask: var(--brand-plus-glyph) no-repeat center / contain;
  flex-shrink: 0;
}

/* Transparent-header variant: don't fight the dark default — keep it black. */
.header--transparent { background: rgb(var(--brand-black)) !important; }

/* ============================================================
   Footer CTA section (Phase 3 / task #6)
   Standalone "Book a Call" panel above the main footer.
   ============================================================ */

.brand-footer-cta { padding-block: clamp(56px, 9vw, 120px); text-align: center; }
.brand-footer-cta__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
  max-width: 720px;
  margin-inline: auto;
}
.brand-footer-cta__heading {
  font-size: clamp(32px, 5vw, 64px);
  font-weight: 300;
  letter-spacing: -.015em;
}
.brand-footer-cta__body {
  opacity: .85;
  text-align: center;
  max-width: 56ch;
}
.brand-footer-cta__cta { margin-top: 8px; }

/* ============================================================
   Footer restyle (Phase 3 / task #6)
   Composes on settings token footer_background (now Shadow Green).
   ============================================================ */

.footer { color: rgb(var(--brand-white)); }
.footer__inner { padding-block: clamp(40px, 5vw, 72px); }

/* Block headings (e.g. "Shop", "Explore", "Follow"). */
.footer__item-content > .heading,
.footer__item-content h2 {
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  font-size: 11px;
  letter-spacing: .18em;
  text-transform: uppercase;
  font-weight: 500;
  opacity: .7;
  margin-bottom: 18px;
}

/* Footer link list items: condensed caps + Emerald Precision+ glyph prefix. */
.footer .linklist__item { padding-block: 4px; }
.footer .linklist__item a {
  display: inline-flex;
  align-items: center;
  gap: .55em;
  color: rgb(var(--brand-white));
  text-decoration: none;
  font-family: inherit;
  font-weight: 600;
  font-size: 14px;
  letter-spacing: .1em;
  text-transform: uppercase;
  font-stretch: 80%;
  transition: color .15s ease;
}
.footer .linklist__item a::before {
  content: "";
  width: 11px;
  height: 11px;
  flex-shrink: 0;
  background-color: rgb(var(--brand-emerald));
  mask: var(--brand-plus-glyph) no-repeat center / contain;
  -webkit-mask: var(--brand-plus-glyph) no-repeat center / contain;
  transition: background-color .15s ease;
}
.footer .linklist__item a:hover { color: rgb(var(--brand-emerald)); }
.footer .linklist__item a:hover::before { background-color: rgb(var(--brand-neon)); }

/* Newsletter form on dark canvas. */
.footer .input,
.footer input[type="email"] {
  background: transparent;
  color: rgb(var(--brand-white));
  border: 0;
  border-bottom: 1px solid rgba(var(--brand-white), .3);
  border-radius: 0;
  padding-inline: 0;
}
.footer .input::placeholder,
.footer input[type="email"]::placeholder { color: rgba(var(--brand-white), .55); }
.footer .input:focus,
.footer input[type="email"]:focus {
  outline: none;
  border-bottom-color: rgb(var(--brand-emerald));
}

/* Social icons row. */
.footer__follow-and-payment,
.footer__follow-on-shop {
  color: rgb(var(--brand-white));
}
.footer__follow-and-payment a,
.footer__follow-on-shop a {
  color: rgb(var(--brand-white));
  opacity: .85;
  transition: opacity .15s ease;
}
.footer__follow-and-payment a:hover,
.footer__follow-on-shop a:hover { opacity: 1; color: rgb(var(--brand-emerald)); }

/* Payment methods row: lighten over dark canvas. */
.footer .payment-methods-list { opacity: .7; }

/* Footer aside (copyright + locale selector). */
.footer__aside {
  border-top: 1px solid rgba(var(--brand-white), .08);
  padding-block: 24px;
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  font-size: 11px;
  letter-spacing: .14em;
  text-transform: uppercase;
  opacity: .7;
}
.footer__aside .popover-button {
  color: rgb(var(--brand-white));
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
}
