/* ============================================================
   Brand Revamp 2026 — foundation layer.
   Brand-prefixed classes only. No global element overrides.
   Composes on Focal's existing settings tokens
   (--primary-button-background, --header-background, etc.)
   ============================================================ */

@font-face {
  font-family: "Crystal";
  src: url('{{ "brand-crystal-light.ttf" | asset_url }}') format("truetype");
  font-weight: 300;
  font-style: normal;
  font-stretch: 100%;
  font-display: swap;
}
@font-face {
  font-family: "Crystal";
  src: url('{{ "brand-crystal-regular.ttf" | asset_url }}') format("truetype");
  font-weight: 400;
  font-style: normal;
  font-stretch: 100%;
  font-display: swap;
}
@font-face {
  font-family: "Crystal";
  src: url('{{ "brand-crystal-semibold.ttf" | asset_url }}') format("truetype");
  font-weight: 600;
  font-style: normal;
  font-stretch: 100%;
  font-display: swap;
}
@font-face {
  font-family: "Crystal Ultra Condensed";
  src: url('{{ "brand-crystal-ultra-condensed-semibold.ttf" | asset_url }}') format("truetype");
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Miracle Mono";
  src: url('{{ "brand-miracle-mono-regular.otf" | asset_url }}') format("opentype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

:root {
  /* Brand palette as RGB triplets, so they can be used with rgb() / rgba(). */
  --brand-emerald: 0, 156, 67;        /* #009C43 */
  --brand-shadow:  35, 58, 53;        /* #233A35 */
  --brand-glow:    165, 230, 198;     /* #A5E6C6 */
  --brand-neon:    104, 253, 0;       /* #68FD00 */
  --brand-black:   0, 0, 0;
  --brand-white:   255, 255, 255;

  /* Pattern asset URLs (Liquid-rendered to Shopify CDN). */
  --brand-grid-tile-white: url('{{ "pattern-grid-tile-white.svg" | asset_url }}');
  --brand-grid-tile-black: url('{{ "pattern-grid-tile-black.svg" | asset_url }}');

  /* Full-bleed 1920x1080 grid and gradient backdrops from the brand toolkit.
     These are used by .brand-surface--gradient and .brand-surface--grid-full
     utilities below — different from the small repeating tiles above.
     Source: TheNetReturn/UPDATED Net Return Toolkit/PATTERN/. */
  --brand-grid-black:           url('{{ "pattern-grid-black.svg" | asset_url }}');
  --brand-grid-shadow:          url('{{ "pattern-grid-shadow-green.svg" | asset_url }}');
  --brand-grid-glow:            url('{{ "pattern-grid-glow-green.svg" | asset_url }}');
  --brand-grid-emerald:         url('{{ "pattern-grid-emerald-green.svg" | asset_url }}');
  --brand-grid-white-full:      url('{{ "pattern-grid-white.svg" | asset_url }}');

  --brand-gradient-black:       url('{{ "pattern-gradient-black.svg" | asset_url }}');
  --brand-gradient-shadow:      url('{{ "pattern-gradient-shadow-green.svg" | asset_url }}');
  --brand-gradient-emerald:     url('{{ "pattern-gradient-emerald-green.svg" | asset_url }}');
  --brand-gradient-glow:        url('{{ "pattern-gradient-glow-green.svg" | asset_url }}');
  --brand-gradient-clear-grey:  url('{{ "pattern-gradient-clear-grey.svg" | asset_url }}');
  --brand-gradient-clear-white: url('{{ "pattern-gradient-clear-white.svg" | asset_url }}');

  /* Single Precision+ glyph (the actual brand mark, not the grid tile).
     Used for inline glyphs and ::before markers where the mark needs to be
     visible at small sizes. The grid tile is a 80x80 array of plus marks —
     wrong asset to mask down to a 12px box. */
  --brand-plus-glyph: url('{{ "precision-plus-white.svg" | asset_url }}');

  --brand-font-sans-fallback: Arial, Helvetica, sans-serif;
  --brand-font-body: "Crystal", var(--brand-font-sans-fallback);
  --brand-font-heading: "Crystal", var(--brand-font-sans-fallback);
  --brand-font-display: "Crystal Ultra Condensed", "Crystal", var(--brand-font-sans-fallback);
  --brand-font-accent: "Miracle Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --brand-font-mono: var(--brand-font-accent);

  --text-font-family: var(--brand-font-body);
  --text-font-weight: 400;
  --text-font-style: normal;
  --text-font-bold-weight: 600;
  --heading-font-family: var(--brand-font-heading);
  --heading-font-weight: 600;
  --heading-font-style: normal;
}

/* ---------- Surfaces ---------- */

.brand-surface {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
}
.brand-surface--shadow { background: rgb(var(--brand-shadow)); color: rgb(var(--brand-white)); }
.brand-surface--emerald { background: rgb(var(--brand-emerald)); color: rgb(var(--brand-white)); }
.brand-surface--glow    { background: rgb(var(--brand-glow)); color: rgb(var(--brand-black)); }
.brand-surface--white   { background: rgb(var(--brand-white)); color: rgb(var(--brand-black)); }

/* Grid pattern overlay on dark surfaces (Precision+ marks repeating at 80px). */
.brand-surface--pattern {
  background-image: var(--brand-grid-tile-white);
  background-repeat: repeat;
  background-size: 80px 80px;
}
.brand-surface--white.brand-surface--pattern,
.brand-surface--glow.brand-surface--pattern {
  background-image: var(--brand-grid-tile-black);
}

/* ---------- Full-bleed gradient backdrop utilities ----------
   Apply by composing classes:
     .brand-surface--gradient .brand-surface--gradient--shadow
   These use the 1920x1080 toolkit gradient SVGs at background-size: cover so the
   section reads as a single rich gradient panel — not a tiling pattern. Pair with
   the existing .brand-surface--shadow / --emerald / --glow surfaces if the section
   needs a solid base color underneath while images load. */
.brand-surface--gradient {
  background-color: rgb(var(--brand-black));
  background-image: var(--brand-gradient-black);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  color: rgb(var(--brand-white));
}
.brand-surface--gradient.brand-surface--gradient--shadow {
  background-color: rgb(var(--brand-shadow));
  background-image: var(--brand-gradient-shadow);
}
.brand-surface--gradient.brand-surface--gradient--emerald {
  background-color: rgb(var(--brand-emerald));
  background-image: var(--brand-gradient-emerald);
}
.brand-surface--gradient.brand-surface--gradient--glow {
  background-color: rgb(var(--brand-glow));
  background-image: var(--brand-gradient-glow);
  color: rgb(var(--brand-black));
}
.brand-surface--gradient.brand-surface--gradient--clear-grey {
  background-color: rgb(var(--brand-white));
  background-image: var(--brand-gradient-clear-grey);
  color: rgb(var(--brand-black));
}
.brand-surface--gradient.brand-surface--gradient--clear-white {
  background-color: rgb(var(--brand-white));
  background-image: var(--brand-gradient-clear-white);
  color: rgb(var(--brand-black));
}

/* Slow ambient drift on full-bleed gradient surfaces. Heat-shimmer over a
   driving range, not a marketing flourish. 60s linear loop, opt-in via
   .brand-surface--gradient--drift. Disabled under reduced-motion. */
.brand-surface--gradient--drift {
  position: relative;
  isolation: isolate;
  overflow: hidden;
}
.brand-surface--gradient--drift::before {
  content: "";
  position: absolute;
  inset: -8% -8%;
  z-index: -1;
  background-image: inherit;
  background-size: 120% 120%;
  background-position: center;
  background-repeat: no-repeat;
  animation: brand-gradient-drift 60s linear infinite;
  will-change: transform;
  pointer-events: none;
}
@keyframes brand-gradient-drift {
  0%   { transform: translate3d(0, 0, 0) scale(1); }
  50%  { transform: translate3d(-2%, 1.5%, 0) scale(1.04); }
  100% { transform: translate3d(0, 0, 0) scale(1); }
}
@media (prefers-reduced-motion: reduce) {
  .brand-surface--gradient--drift::before { animation: none; }
}

/* ---------- Containers ---------- */

.brand-container {
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: clamp(16px, 4vw, 48px);
}

.brand-section { padding-block: clamp(48px, 8vw, 120px); }
.brand-section--tight { padding-block: clamp(24px, 4vw, 48px); }

/* ---------- Typography ---------- */
/* Brand guide mapping: Crystal for body/headings, Ultra Condensed for display, Miracle Mono for small accents. */

.heading,
.h2,
.h3,
.h5,
.h6 {
  font-family: var(--brand-font-heading);
  font-weight: 600;
  font-style: normal;
  letter-spacing: 0;
}

.heading--large,
.h1 {
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-style: normal;
  letter-spacing: 0;
}

.heading--xsmall,
.heading--small,
.text--xsmall,
.input__label,
.product-item__label-list,
.product-item__quick-buy-button,
.popover-button,
.button:not(.brand-btn) {
  font-family: var(--brand-font-accent);
  font-weight: 400;
}

.brand-eyebrow {
  font-family: var(--brand-font-accent);
  font-size: 11px;
  letter-spacing: .18em;
  text-transform: uppercase;
  font-weight: 400;
  margin: 0 0 12px;
  opacity: .8;
}

.brand-headline {
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(40px, 7.5vw, 112px);
  line-height: .96;
  letter-spacing: 0;
  margin: 0;
  text-wrap: balance;
}
.brand-headline__em {
  font-weight: 600;
  letter-spacing: 0;
}

.brand-headline--display {
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(80px, 18vw, 280px);
  line-height: .85;
  letter-spacing: 0;
  text-transform: uppercase;
}
.brand-headline--stroke {
  -webkit-text-stroke: 1.5px currentColor;
  color: transparent;
}

.brand-body {
  font-family: var(--brand-font-body);
  font-weight: 400;
  font-size: 16px;
  line-height: 1.55;
  max-width: 56ch;
  margin: 0;
}

/* ---------- Buttons ---------- */

.brand-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  padding: 16px 32px;
  font-family: var(--brand-font-accent);
  font-weight: 400;
  font-size: 13px;
  letter-spacing: .12em;
  line-height: 1;
  text-transform: uppercase;
  text-decoration: none;
  border: 0;
  border-radius: 2px;
  cursor: pointer;
  transition: background-color .18s ease, color .18s ease, transform .15s ease;
  white-space: nowrap;
}
.brand-btn:hover { transform: translateY(-1px); }

.brand-btn--primary {
  background: rgb(var(--brand-emerald));
  color: rgb(var(--brand-white));
}
.brand-btn--primary:hover {
  background: rgb(var(--brand-neon));
  color: rgb(var(--brand-black));
}

.brand-btn--outline {
  background: transparent;
  color: rgb(var(--brand-white));
  box-shadow: inset 0 0 0 1.5px currentColor;
}
.brand-btn--outline:hover {
  background: rgb(var(--brand-white));
  color: rgb(var(--brand-black));
}

.brand-btn--ghost-dark {
  background: transparent;
  color: rgb(var(--brand-black));
  box-shadow: inset 0 0 0 1.5px currentColor;
}
.brand-btn--ghost-dark:hover {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
}

/* ---------- Marquee announcement bar ---------- */
/* The Glow Green strip above the header in the mockup. */

.brand-marquee {
  background: rgb(var(--brand-glow));
  color: rgb(var(--brand-black));
  font-family: var(--brand-font-accent);
  font-size: 12px;
  line-height: 1.4;
  letter-spacing: .14em;
  text-transform: uppercase;
  font-weight: 400;
  overflow: hidden;
  position: relative;
  min-height: 36px;
  display: flex;
  align-items: center;
}
.brand-marquee__track {
  display: flex;
  padding: 10px 0;
  white-space: nowrap;
  animation: brand-marquee-scroll 28s linear infinite;
  will-change: transform;
  flex: 1 1 auto;
}
.brand-marquee__item {
  display: inline-flex;
  align-items: center;
  gap: 64px;
  padding-right: 64px;
}
@keyframes brand-marquee-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
@media (prefers-reduced-motion: reduce) {
  .brand-marquee__track { animation: none; justify-content: center; white-space: normal; }
  .brand-marquee__item { flex-wrap: wrap; justify-content: center; padding-right: 0; }
  .brand-marquee__item[aria-hidden="true"] { display: none; }
}

/* ---------- Precision+ inline mark helper ---------- */

.brand-plus {
  display: inline-block;
  width: 1em;
  height: 1em;
  vertical-align: -0.12em;
  background-color: currentColor;
  mask: var(--brand-plus-glyph) no-repeat center / contain;
  -webkit-mask: var(--brand-plus-glyph) no-repeat center / contain;
}

/* ============================================================
   Brand hero (Phase 3 / task #7)
   Full-bleed Train With Intent homepage lead.
   ============================================================ */

.brand-hero {
  position: relative;
  color: rgb(var(--brand-white));
  background: rgb(var(--brand-black));
  overflow: hidden;
  isolation: isolate;
  margin-top: 0;
}
.brand-hero--full { min-height: clamp(560px, 92vh, 920px); }
.brand-hero--large { min-height: clamp(480px, 75vh, 760px); }
.brand-hero--medium { min-height: clamp(380px, 60vh, 600px); }

.brand-hero__image {
  position: absolute;
  inset: 0;
  z-index: -2;
  display: block;
}
.brand-hero__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.brand-hero__video {
  position: absolute;
  inset: 0;
  z-index: -2;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  /* Slight scale hides any 1px letterbox edges from H.264 sources. */
  transform: scale(1.001);
  background: rgb(var(--brand-black));
}
.brand-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(
      to top,
      rgba(0, 0, 0, var(--brand-hero-overlay, .55)) 0%,
      rgba(0, 0, 0, var(--brand-hero-overlay-mid, .3)) 45%,
      rgba(0, 0, 0, var(--brand-hero-overlay-top, .15)) 100%
    );
}
.brand-hero__content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  min-height: inherit;
  padding-block: 88px;
  gap: 20px;
  max-width: 1440px;
}
.brand-hero__eyebrow { margin: 0; }
.brand-hero__heading {
  max-width: 18ch;
  font-size: 112px;
  line-height: .9;
  letter-spacing: 0;
}
.brand-hero__heading .brand-headline__em { display: inline-block; }
.brand-hero__body {
  max-width: 48ch;
  opacity: .92;
}
.brand-hero__actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 8px;
}

@media (max-width: 1199px) {
  .brand-hero__heading { font-size: 84px; }
}
@media (max-width: 749px) {
  .brand-hero--full { min-height: 640px; }
  .brand-hero__content {
    padding-inline: 20px;
    padding-block: 40px;
  }
  .brand-hero__heading {
    max-width: 11ch;
    font-size: 52px;
  }
  .brand-hero__actions {
    width: 100%;
    align-items: stretch;
  }
  .brand-hero__cta { flex: 1 1 100%; }
}

/* ============================================================
   Header restyle (Phase 3 / task #5)
   Overrides Focal's .header__* classes without touching markup.
   Settings tokens (header_background, header_text_color) are
   already Black/White from the Phase 1 token pass.
   ============================================================ */

.shopify-section--header .header,
.shopify-section-group-header-group .header,
#shopify-section-header .header {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
  border-bottom: 1px solid rgba(var(--brand-white), .08);
}

/* Luxury breathing room — generous desktop padding, larger inter-item gap. */
@media (min-width: 1000px) {
  .header__wrapper { padding-block: clamp(20px, 1.6vw, 30px); }
  .header__linklist { gap: clamp(20px, 2.4vw, 44px); }
}

/* Hide the in-header locale/country popover — footer aside already carries it,
   keeps the dark header bar uncluttered. */
.shopify-section-group-header-group .header__cross-border { display: none; }

/* Nav links: mono accents with Precision+ glyph prefix. Wider letter-spacing
   reads more editorial / less utilitarian. */
.header__linklist-item > .header__linklist-link {
  display: inline-flex;
  align-items: center;
  gap: .55em;
  font-family: var(--brand-font-accent);
  font-weight: 400;
  font-size: 12px;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: rgb(var(--brand-white));
  text-decoration: none;
  padding-block: 10px;
  transition: color .15s ease;
}
.header__linklist-item > .header__linklist-link::before {
  content: "";
  width: 12px;
  height: 12px;
  background-color: rgb(var(--brand-emerald));
  mask: var(--brand-plus-glyph) no-repeat center / contain;
  -webkit-mask: var(--brand-plus-glyph) no-repeat center / contain;
  flex-shrink: 0;
  transition: background-color .15s ease, transform .2s ease;
}
.header__linklist-item > .header__linklist-link:hover {
  color: rgb(var(--brand-emerald));
}
.header__linklist-item > .header__linklist-link:hover::before {
  background-color: rgb(var(--brand-neon));
  transform: rotate(90deg);
}

/* Icons: white, Emerald on hover. */
.header .header__icon-wrapper,
.header__icon-wrapper svg { color: rgb(var(--brand-white)); }
.header .header__icon-wrapper:hover { color: rgb(var(--brand-emerald)); }

/* Cart count badge in Emerald. */
.header__cart-count {
  background: rgb(var(--brand-emerald)) !important;
  color: rgb(var(--brand-white)) !important;
  font-weight: 600;
}

/* Locale / country popover trigger buttons match dark canvas. */
.header__cross-border .popover-button {
  color: rgba(var(--brand-white), .8);
  font-family: var(--brand-font-accent);
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  font-weight: 400;
}
.header__cross-border .popover-button:hover { color: rgb(var(--brand-white)); }

/* Dropdown menus: dark surface to match. */
.shopify-section-group-header-group .nav-dropdown,
#shopify-section-header .nav-dropdown {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
  border: 1px solid rgba(var(--brand-white), .1);
}
.shopify-section-group-header-group .nav-dropdown__link,
#shopify-section-header .nav-dropdown__link {
  color: rgba(var(--brand-white), .85);
  font-family: var(--brand-font-accent);
  font-weight: 400;
  font-size: 13px;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.shopify-section-group-header-group .nav-dropdown__link:hover,
#shopify-section-header .nav-dropdown__link:hover {
  color: rgb(var(--brand-emerald));
}

/* Mega menu (if a link triggers Focal's mega menu) — dark canvas. */
.shopify-section-group-header-group .mega-menu,
#shopify-section-header .mega-menu {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
  border-top: 1px solid rgba(var(--brand-white), .08);
}

/* ============================================================
   Brand mega-menu (Concept C)
   Featured product card + featured collection card + small nav grid.
   Opt-in via the mega_menu block's "Use brand mega-menu layout" toggle.
   ============================================================ */

.mega-menu.mega-menu--brand {
  padding: 0;
}
.mega-menu--brand__grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1.2fr;
  min-height: 480px;
}
.mega-menu--brand__card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 32px;
  overflow: hidden;
  isolation: isolate;
  color: rgb(var(--brand-white));
  text-decoration: none;
  border-right: 1px solid rgba(var(--brand-white), .05);
}
.mega-menu--brand__card-image {
  position: absolute;
  inset: 0;
  z-index: -2;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform .4s ease;
}
.mega-menu--brand__card::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(0deg, rgba(0,0,0,.85) 0%, rgba(0,0,0,.2) 60%, rgba(0,0,0,0) 100%);
}
.mega-menu--brand__card:hover .mega-menu--brand__card-image { transform: scale(1.04); }
.mega-menu--brand__card-body {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-width: 32ch;
}
.mega-menu--brand__card-eyebrow {
  margin: 0;
  font-family: var(--brand-font-accent);
  font-size: 11px;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: rgb(var(--brand-glow));
}
.mega-menu--brand__card-title {
  margin: 0;
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(28px, 2.4vw, 38px);
  line-height: 1;
  letter-spacing: -.01em;
  text-transform: uppercase;
}
.mega-menu--brand__card-meta {
  margin: 4px 0 14px;
  font-family: var(--brand-font-body);
  font-size: 15px;
  color: rgba(var(--brand-white), .82);
}
.mega-menu--brand__card-cta { align-self: flex-start; }

.mega-menu--brand__nav {
  padding: 48px 56px;
  background: rgb(var(--brand-black));
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px 40px;
  align-content: start;
}
.mega-menu--brand__nav-eyebrow {
  display: block;
  font-family: var(--brand-font-accent);
  font-size: 11px;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: rgba(var(--brand-white), .5);
  margin-bottom: 14px;
  text-decoration: none;
}
a.mega-menu--brand__nav-eyebrow:hover { color: rgb(var(--brand-glow)); }
.mega-menu--brand__nav-links {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.mega-menu--brand__nav-links a {
  font-family: var(--brand-font-body);
  font-weight: 400;
  font-size: 17px;
  letter-spacing: 0;
  color: rgb(var(--brand-white));
  text-decoration: none;
  transition: color .15s ease;
}
.mega-menu--brand__nav-links a:hover { color: rgb(var(--brand-glow)); }

@media (max-width: 1199px) {
  .mega-menu--brand__grid { grid-template-columns: 1fr 1fr 1fr; }
}
@media (max-width: 999px) {
  .mega-menu--brand__grid { grid-template-columns: 1fr; min-height: auto; }
  .mega-menu--brand__card { min-height: 240px; }
  .mega-menu--brand__nav { padding: 32px 24px; grid-template-columns: 1fr 1fr; }
}

/* Mobile navigation drawer only. Product, filter, cart, and search drawers keep their own Focal styling. */
#mobile-menu-drawer.drawer { background: rgb(var(--brand-black)); color: rgb(var(--brand-white)); }
#mobile-menu-drawer .drawer__header,
#mobile-menu-drawer .drawer__footer { border-color: rgba(var(--brand-white), .08); }

.mobile-nav__item { border-bottom: 1px solid rgba(var(--brand-white), .06); }
.mobile-nav__link {
  display: flex;
  align-items: center;
  gap: .6em;
  color: rgb(var(--brand-white));
  font-family: var(--brand-font-accent);
  font-weight: 400;
  font-size: 18px;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding-block: 18px;
}
.mobile-nav__link::before {
  content: "";
  width: 16px;
  height: 16px;
  background-color: rgb(var(--brand-emerald));
  mask: var(--brand-plus-glyph) no-repeat center / contain;
  -webkit-mask: var(--brand-plus-glyph) no-repeat center / contain;
  flex-shrink: 0;
}

/* Transparent-header variant: don't fight the dark default — keep it black. */
.header--transparent { background: rgb(var(--brand-black)) !important; }

/* ============================================================
   Category grid section (Phase 4 / task #8)
   Four-card grid (Nets / Packages / Simulation / Accessories)
   that sits under the hero. Dark canvas; each card a photo with
   an Emerald Precision+ glyph + display caps label.
   ============================================================ */

.brand-category-grid {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
  padding-block: clamp(48px, 6vw, 96px);
}
.brand-category-grid__header {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: clamp(24px, 3vw, 40px);
}
.brand-category-grid__heading {
  font-family: var(--brand-font-heading);
  font-size: clamp(28px, 3.5vw, 44px);
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1;
}
.brand-category-grid__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(var(--brand-category-cols, 4), 1fr);
  gap: clamp(12px, 1.5vw, 20px);
}
@media (max-width: 999px) {
  .brand-category-grid__list { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 540px) {
  .brand-category-grid__list { grid-template-columns: 1fr; }
}

.brand-category-card {
  position: relative;
  display: block;
  /* 4:5 portrait — gives the 3:2 source photos ~17% breathing room vs.
     the old 3:4 (which cropped ~50% of each image). */
  aspect-ratio: 4 / 5;
  overflow: hidden;
  text-decoration: none;
  color: rgb(var(--brand-white));
  background: rgb(var(--brand-shadow));
  isolation: isolate;

  /* Reveal animation start state — JS adds .is-revealed on viewport entry. */
  opacity: 0;
  transform: translateY(36px);
  transition:
    opacity .9s cubic-bezier(.2, .7, .2, 1),
    transform .9s cubic-bezier(.2, .7, .2, 1);
  /* Stagger via inline custom property set per-card in Liquid. */
  transition-delay: calc(var(--brand-card-index, 0) * 80ms);
}
.brand-category-card.is-revealed {
  opacity: 1;
  transform: none;
}

/* Image lives inside a frame element so we can both parallax-shift it
   and (in the framed variant) inset it from the card edge. */
.brand-category-card__frame {
  position: absolute;
  inset: 0;
  z-index: -2;
  overflow: hidden;
  transition: inset .4s cubic-bezier(.2, .7, .2, 1);
}

.brand-category-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  /* Baseline upscale gives parallax somewhere to travel without exposing
     edges. On browsers without scroll-driven animation support this just
     looks like a small zoom — no regression. */
  transform: scale(1.08);
  transition: transform .6s ease;
  will-change: transform;
}

/* Image parallax — pure CSS scroll-driven animation, only fires on browsers
   that support `animation-timeline: view()` (Chrome/Edge 115+, Safari 26+).
   The image drifts down ~6% as the card travels through the viewport.
   Browsers without support stay at the static `scale(1.08)` baseline. */
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .brand-category-card__image {
      animation: brand-category-parallax linear both;
      animation-timeline: view();
      animation-range: cover 0% cover 100%;
    }
  }
  @keyframes brand-category-parallax {
    from { transform: scale(1.12) translateY(-3%); }
    to   { transform: scale(1.12) translateY(3%); }
  }
}

.brand-category-card::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(
    to top,
    rgba(0,0,0,.7) 0%,
    rgba(0,0,0,.2) 55%,
    rgba(0,0,0,0)   100%
  );
  transition: inset .4s cubic-bezier(.2, .7, .2, 1);
}
/* Hover: subtle additional push so the parallax baseline doesn't fight the
   merchant's existing "lift on hover" mental model. */
.brand-category-card:hover .brand-category-card__image { transform: scale(1.14); }
.brand-category-card:focus-visible {
  outline: 2px solid rgb(var(--brand-emerald));
  outline-offset: 4px;
}
.brand-category-card__inner {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  height: 100%;
  padding: clamp(16px, 2vw, 24px);
  gap: 8px;
}

/* Reduced-motion: skip the staggered reveal, skip parallax baseline scale. */
@media (prefers-reduced-motion: reduce) {
  .brand-category-card {
    opacity: 1;
    transform: none;
    transition: none;
  }
  .brand-category-card__image {
    transform: scale(1.02);
    transition: none;
  }
  .brand-category-card:hover .brand-category-card__image { transform: scale(1.02); }
}

/* ---------- Framed variant ----------
   Photo floats inside a Shadow Green frame with the label sitting on the
   colored panel below it instead of over the photo. Opt-in by adding
   .brand-category-grid--framed to the section wrapper. */
.brand-category-grid--framed .brand-category-card {
  background: rgb(var(--brand-shadow));
}
.brand-category-grid--framed .brand-category-card__frame {
  /* Inset on all sides, but leave more room at the bottom for the label
     to live on the colored panel below the photo. */
  inset: 12px 12px 32% 12px;
}
.brand-category-grid--framed .brand-category-card::after {
  /* Match the photo's new inset so the gradient hugs the frame, not the
     whole card. The bottom of the photo gets a stronger fade since the
     label no longer sits on it. */
  inset: 12px 12px 32% 12px;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, .35) 0%,
    rgba(0, 0, 0, 0) 60%
  );
}
.brand-category-grid--framed .brand-category-card__inner {
  /* Push label/cta into the colored panel band at the bottom of the card. */
  padding: clamp(14px, 1.6vw, 22px) clamp(16px, 2vw, 24px);
}
.brand-category-grid--framed .brand-category-card__label {
  color: rgb(var(--brand-white));
}
.brand-category-grid--framed .brand-category-card__cta {
  color: rgba(var(--brand-white), .75);
}
.brand-category-card__label {
  display: inline-flex;
  align-items: center;
  gap: .5em;
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(22px, 2.6vw, 36px);
  letter-spacing: 0;
  text-transform: uppercase;
  line-height: 1;
  margin: 0;
}
.brand-category-card__label::before {
  content: "";
  width: .7em;
  height: .7em;
  background-color: rgb(var(--brand-emerald));
  mask: var(--brand-plus-glyph) no-repeat center / contain;
  -webkit-mask: var(--brand-plus-glyph) no-repeat center / contain;
  flex-shrink: 0;
  transition: background-color .15s ease;
}
.brand-category-card:hover .brand-category-card__label::before {
  background-color: rgb(var(--brand-neon));
}
.brand-category-card__cta {
  display: inline-flex;
  align-items: center;
  gap: .4em;
  font-family: var(--brand-font-accent);
  font-size: 11px;
  letter-spacing: .18em;
  text-transform: uppercase;
  font-weight: 400;
  opacity: .85;
}
.brand-category-card__cta::after { content: "→"; transition: transform .2s ease; }
.brand-category-card:hover .brand-category-card__cta::after { transform: translateX(4px); }

/* ============================================================
   Product story section (Phase 4 / task #9)
   White Precision+ editorial band: "Don't Settle For Less".
   ============================================================ */

.brand-product-story {
  position: relative;
  overflow: hidden;
  background: rgb(var(--brand-white));
  color: rgb(var(--brand-black));
  isolation: isolate;
}
.brand-product-story::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background-image: var(--brand-grid-tile-black);
  background-size: 80px 80px;
  background-repeat: repeat;
  opacity: .08;
  pointer-events: none;
}
.brand-product-story__inner {
  min-height: clamp(620px, 72vw, 860px);
  display: grid;
  grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
  align-items: center;
  gap: clamp(28px, 5vw, 92px);
  padding-block: clamp(64px, 8vw, 128px);
}
.brand-product-story__copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: clamp(20px, 2vw, 28px);
  max-width: 560px;
}
.brand-product-story__heading {
  display: flex;
  flex-direction: column;
  margin: 0;
  color: rgb(var(--brand-emerald));
  font-family: var(--brand-font-display);
  font-size: clamp(76px, 10vw, 176px);
  font-weight: 600;
  line-height: .8;
  letter-spacing: 0;
  text-transform: uppercase;
}
.brand-product-story__heading-outline {
  color: transparent;
  -webkit-text-stroke: 1.5px rgba(var(--brand-emerald), .42);
}
.brand-product-story__body {
  max-width: 38ch;
  margin: 0;
  color: rgba(var(--brand-black), .78);
  font-family: var(--brand-font-body);
  font-size: clamp(16px, 1.2vw, 19px);
  font-weight: 400;
  line-height: 1.65;
}
.brand-product-story__cta {
  width: min(100%, 520px);
  min-height: 64px;
}
.brand-product-story__media {
  position: relative;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  min-height: 420px;
}
.brand-product-story__image {
  width: min(100%, 760px);
  max-height: 680px;
  object-fit: contain;
  filter: drop-shadow(0 32px 42px rgba(var(--brand-black), .18));
}

@media (max-width: 999px) {
  .brand-product-story__inner {
    grid-template-columns: 1fr;
    min-height: auto;
    gap: 36px;
  }
  .brand-product-story__copy {
    max-width: 100%;
  }
  .brand-product-story__media {
    justify-content: center;
    min-height: 320px;
  }
  .brand-product-story__image {
    width: min(100%, 620px);
    max-height: 520px;
  }
}

@media (max-width: 749px) {
  .brand-product-story__inner {
    padding-inline: 20px;
    padding-block: 56px 68px;
  }
  .brand-product-story__heading {
    font-size: clamp(72px, 21vw, 116px);
  }
  .brand-product-story__body {
    max-width: 31ch;
  }
  .brand-product-story__cta {
    width: 100%;
  }
}

/* ============================================================
   Bryson feature panel (Phase 4 / task #10)
   Full-bleed dark surface with an outlined display word ("BRYSON")
   layered behind the copy. Reuses the brand guide outline-stroke
   display treatment (same as "For less" in product story, but on a
   dark canvas so the stroke is white instead of Emerald).
   ============================================================ */

.brand-bryson-feature {
  position: relative;
  overflow: hidden;
  isolation: isolate;
  color: rgb(var(--brand-white));
  background: rgb(var(--brand-black));
  min-height: clamp(560px, 78vh, 820px);
  display: flex;
  align-items: center;
}
.brand-bryson-feature__image {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.brand-bryson-feature__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.brand-bryson-feature--image-right .brand-bryson-feature__image img { object-position: right center; }
.brand-bryson-feature--image-left .brand-bryson-feature__image img { object-position: left center; }
.brand-bryson-feature--image-full .brand-bryson-feature__image img { object-position: center; }

.brand-bryson-feature__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(90deg,
      rgba(var(--brand-black), calc(var(--brand-bryson-overlay) + .35)) 0%,
      rgba(var(--brand-black), var(--brand-bryson-overlay)) 55%,
      rgba(var(--brand-black), calc(var(--brand-bryson-overlay) - .15)) 100%);
}
.brand-bryson-feature--image-left .brand-bryson-feature__overlay {
  background:
    linear-gradient(270deg,
      rgba(var(--brand-black), calc(var(--brand-bryson-overlay) + .35)) 0%,
      rgba(var(--brand-black), var(--brand-bryson-overlay)) 55%,
      rgba(var(--brand-black), calc(var(--brand-bryson-overlay) - .15)) 100%);
}
.brand-bryson-feature--image-full .brand-bryson-feature__overlay {
  background:
    linear-gradient(180deg,
      rgba(var(--brand-black), calc(var(--brand-bryson-overlay) - .1)) 0%,
      rgba(var(--brand-black), calc(var(--brand-bryson-overlay) + .25)) 100%);
}

.brand-bryson-feature__display {
  position: absolute;
  z-index: 2;
  inset-inline: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(120px, 22vw, 360px);
  line-height: .85;
  letter-spacing: -.02em;
  text-transform: uppercase;
  color: transparent;
  -webkit-text-stroke: 2px rgba(var(--brand-white), .55);
  pointer-events: none;
  white-space: nowrap;
  user-select: none;
}

.brand-bryson-feature__inner {
  position: relative;
  z-index: 3;
  width: 100%;
}
.brand-bryson-feature__copy {
  max-width: 480px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.brand-bryson-feature--image-left .brand-bryson-feature__copy { margin-inline-start: auto; }
.brand-bryson-feature--image-full .brand-bryson-feature__copy {
  margin: 0 auto;
  text-align: center;
  align-items: center;
  max-width: 640px;
}
.brand-bryson-feature__eyebrow { margin: 0; }
.brand-bryson-feature__tagline {
  margin: 0;
  font-size: clamp(32px, 4vw, 56px);
  line-height: 1.05;
  letter-spacing: -.01em;
}
.brand-bryson-feature__body { margin: 0; max-width: 36ch; opacity: .92; }
.brand-bryson-feature--image-full .brand-bryson-feature__body { margin-inline: auto; }
.brand-bryson-feature__cta { align-self: flex-start; }
.brand-bryson-feature--image-full .brand-bryson-feature__cta { align-self: center; }

@media (max-width: 749px) {
  .brand-bryson-feature {
    min-height: clamp(540px, 90vh, 760px);
    align-items: flex-end;
    padding-block: 40px;
  }
  .brand-bryson-feature__overlay,
  .brand-bryson-feature--image-right .brand-bryson-feature__overlay,
  .brand-bryson-feature--image-left .brand-bryson-feature__overlay {
    background:
      linear-gradient(180deg,
        rgba(var(--brand-black), .15) 0%,
        rgba(var(--brand-black), calc(var(--brand-bryson-overlay) + .35)) 60%,
        rgba(var(--brand-black), calc(var(--brand-bryson-overlay) + .6)) 100%);
  }
  .brand-bryson-feature__display {
    top: auto;
    bottom: 38%;
    transform: none;
    font-size: clamp(96px, 32vw, 220px);
  }
  .brand-bryson-feature__copy {
    max-width: none;
    text-align: left;
  }
  .brand-bryson-feature__cta { align-self: stretch; text-align: center; }
}

/* ============================================================
   Footer CTA section (Phase 3 / task #6)
   Standalone "Book a Call" panel above the main footer.
   ============================================================ */

.brand-footer-cta { padding-block: clamp(56px, 9vw, 120px); text-align: center; }
.brand-footer-cta__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
  max-width: 720px;
  margin-inline: auto;
}
.brand-footer-cta__heading {
  font-size: clamp(32px, 5vw, 64px);
  font-weight: 600;
  letter-spacing: 0;
}
.brand-footer-cta__body {
  opacity: .85;
  text-align: center;
  max-width: 56ch;
}
.brand-footer-cta__cta { margin-top: 8px; }

/* ============================================================
   Footer restyle (Phase 3 / task #6)
   Composes on settings token footer_background (now Shadow Green).
   ============================================================ */

.footer { color: rgb(var(--brand-white)); }
.footer__inner { padding-block: clamp(40px, 5vw, 72px); }

/* Block headings (e.g. "Shop", "Explore", "Follow"). */
.footer__item-content > .heading,
.footer__item-content h2 {
  font-family: var(--brand-font-accent);
  font-size: 11px;
  letter-spacing: .18em;
  text-transform: uppercase;
  font-weight: 400;
  opacity: .7;
  margin-bottom: 18px;
}

/* Footer link list items: mono caps + Emerald Precision+ glyph prefix. */
.footer .linklist__item { padding-block: 4px; }
.footer .linklist__item a {
  display: inline-flex;
  align-items: center;
  gap: .55em;
  color: rgb(var(--brand-white));
  text-decoration: none;
  font-family: var(--brand-font-accent);
  font-weight: 400;
  font-size: 14px;
  letter-spacing: .1em;
  text-transform: uppercase;
  transition: color .15s ease;
}
.footer .linklist__item a::before {
  content: "";
  width: 11px;
  height: 11px;
  flex-shrink: 0;
  background-color: rgb(var(--brand-emerald));
  mask: var(--brand-plus-glyph) no-repeat center / contain;
  -webkit-mask: var(--brand-plus-glyph) no-repeat center / contain;
  transition: background-color .15s ease;
}
.footer .linklist__item a:hover { color: rgb(var(--brand-emerald)); }
.footer .linklist__item a:hover::before { background-color: rgb(var(--brand-neon)); }

/* Newsletter form on dark canvas. */
.footer .input,
.footer input[type="email"] {
  background: transparent;
  color: rgb(var(--brand-white));
  border: 0;
  border-bottom: 1px solid rgba(var(--brand-white), .3);
  border-radius: 0;
  padding-inline: 0;
}
.footer .input::placeholder,
.footer input[type="email"]::placeholder { color: rgba(var(--brand-white), .55); }
.footer .input:focus,
.footer input[type="email"]:focus {
  outline: none;
  border-bottom-color: rgb(var(--brand-emerald));
}

/* Social icons row. */
.footer__follow-and-payment,
.footer__follow-on-shop {
  color: rgb(var(--brand-white));
}
.footer__follow-and-payment a,
.footer__follow-on-shop a {
  color: rgb(var(--brand-white));
  opacity: .85;
  transition: opacity .15s ease;
}
.footer__follow-and-payment a:hover,
.footer__follow-on-shop a:hover { opacity: 1; color: rgb(var(--brand-emerald)); }

/* Payment methods row: lighten over dark canvas. */
.footer .payment-methods-list { opacity: .7; }

/* Footer aside (copyright + locale selector). */
.footer__aside {
  border-top: 1px solid rgba(var(--brand-white), .08);
  padding-block: 24px;
  font-family: var(--brand-font-accent);
  font-size: 11px;
  letter-spacing: .14em;
  text-transform: uppercase;
  opacity: .7;
}
.footer__aside .popover-button {
  color: rgb(var(--brand-white));
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
}

/* ============================================================
   Brand film section
   Cinematic 8-second loop. Pin-on-scroll on desktop, normal flow
   on mobile. Sits between best sellers and benefits in the
   homepage rhythm.
   ============================================================ */

.brand-film {
  position: relative;
  width: 100%;
  display: block;
}

/* Pin-on-scroll: outer is taller than the viewport so the inner can
   stick. Tuned so that at a typical wheel cadence the user sees one
   full 8-second loop play before the section releases. */
.brand-film--pinned {
  height: 220vh;
}

.brand-film__stage {
  position: relative;
  width: 100%;
  height: clamp(420px, 56vw, 720px);
  overflow: hidden;
  isolation: isolate;
  /* Inherit background-image from the .brand-surface--gradient parent
     so the gradient pattern shows around any letterboxed video edges. */
  background-image: inherit;
  background-color: inherit;
  background-size: cover;
  background-position: center;
}

.brand-film--pinned .brand-film__stage {
  position: sticky;
  top: 0;
  height: 100vh;
}

.brand-film__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.brand-film__overlay {
  position: absolute;
  left: clamp(20px, 4vw, 48px);
  bottom: clamp(28px, 4vw, 48px);
  z-index: 2;
  display: inline-flex;
  align-items: baseline;
  gap: 14px;
  font-family: var(--brand-font-accent);
  font-size: 12px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgb(var(--brand-white));
  text-shadow: 0 2px 12px rgba(0, 0, 0, .55);
  pointer-events: none;
}
.brand-film__step {
  font-size: 18px;
  letter-spacing: .12em;
  color: rgb(var(--brand-glow));
  font-weight: 400;
}
.brand-film__label {
  opacity: .9;
}

.brand-film__progress {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  height: 2px;
  background: rgba(var(--brand-white), .14);
  pointer-events: none;
}
.brand-film__progress-fill {
  display: block;
  width: 100%;
  height: 100%;
  background: rgb(var(--brand-glow));
  transform: scaleX(0);
  transform-origin: left center;
  /* Smooth out the timeupdate event cadence (~250ms on most browsers). */
  transition: transform .18s linear;
  will-change: transform;
}

/* Mobile: no pin (sticky inside short scroll regions feels broken on iOS),
   no drift (perf), keep the gradient backdrop. */
@media (max-width: 749px) {
  .brand-film--pinned { height: auto; }
  .brand-film--pinned .brand-film__stage {
    position: relative;
    height: clamp(380px, 64vw, 520px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .brand-film--pinned { height: auto; }
  .brand-film--pinned .brand-film__stage {
    position: relative;
    height: clamp(420px, 56vw, 720px);
  }
  .brand-film__progress-fill { transition: none; }
}
