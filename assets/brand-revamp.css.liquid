}

.brand-series-rail__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: clamp(16px, 2vw, 24px);
  grid-template-columns: repeat(var(--brand-series-cols, 3), 1fr);
}
@media (max-width: 999px) {
  .brand-series-rail__list { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .brand-series-rail__list { grid-template-columns: 1fr; }
}

.brand-series-card {
  position: relative;
  display: block;
  background: rgba(var(--brand-black), .35);
  border: 1px solid rgba(var(--brand-white), .12);
  border-radius: 8px;
  overflow: hidden;
  color: rgb(var(--brand-white));
  text-decoration: none;
  transition: transform .25s ease, border-color .25s ease, background .25s ease;
  opacity: 0;
  transform: translateY(16px);
  transition-delay: calc(var(--brand-card-index, 0) * .06s);
}
.brand-series-card.is-revealed,
[data-brand-reveal] .brand-series-card {
  opacity: 1;
  transform: translateY(0);
}
.brand-series-card:hover,
.brand-series-card:focus-visible {
  border-color: rgb(var(--brand-emerald));
  background: rgba(var(--brand-black), .55);
}
.brand-series-card:focus-visible {
  outline: 2px solid rgb(var(--brand-emerald));
  outline-offset: 3px;
}

.brand-series-card__frame {
  display: block;
  aspect-ratio: 4 / 3;
  background: rgb(var(--brand-shadow));
  overflow: hidden;
}
.brand-series-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease;
}
.brand-series-card:hover .brand-series-card__image {
  transform: scale(1.05);
}

.brand-series-card__inner {
  padding: clamp(20px, 2.5vw, 28px);
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.brand-series-card__size-hint {
  margin: 0;
  font-family: var(--brand-font-accent);
  font-size: 12px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgb(var(--brand-glow));
}
.brand-series-card__label {
  margin: 0;
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(28px, 3vw, 40px);
  letter-spacing: -0.01em;
  line-height: 1;
  text-transform: uppercase;
  color: rgb(var(--brand-white));
}
.brand-series-card__body {
  margin: 0;
  font-family: var(--brand-font-body);
  color: rgba(var(--brand-white), .78);
  font-size: 14px;
  line-height: 1.45;
}
.brand-series-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 10px;
  padding-top: 14px;
  border-top: 1px solid rgba(var(--brand-white), .12);
}
.brand-series-card__price {
  font-family: var(--brand-font-accent);
  font-size: 13px;
  letter-spacing: .08em;
  color: rgba(var(--brand-white), .82);
  text-transform: uppercase;
}
.brand-series-card__cta {
  font-family: var(--brand-font-accent);
  font-size: 12px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgb(var(--brand-emerald));
