.brand-best-sellers__nav {
  position: absolute;
  top: 38%;
  z-index: 2;
  width: 44px;
  height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgb(var(--brand-white));
  color: rgb(var(--brand-black));
