/* --- Collection grid (container) --------------------------- */
.brand-collection-grid {
  padding-block: clamp(48px, 6vw, 88px);
}
.brand-collection-grid__inner { position: relative; }
.brand-collection-grid__header {
  max-width: 720px;
  margin: 0 0 clamp(20px, 2.5vw, 32px);
}
.brand-collection-grid__eyebrow { margin: 0 0 12px; }
.brand-collection-grid__heading {
  margin: 0;
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(32px, 4vw, 52px);
  letter-spacing: -0.01em;
  line-height: 1;
  text-transform: uppercase;
  color: rgb(var(--brand-shadow));
}
.brand-surface--shadow .brand-collection-grid__heading,
.brand-surface--glow  .brand-collection-grid__heading { color: rgb(var(--brand-shadow)); }

.brand-collection-grid__meta {
  display: flex;
  align-items: center;
