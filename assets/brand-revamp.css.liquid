/* View Transitions — smooth morph between the two layouts.
   Each card has a unique view-transition-name set inline in Liquid;
   the browser pairs old/new bounds and animates between them. */
@media (prefers-reduced-motion: no-preference) {
  ::view-transition-old(*),
  ::view-transition-new(*) {
    animation-duration: 480ms;
    animation-timing-function: cubic-bezier(.2, .7, .2, 1);
  }
}

/* Below 1000px the hero/sibling swap concept doesn't translate to a
   tap-only interface — there's no hover, and a tap is also the navigation
   trigger. The whole asymmetric layout collapses to a clean 2x2 grid where
   every card is equal-sized, fully labelled, and links straight through.
   JS doesn't bind the pointer/dwell logic below this breakpoint. */
@media (max-width: 999px) {
  .brand-category-mosaic__grid {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    grid-template-areas:
      "c1 c2"
      "c3 c4";
    min-height: 0;
  }

  /* Reset per-hero positioning — fixed by data-card-id, equal everywhere. */
  .brand-category-mosaic[data-hero-id] .brand-category-mosaic__card[data-card-id="1"],
  .brand-category-mosaic .brand-category-mosaic__card[data-card-id="1"] { grid-area: c1; }
  .brand-category-mosaic[data-hero-id] .brand-category-mosaic__card[data-card-id="2"],
  .brand-category-mosaic .brand-category-mosaic__card[data-card-id="2"] { grid-area: c2; }
  .brand-category-mosaic[data-hero-id] .brand-category-mosaic__card[data-card-id="3"],
  .brand-category-mosaic .brand-category-mosaic__card[data-card-id="3"] { grid-area: c3; }
  .brand-category-mosaic[data-hero-id] .brand-category-mosaic__card[data-card-id="4"],
  .brand-category-mosaic .brand-category-mosaic__card[data-card-id="4"] { grid-area: c4; }

  /* Equal aspect on every card. */
  .brand-category-mosaic__card { aspect-ratio: 4 / 5; }

  /* No Ken Burns drift on mobile — keep the photo static so taps feel
     decisive and the section isn't constantly in motion. */
  .brand-category-mosaic.is-in-view[data-hero-id] .brand-category-mosaic__card .brand-category-mosaic__image {
    animation: none;
    transform: scale(1.04);
  }

  /* All cards get the same medium-weight label sizing. */
  .brand-category-mosaic[data-hero-id] .brand-category-mosaic__card .brand-category-mosaic__label,
  .brand-category-mosaic .brand-category-mosaic__card .brand-category-mosaic__label {
    font-size: clamp(22px, 5.6vw, 32px);
  }

  /* CTA visible on every card, not just the hero. */
  .brand-category-mosaic[data-hero-id] .brand-category-mosaic__card .brand-category-mosaic__cta,
  .brand-category-mosaic__card .brand-category-mosaic__cta {
    opacity: 1;
    transform: none;
  }
}

@media (max-width: 540px) {
  .brand-category-mosaic__grid {
    grid-template-columns: 1fr;
    grid-template-areas:
      "c1"
      "c2"
      "c3"
      "c4";
  }
  .brand-category-mosaic__card { aspect-ratio: 16 / 11; }
}

/* ============================================================
   Category — Concept C (Marquee Rail)
   Continuous horizontal scroll of tall portrait tiles. Pauses on
   hover; mobile drops the auto-scroll and gives a finger-drag
   scroll-snap rail.
   ============================================================ */

.brand-category-rail {
  position: relative;
  isolation: isolate;
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
  padding-block: clamp(48px, 6vw, 96px);
  overflow: hidden;
}
.brand-category-rail__badge {
  position: absolute;
  top: 20px;
  left: 20px;
  z-index: 4;
  display: inline-block;
  padding: 6px 12px;
  background: rgb(var(--brand-emerald));
  color: rgb(var(--brand-white));
  font-family: var(--brand-font-accent);
  font-size: 11px;
  letter-spacing: .14em;
  text-transform: uppercase;
  border-radius: 2px;
}
.brand-category-rail__header {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: clamp(24px, 3vw, 40px);
}
.brand-category-rail__heading {
  margin: 0;
  font-family: var(--brand-font-display);
  font-size: clamp(32px, 4vw, 56px);
  line-height: 1;
  text-transform: uppercase;
  letter-spacing: 0;
}

.brand-category-rail__viewport {
  width: 100%;
  overflow: hidden;
  position: relative;
  -webkit-mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%);
          mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%);
}

.brand-category-rail__track {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  gap: clamp(12px, 1.5vw, 20px);
  width: max-content;
  animation: brand-rail-scroll var(--brand-rail-duration, 60s) linear infinite;
  will-change: transform;
}
.brand-category-rail:hover .brand-category-rail__track,
.brand-category-rail:focus-within .brand-category-rail__track {
  animation-play-state: paused;
}
@keyframes brand-rail-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
@media (prefers-reduced-motion: reduce) {
  .brand-category-rail__track {
    animation: none;
    transform: none;
  }
}

.brand-category-rail__tile {
  flex: 0 0 auto;
  width: clamp(260px, 26vw, 360px);
  aspect-ratio: 3 / 4;
  position: relative;
  overflow: hidden;
  background: rgb(var(--brand-shadow));
  border-radius: 2px;
  scroll-snap-align: start;
  transition: transform .35s cubic-bezier(.2, .7, .2, 1);
}
.brand-category-rail__tile:hover,
.brand-category-rail__tile:focus-within {
  transform: scale(1.03);
  z-index: 2;
}

.brand-category-rail__link {
  display: block;
  position: relative;
  width: 100%;
  height: 100%;
  text-decoration: none;
  color: rgb(var(--brand-white));
}
.brand-category-rail__link:focus-visible {
  outline: 2px solid rgb(var(--brand-emerald));
  outline-offset: -4px;
}

.brand-category-rail__frame {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.brand-category-rail__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transform: scale(1.05);
  transition: transform .5s cubic-bezier(.2, .7, .2, 1);
}
.brand-category-rail__tile:hover .brand-category-rail__image,
.brand-category-rail__tile:focus-within .brand-category-rail__image {
  transform: scale(1.12);
}

.brand-category-rail__link::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    to top,
    rgba(0,0,0,.78) 0%,
    rgba(0,0,0,.3) 50%,
    rgba(0,0,0,0)   100%
  );
  pointer-events: none;
}

.brand-category-rail__content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  height: 100%;
  padding: clamp(16px, 2vw, 24px);
  gap: 10px;
}
.brand-category-rail__label {
  margin: 0;
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(28px, 3vw, 42px);
  line-height: .95;
  text-transform: uppercase;
  letter-spacing: 0;
  display: inline-flex;
