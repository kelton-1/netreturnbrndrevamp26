/* ============================================================
   Brand Revamp 2026 — Collection page surfaces.
   Scoped to .brand-* classes only. Targets /collections/nets-1
   first; pattern is reusable across other collection landings.
   ============================================================ */

/* --- Breadcrumb (brand-revamp 2026 — Concept A1) -----------
   Slim inline, no ribbon. Sits at the top of the page container on
   the page's natural background (no full-bleed dark band). Reference:
   Allbirds, Aritzia, Lululemon, On Running.

   The breadcrumb appears in the small gap between the dark header
   and whatever comes next (dark collection hero, white PDP content).
   On all live templates that gap is the page's white background, so
   a dark-text-on-light variant works everywhere. */

/* Hide Focal's legacy nav.breadcrumb when the brand breadcrumb is
   also present on the page — main-product.liquid (line 71),
   main-product-cro.liquid (line 46), main-product-azalea.liquid,
   main-page, main-blog, collection-banner, and blog-post-banner all
   render their own breadcrumb. Branded templates ship
   brand-breadcrumb at the top, so without this rule the user sees
   two breadcrumb bars stacked. The :has() check leaves the legacy
   breadcrumb intact on pages that don't carry a brand-breadcrumb
   yet, so unbranded templates degrade gracefully. */
body:has(.brand-breadcrumb) .breadcrumb { display: none; }

.brand-breadcrumb {
  background: transparent;
  border: 0;
}
.brand-breadcrumb__inner {
  padding: 10px 0 4px;
}
.brand-breadcrumb__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px 8px;
  font-family: var(--brand-font-body);
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0;
  text-transform: none;
  line-height: 1.4;
  color: rgba(var(--brand-black), .55);
}
.brand-breadcrumb__item { margin: 0; }
.brand-breadcrumb__link {
  color: rgba(var(--brand-black), .72);
  text-decoration: none;
  transition: color .18s ease;
}
.brand-breadcrumb__link:hover,
.brand-breadcrumb__link:focus-visible {
  color: rgb(var(--brand-emerald));
}
.brand-breadcrumb__item--current {
  color: rgb(var(--brand-black));
  font-weight: 500;
}
.brand-breadcrumb__sep {
  color: rgba(var(--brand-black), .22);
  font-size: 11px;
  user-select: none;
}

/* Dark-page fallback — applied when the breadcrumb is rendered on
   a dark surface (any section ancestor uses one of the brand dark
   color schemes, OR an explicit modifier class). Today every live
   template puts the breadcrumb on the page's white background, so
   this is defensive only. Add the modifier class via the section's
   schema setting if a future template puts the breadcrumb on dark. */
.brand-breadcrumb--on-dark .brand-breadcrumb__list {
  color: rgba(var(--brand-white), .55);
}
.brand-breadcrumb--on-dark .brand-breadcrumb__link {
  color: rgba(var(--brand-white), .75);
}
.brand-breadcrumb--on-dark .brand-breadcrumb__link:hover,
.brand-breadcrumb--on-dark .brand-breadcrumb__link:focus-visible {
  color: rgb(var(--brand-glow));
}
.brand-breadcrumb--on-dark .brand-breadcrumb__item--current {
  color: rgb(var(--brand-white));
}
.brand-breadcrumb--on-dark .brand-breadcrumb__sep {
  color: rgba(var(--brand-white), .28);
}

@media (max-width: 540px) {
  .brand-breadcrumb__inner { padding: 8px 0 4px; }
  .brand-breadcrumb__list { font-size: 12px; gap: 3px 6px; }
}

/* ---------- A2: overlay into brand-collection-intro hero ----------
   On collection pages the breadcrumb section sits between two dark
   surfaces (header above, brand-collection-intro hero below). A1 on
   its own leaves a thin white gap there. This rule detects the
   "breadcrumb followed by collection intro" pattern via :has() and
   overlays the breadcrumb onto the top of the hero with light text,
   removing the gap.

   - The breadcrumb's parent .shopify-section gets a negative margin-
     bottom so the next section moves up to start under it.
   - position: relative + z-index: 2 keeps the breadcrumb on top of
     the now-overlapping hero.
   - Light-text color tokens (the same ones used by the .on-dark
     modifier) are applied conditionally.
   - The hero's brand-collection-intro__inner picks up extra top
     padding so its eyebrow + heading don't sit behind the breadcrumb.

   PDPs and pages (no brand-collection-intro in the next section) are
   unaffected — they keep A1's light page-background look. */
.shopify-section:has(.brand-breadcrumb):has(+ .shopify-section .brand-collection-intro) {
  position: relative;
  z-index: 2;
  margin-bottom: -36px;
}
.shopify-section:has(.brand-breadcrumb):has(+ .shopify-section .brand-collection-intro) .brand-breadcrumb__list {
  color: rgba(var(--brand-white), .58);
}
.shopify-section:has(.brand-breadcrumb):has(+ .shopify-section .brand-collection-intro) .brand-breadcrumb__link {
  color: rgba(var(--brand-white), .78);
}
.shopify-section:has(.brand-breadcrumb):has(+ .shopify-section .brand-collection-intro) .brand-breadcrumb__link:hover,
.shopify-section:has(.brand-breadcrumb):has(+ .shopify-section .brand-collection-intro) .brand-breadcrumb__link:focus-visible {
  color: rgb(var(--brand-glow));
}
.shopify-section:has(.brand-breadcrumb):has(+ .shopify-section .brand-collection-intro) .brand-breadcrumb__item--current {
  color: rgb(var(--brand-white));
}
.shopify-section:has(.brand-breadcrumb):has(+ .shopify-section .brand-collection-intro) .brand-breadcrumb__sep {
  color: rgba(var(--brand-white), .32);
}

/* Pad the hero's content so it doesn't sit behind the overlaid
   breadcrumb. Targets the inner content container of the intro
   section that immediately follows the breadcrumb section. */
.shopify-section:has(.brand-breadcrumb) + .shopify-section .brand-collection-intro {
  padding-top: clamp(60px, 6vw, 84px);
}

/* --- Series rail ------------------------------------------- */
.brand-series-rail {
  padding-block: clamp(56px, 8vw, 96px);
  color: rgb(var(--brand-white));
  position: relative;
}
.brand-series-rail__inner { position: relative; z-index: 1; }
.brand-series-rail__header {
  max-width: 720px;
  margin: 0 0 clamp(28px, 4vw, 48px);
}
.brand-series-rail__eyebrow { margin: 0 0 14px; color: rgba(var(--brand-white), .82); }
.brand-series-rail__heading {
  margin: 0 0 12px;
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(36px, 5vw, 64px);
  line-height: .96;
  letter-spacing: -0.01em;
  color: rgb(var(--brand-white));
}
.brand-series-rail__body {
  max-width: 56ch;
