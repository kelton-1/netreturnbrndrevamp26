  grid-template-columns: repeat(var(--brand-cross-cols, 3), 1fr);
}
@media (max-width: 899px) {
  .brand-cross-links__list { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 540px) {
  .brand-cross-links__list { grid-template-columns: 1fr; }
}

.brand-cross-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: clamp(20px, 2.4vw, 28px);
  background: rgb(var(--brand-white));
  border: 1px solid rgba(var(--brand-shadow), .14);
  border-radius: 8px;
  text-decoration: none;
  color: rgb(var(--brand-shadow));
  transition: transform .2s ease, border-color .2s ease, box-shadow .25s ease;
  height: 100%;
}
.brand-cross-card:hover {
  transform: translateY(-2px);
  border-color: rgb(var(--brand-emerald));
  box-shadow: 0 12px 30px -20px rgba(var(--brand-shadow), .4);
}
.brand-cross-card__eyebrow {
  font-family: var(--brand-font-accent);
  font-size: 11px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: rgba(var(--brand-shadow), .65);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.brand-cross-card__eyebrow .brand-plus {
  width: 9px;
  height: 9px;
  background-color: rgb(var(--brand-emerald));
  mask-image: var(--brand-plus-glyph);
  mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
  -webkit-mask-image: var(--brand-plus-glyph);
  -webkit-mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
}
.brand-cross-card__heading {
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(22px, 2vw, 30px);
  letter-spacing: -0.005em;
  line-height: 1.04;
  text-transform: uppercase;
  color: rgb(var(--brand-shadow));
}
.brand-cross-card__body {
  font-family: var(--brand-font-body);
  font-size: 14px;
  line-height: 1.45;
  color: rgba(var(--brand-shadow), .75);
  flex: 1 1 auto;
}
.brand-cross-card__cta {
  font-family: var(--brand-font-accent);
  font-size: 12px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgb(var(--brand-emerald));
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 4px;
}
.brand-cross-card__cta-arrow { transition: transform .2s ease; }
.brand-cross-card:hover .brand-cross-card__cta-arrow { transform: translateX(4px); }

/* Cross-link block on glow surface inherits Shadow Green text by default. */
.brand-cross-links.brand-surface--shadow .brand-cross-links__heading,
.brand-cross-links.brand-surface--shadow .brand-cross-links__body { color: rgb(var(--brand-white)); }
.brand-cross-links.brand-surface--shadow .brand-cross-card {
  background: rgba(var(--brand-white), .04);
  border-color: rgba(var(--brand-white), .14);
  color: rgb(var(--brand-white));
}
.brand-cross-links.brand-surface--shadow .brand-cross-card__heading { color: rgb(var(--brand-white)); }
.brand-cross-links.brand-surface--shadow .brand-cross-card__body { color: rgba(var(--brand-white), .78); }
.brand-cross-links.brand-surface--shadow .brand-cross-card__eyebrow { color: rgba(var(--brand-white), .6); }

