  .shopify-section-group-header-group .header__inline-navigation .header__icon-list,
  .shopify-section-group-header-group .header__secondary-links .header__icon-list,
  #shopify-section-header .header__inline-navigation .header__icon-list,
  #shopify-section-header .header__secondary-links .header__icon-list {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .shopify-section-group-header-group .header .header__icon-wrapper,
  #shopify-section-header .header .header__icon-wrapper {
