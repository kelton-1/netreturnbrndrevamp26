/* ============================================================
   Brand Revamp 2026 — foundation layer.
   Brand-prefixed classes only. No global element overrides.
   Composes on Focal's existing settings tokens
   (--primary-button-background, --header-background, etc.)
   ============================================================ */

@font-face {
  font-family: "Crystal";
  src: url('{{ "brand-crystal-light.ttf" | asset_url }}') format("truetype");
  font-weight: 300;
  font-style: normal;
  font-stretch: 100%;
  font-display: swap;
}
@font-face {
  font-family: "Crystal";
  src: url('{{ "brand-crystal-regular.ttf" | asset_url }}') format("truetype");
  font-weight: 400;
  font-style: normal;
  font-stretch: 100%;
  font-display: swap;
}
@font-face {
  font-family: "Crystal";
  src: url('{{ "brand-crystal-semibold.ttf" | asset_url }}') format("truetype");
  font-weight: 600;
  font-style: normal;
  font-stretch: 100%;
  font-display: swap;
}
@font-face {
  font-family: "Crystal Ultra Condensed";
  src: url('{{ "brand-crystal-ultra-condensed-semibold.ttf" | asset_url }}') format("truetype");
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Miracle Mono";
  src: url('{{ "brand-miracle-mono-regular.otf" | asset_url }}') format("opentype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

:root {
  /* Brand palette as RGB triplets, so they can be used with rgb() / rgba(). */
  --brand-emerald: 0, 156, 67;        /* #009C43 */
  --brand-shadow:  35, 58, 53;        /* #233A35 */
  --brand-glow:    165, 230, 198;     /* #A5E6C6 */
  --brand-neon:    104, 253, 0;       /* #68FD00 */
  --brand-black:   0, 0, 0;
  --brand-white:   255, 255, 255;

  /* Pattern asset URLs (Liquid-rendered to Shopify CDN). */
  --brand-grid-tile-white: url('{{ "pattern-grid-tile-white.svg" | asset_url }}');
  --brand-grid-tile-black: url('{{ "pattern-grid-tile-black.svg" | asset_url }}');

  /* Full-bleed 1920x1080 grid and gradient backdrops from the brand toolkit.
     These are used by .brand-surface--gradient and .brand-surface--grid-full
     utilities below — different from the small repeating tiles above.
     Source: TheNetReturn/UPDATED Net Return Toolkit/PATTERN/. */
  --brand-grid-black:           url('{{ "pattern-grid-black.svg" | asset_url }}');
  --brand-grid-shadow:          url('{{ "pattern-grid-shadow-green.svg" | asset_url }}');
  --brand-grid-glow:            url('{{ "pattern-grid-glow-green.svg" | asset_url }}');
  --brand-grid-emerald:         url('{{ "pattern-grid-emerald-green.svg" | asset_url }}');
  --brand-grid-white-full:      url('{{ "pattern-grid-white.svg" | asset_url }}');

  --brand-gradient-black:       url('{{ "pattern-gradient-black.svg" | asset_url }}');
  --brand-gradient-shadow:      url('{{ "pattern-gradient-shadow-green.svg" | asset_url }}');
  --brand-gradient-emerald:     url('{{ "pattern-gradient-emerald-green.svg" | asset_url }}');
  --brand-gradient-glow:        url('{{ "pattern-gradient-glow-green.svg" | asset_url }}');
  --brand-gradient-clear-grey:  url('{{ "pattern-gradient-clear-grey.svg" | asset_url }}');
  --brand-gradient-clear-white: url('{{ "pattern-gradient-clear-white.svg" | asset_url }}');

  /* Single Precision+ glyph (the actual brand mark, not the grid tile).
     Used for inline glyphs and ::before markers where the mark needs to be
     visible at small sizes. The grid tile is a 80x80 array of plus marks —
     wrong asset to mask down to a 12px box. */
  --brand-plus-glyph: url('{{ "precision-plus-white.svg" | asset_url }}');

  --brand-font-sans-fallback: Arial, Helvetica, sans-serif;
  --brand-font-body: "Crystal", var(--brand-font-sans-fallback);
  --brand-font-heading: "Crystal", var(--brand-font-sans-fallback);
  --brand-font-display: "Crystal Ultra Condensed", "Crystal", var(--brand-font-sans-fallback);
  --brand-font-accent: "Miracle Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --brand-font-mono: var(--brand-font-accent);

  --text-font-family: var(--brand-font-body);
  --text-font-weight: 400;
  --text-font-style: normal;
  --text-font-bold-weight: 600;
  --heading-font-family: var(--brand-font-heading);
  --heading-font-weight: 600;
  --heading-font-style: normal;

  /* ----------------------------------------------------------
     Typography system v2 — 2026-05-20 readability pass.

     Feedback: KEY items (nav, buttons, prices, product names,
     primary copy) must be easily readable regardless. SIDE
     messaging (eyebrows, marquee, micro-meta, fine print, SEO
     long-tail) has more leash for decorative sizing/font.

     The earlier brand-revamp put Miracle Mono Regular at
     10-13px fixed pixels on load-bearing surfaces (header nav,
     buttons, footer links, mobile drawer). Mono at small sizes
     with heavy caps + letter-spacing reads as decorative
     texture, not navigation. The role tokens below pull KEY
     surfaces onto Crystal (higher x-height, more legible) and
     leave Miracle Mono on true accents. The "Readability pass
     v2" block at the end of this file applies them.

     Role     | Font                | Used on
     ---------|---------------------|---------------------------
     display  | Crystal Ultra Cond. | hero, Bryson, oversized
     heading  | Crystal SemiBold    | section headings
     body     | Crystal Regular     | reading copy
     nav      | Crystal SemiBold    | header/footer/drawer nav (KEY)
     action   | Crystal SemiBold    | buttons, CTAs (KEY)
     meta     | Crystal Regular     | breadcrumbs, sub-meta
     accent   | Miracle Mono Reg.   | eyebrows, marquee (SIDE)
     micro    | Miracle Mono Reg.   | fine print, slugs (SIDE)
     ---------------------------------------------------------- */

  /* Role-based font assignments. Crystal for load-bearing UI. */
  --brand-font-nav:    var(--brand-font-body);
  --brand-font-action: var(--brand-font-body);
  --brand-font-meta:   var(--brand-font-body);

  /* Fluid type scale. Min sizes are tuned for mobile readability;
     max sizes are tuned to stop blowing out on 4K monitors. The
     vw factors keep each role within a sensible band. */
  --brand-fs-display:    clamp(48px, 9vw, 160px);
  --brand-fs-headline:   clamp(34px, 5vw, 80px);
  --brand-fs-title:      clamp(22px, 2vw, 30px);
  --brand-fs-subtitle:   clamp(18px, 1.4vw, 22px);
  --brand-fs-body:       clamp(16px, 1.05vw, 18px);
  --brand-fs-body-sm:    clamp(15px, 0.95vw, 16px);
  --brand-fs-nav:        clamp(15px, 0.95vw, 16px);
  --brand-fs-action:     clamp(15px, 0.95vw, 16px);
  --brand-fs-action-sm:  14px;
  --brand-fs-meta:       clamp(13px, 0.85vw, 14px);
  --brand-fs-eyebrow:    clamp(12px, 0.85vw, 13px);
  --brand-fs-micro:      12px;

  /* Letter-spacing tokens. The previous pass used 0.18-0.22em on
     nav links, which scans as editorial display type — beautiful
     in mockups, hostile to actual reading. KEY surfaces drop to
     0.02-0.06em; SIDE caps keep their wider 0.12-0.14em. */
  --brand-ls-tight:  -0.005em;
  --brand-ls-normal: 0;
  --brand-ls-nav:    0.04em;
  --brand-ls-action: 0.06em;
  --brand-ls-caps:   0.12em;
  --brand-ls-caps-wide: 0.16em;
}

/* ---------- Surfaces ---------- */

.brand-surface {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
}
.brand-surface--shadow { background: rgb(var(--brand-shadow)); color: rgb(var(--brand-white)); }
.brand-surface--emerald { background: rgb(var(--brand-emerald)); color: rgb(var(--brand-white)); }
.brand-surface--glow    { background: rgb(var(--brand-glow)); color: rgb(var(--brand-black)); }
.brand-surface--white   { background: rgb(var(--brand-white)); color: rgb(var(--brand-black)); }

/* ---------- Surface depth (no ornament) ----------
   Was a tiled Precision+ pattern; owner rejected the tile look.
   Now a near-invisible radial gradient that gives any brand surface a
   subtle center-lift and edge-darken so mid-page sections still read
   as intentional surfaces, not flat blocks. Class name kept as
   `.brand-surface--pattern` so the 7 sections composing it continue
   to work without markup changes — only the visual treatment changed.
   Pattern-grid SVG asset URLs (--brand-grid-*) are no longer
   referenced here; they remain in :root for any one-off use.
   -------------------------------------------------------- */
.brand-surface--pattern {
  background-image: radial-gradient(
    ellipse at center,
    rgba(255, 255, 255, 0.04) 0%,
    rgba(255, 255, 255, 0) 45%,
    rgba(0, 0, 0, 0.10) 100%
  );
  background-repeat: no-repeat;
  background-size: cover;
}
.brand-surface--shadow.brand-surface--pattern {
  background-image: radial-gradient(
    ellipse at center,
    rgba(255, 255, 255, 0.045) 0%,
    rgba(255, 255, 255, 0) 50%,
    rgba(0, 0, 0, 0.14) 100%
  );
}
.brand-surface--emerald.brand-surface--pattern {
  background-image: radial-gradient(
    ellipse at center,
    rgba(255, 255, 255, 0.06) 0%,
    rgba(255, 255, 255, 0) 55%,
    rgba(0, 0, 0, 0.10) 100%
  );
}
.brand-surface--glow.brand-surface--pattern {
  background-image: radial-gradient(
    ellipse at center,
    rgba(255, 255, 255, 0.10) 0%,
    rgba(255, 255, 255, 0) 55%,
    rgba(35, 58, 53, 0.08) 100%
  );
}
.brand-surface--white.brand-surface--pattern {
  background-image: radial-gradient(
    ellipse at center,
    rgba(255, 255, 255, 0) 0%,
    rgba(35, 58, 53, 0.04) 100%
  );
}

/* ---------- Full-bleed gradient backdrop utilities ----------
   Apply by composing classes:
     .brand-surface--gradient .brand-surface--gradient--shadow
   These use the 1920x1080 toolkit gradient SVGs at background-size: cover so the
   section reads as a single rich gradient panel — not a tiling pattern. Pair with
   the existing .brand-surface--shadow / --emerald / --glow surfaces if the section
   needs a solid base color underneath while images load. */
.brand-surface--gradient {
  background-color: rgb(var(--brand-black));
  background-image: var(--brand-gradient-black);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  color: rgb(var(--brand-white));
}
.brand-surface--gradient.brand-surface--gradient--shadow {
  background-color: rgb(var(--brand-shadow));
  background-image: var(--brand-gradient-shadow);
}
.brand-surface--gradient.brand-surface--gradient--emerald {
  background-color: rgb(var(--brand-emerald));
  background-image: var(--brand-gradient-emerald);
}
.brand-surface--gradient.brand-surface--gradient--glow {
  background-color: rgb(var(--brand-glow));
  background-image: var(--brand-gradient-glow);
  color: rgb(var(--brand-black));
}
.brand-surface--gradient.brand-surface--gradient--clear-grey {
  background-color: rgb(var(--brand-white));
  background-image: var(--brand-gradient-clear-grey);
  color: rgb(var(--brand-black));
}
.brand-surface--gradient.brand-surface--gradient--clear-white {
  background-color: rgb(var(--brand-white));
  background-image: var(--brand-gradient-clear-white);
  color: rgb(var(--brand-black));
}

/* Slow ambient drift on full-bleed gradient surfaces. Heat-shimmer over a
   driving range, not a marketing flourish. 60s linear loop, opt-in via
   .brand-surface--gradient--drift. Disabled under reduced-motion. */
.brand-surface--gradient--drift {
  position: relative;
  isolation: isolate;
  overflow: hidden;
}
.brand-surface--gradient--drift::before {
  content: "";
  position: absolute;
  inset: -8% -8%;
  z-index: -1;
  background-image: inherit;
  background-size: 120% 120%;
  background-position: center;
  background-repeat: no-repeat;
  animation: brand-gradient-drift 60s linear infinite;
  will-change: transform;
  pointer-events: none;
}
@keyframes brand-gradient-drift {
  0%   { transform: translate3d(0, 0, 0) scale(1); }
  50%  { transform: translate3d(-2%, 1.5%, 0) scale(1.04); }
  100% { transform: translate3d(0, 0, 0) scale(1); }
}
@media (prefers-reduced-motion: reduce) {
  .brand-surface--gradient--drift::before { animation: none; }
}

/* ---------- Containers ---------- */

.brand-container {
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: clamp(16px, 4vw, 48px);
}

.brand-section { padding-block: clamp(48px, 8vw, 120px); }
.brand-section--tight { padding-block: clamp(24px, 4vw, 48px); }

/* ---------- Typography ---------- */
/* Brand guide mapping: Crystal for body/headings, Ultra Condensed for display, Miracle Mono for small accents. */

.heading,
.h2,
.h3,
.h5,
.h6 {
  font-family: var(--brand-font-heading);
  font-weight: 600;
  font-style: normal;
  letter-spacing: 0;
}

.heading--large,
.h1 {
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-style: normal;
  letter-spacing: 0;
}

.heading--xsmall,
.heading--small,
.text--xsmall,
.input__label,
.product-item__label-list,
.product-item__quick-buy-button,
.popover-button,
.button:not(.brand-btn) {
  font-family: var(--brand-font-accent);
  font-weight: 400;
}

.brand-eyebrow {
  font-family: var(--brand-font-accent);
  font-size: 11px;
  letter-spacing: .18em;
  text-transform: uppercase;
  font-weight: 400;
  margin: 0 0 12px;
  opacity: .8;
}

.brand-headline {
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(40px, 7.5vw, 112px);
  line-height: .96;
  letter-spacing: 0;
  margin: 0;
  text-wrap: balance;
}
.brand-headline__em {
  font-weight: 600;
  letter-spacing: 0;
}

.brand-headline--display {
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(80px, 18vw, 280px);
  line-height: .85;
  letter-spacing: 0;
  text-transform: uppercase;
}
.brand-headline--stroke {
  -webkit-text-stroke: 1.5px currentColor;
  color: transparent;
}

.brand-body {
  font-family: var(--brand-font-body);
  font-weight: 400;
  font-size: 16px;
  line-height: 1.55;
  max-width: 56ch;
  margin: 0;
}

/* ---------- Buttons (tactile) ---------- */
/*
 * Shared motion tokens. "Return motion" — slight spring on the lift, snappy
 * ease-out everywhere else. Critical: NO transition affects layout width
 * (otherwise the button visibly grows on hover and the page-navigation
 * freeze-frame catches it at peak width — the "really big" bug v1 had).
 */
:root {
  --brand-motion-curve: cubic-bezier(0.22, 1.2, 0.36, 1);   /* lift spring, ~3% overshoot */
  --brand-motion-out:   cubic-bezier(0.4, 0, 0.2, 1);       /* settle / press */
  --brand-motion-in-duration: 260ms;
  --brand-motion-out-duration: 160ms;
}

.brand-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  padding: 16px 32px;
  font-family: var(--brand-font-accent);
  font-weight: 400;
  font-size: 13px;
  letter-spacing: .12em;
  line-height: 1;
  text-transform: uppercase;
  text-decoration: none;
  border: 0;
  border-radius: 2px;
  cursor: pointer;
  isolation: isolate;
  overflow: hidden;
  white-space: nowrap;
  transition:
    background-color var(--brand-motion-in-duration) var(--brand-motion-out),
    color            var(--brand-motion-in-duration) var(--brand-motion-out),
    transform        var(--brand-motion-in-duration) var(--brand-motion-curve),
    box-shadow       var(--brand-motion-in-duration) var(--brand-motion-curve);
}
.brand-btn:not(:hover):not(:active) {
  transition:
    background-color var(--brand-motion-out-duration) var(--brand-motion-out),
    color            var(--brand-motion-out-duration) var(--brand-motion-out),
    transform        var(--brand-motion-out-duration) var(--brand-motion-out),
    box-shadow       var(--brand-motion-out-duration) var(--brand-motion-out);
}
/* Press feedback. Snappy ease-out, no spring — a springy press feels weird
   because the scale "bounces" on its way down. */
.brand-btn:active {
  transform: scale(0.97) !important;
  transition: transform 100ms cubic-bezier(0.4, 0, 0.2, 1) !important;
}

/* Click ripple span (added by brand-motion.js). Positioned at click point,
   expands outward, fades. Clipped by the button's overflow: hidden. The
   explicit z-index of -1 sits it BELOW the label without needing a separate
   rule on the label — fixes the same-specificity conflict the previous
   version had with .brand-btn > *. */
.brand-btn__ripple {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  background: rgba(var(--brand-glow), 0.50);
  transform: scale(0);
  opacity: 1;
  animation: brand-btn-ripple 560ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
  z-index: -1;
}
@keyframes brand-btn-ripple {
  0%   { transform: scale(0); opacity: 0.50; }
  60%  { opacity: 0.22; }
  100% { transform: scale(1); opacity: 0; }
}

.brand-btn--primary {
  background: rgb(var(--brand-emerald));
  color: rgb(var(--brand-white));
}
.brand-btn--primary:hover {
  /* Restored the original Emerald → Neon flip on hover. The lift + Emerald
     shadow stays. */
  background: rgb(var(--brand-neon));
  color: rgb(var(--brand-black));
  transform: translateY(-2px);
  box-shadow:
    0 8px 18px rgba(var(--brand-emerald), 0.30),
    0 2px 6px rgba(var(--brand-emerald), 0.16);
}

.brand-btn--outline {
  background: transparent;
  color: rgb(var(--brand-white));
  box-shadow: inset 0 0 0 1.5px currentColor;
}
.brand-btn--outline::before {
  /* Left-to-right Emerald wipe. Uses ease-out (no spring) so scaleX never
     exceeds 1 — keeps the fill from briefly stretching past the right edge
     during hover-in. */
  content: "";
  position: absolute;
  inset: 0;
  background: rgb(var(--brand-emerald));
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform var(--brand-motion-in-duration) var(--brand-motion-out);
  z-index: -2;
}
.brand-btn--outline:hover {
  background: transparent;
  color: rgb(var(--brand-white));
  box-shadow: inset 0 0 0 1.5px rgb(var(--brand-emerald));
  transform: translateY(-2px);
}
.brand-btn--outline:hover::before { transform: scaleX(1); }

.brand-btn--ghost-dark {
  background: transparent;
  color: rgb(var(--brand-black));
  box-shadow: inset 0 0 0 1.5px currentColor;
}
.brand-btn--ghost-dark:hover {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
  transform: translateY(-2px);
}

@media (prefers-reduced-motion: reduce) {
  .brand-btn,
  .brand-btn:not(:hover):not(:active),
  .brand-btn--outline::before {
    transition: background-color 120ms linear, color 120ms linear !important;
    transform: none !important;
  }
  .brand-btn:hover  { transform: none !important; box-shadow: none !important; }
  .brand-btn:active { transform: none !important; }
  .brand-btn__ripple { display: none !important; }
}

/* ---------- Reveal cascade ---------- */
/*
 * Opt-in section-entrance choreography. Section roots carry [data-brand-reveal] and the
 * JS adds .brand-motion-ready once it's attached IntersectionObserver. Without the JS class,
 * children never hide — so a JS-load failure degrades to "no animation," not "blank section."
 *
 * Element-by-element:
 *   .brand-eyebrow / [data-reveal-eyebrow] — fades up 8px, glyph rotates -45° → 0°
 *   [data-reveal-headline] — split into words by JS; each word slides up 24px with stagger
 *   [data-reveal-body] / .brand-reveal__body — fades in after the last word lands
 *   [data-reveal-cta] / .brand-reveal__cta — fades in slightly after body
 */
[data-brand-reveal].brand-motion-ready .brand-reveal__eyebrow {
  opacity: 0;
  transform: translateY(8px);
  transition:
    opacity 240ms var(--brand-motion-curve),
    transform 240ms var(--brand-motion-curve);
}
[data-brand-reveal].brand-motion-ready .brand-reveal__eyebrow .brand-plus {
  transform: rotate(-45deg);
  transition: transform 320ms var(--brand-motion-curve);
}
[data-brand-reveal].brand-motion-ready.is-revealed .brand-reveal__eyebrow {
  opacity: 1;
  transform: translateY(0);
}
[data-brand-reveal].brand-motion-ready.is-revealed .brand-reveal__eyebrow .brand-plus {
  transform: rotate(0);
}

.brand-reveal__word-wrap {
  display: inline-block;
  overflow: hidden;
  vertical-align: bottom; /* keeps descenders/ascenders aligned to the surrounding text */
}
.brand-reveal__word {
  display: inline-block;
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity 480ms var(--brand-motion-curve),
    transform 480ms var(--brand-motion-curve);
  will-change: transform, opacity;
}
[data-brand-reveal].brand-motion-ready.is-revealed .brand-reveal__word {
  opacity: 1;
  transform: translateY(0);
}

[data-brand-reveal].brand-motion-ready .brand-reveal__body-line {
  opacity: 0;
  transform: translateY(12px);
  transition:
    opacity 480ms var(--brand-motion-out),
    transform 480ms var(--brand-motion-curve);
}
[data-brand-reveal].brand-motion-ready.is-revealed .brand-reveal__body-line {
  opacity: 1;
  transform: translateY(0);
}

[data-brand-reveal].brand-motion-ready .brand-reveal__cta-layer {
  opacity: 0;
  transform: translateY(8px);
  transition:
    opacity 240ms var(--brand-motion-out),
    transform 240ms var(--brand-motion-curve);
}
[data-brand-reveal].brand-motion-ready.is-revealed .brand-reveal__cta-layer {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  [data-brand-reveal].brand-motion-ready .brand-reveal__eyebrow,
  [data-brand-reveal].brand-motion-ready .brand-reveal__eyebrow .brand-plus,
  [data-brand-reveal].brand-motion-ready .brand-reveal__word,
  [data-brand-reveal].brand-motion-ready .brand-reveal__body-line,
  [data-brand-reveal].brand-motion-ready .brand-reveal__cta-layer {
    transition: opacity 200ms linear !important;
    transform: none !important;
    transition-delay: 0ms !important;
  }
}

/* ---------- Premium lift (cards v2) ---------- */
/*
 * Opt-in card upgrade. Add .brand-lift to any card root. JS (brand-motion.js)
 * tracks the cursor inside the card and sets --mx, --my, --lx, --ly custom
 * properties. CSS reads them to:
 *   1. tilt the whole card (rotateX/rotateY, max 3°) with strong perspective
 *   2. parallax-shift the inner image (8px max) opposite to cursor
 *   3. paint a Glow-Green radial light at the cursor position inside the card
 *   4. lift the card 8px on hover with a layered Emerald shadow + glow halo
 *   5. micro-shift content (title up 4px, CTA reveals from below)
 *
 * Cards opt their image element in via .brand-lift__image and their CTA via
 * .brand-lift__cta — both classes can be applied to existing components without
 * collateral damage. If a card uses .brand-lift but doesn't add the inner
 * classes, the card still gets lift + tilt + cursor light — just no parallax or
 * CTA reveal.
 *
 * Touch + reduced motion: JS skips binding the mousemove listener entirely, and
 * the media query below drops the tilt + cursor light + content shifts.
 */
.brand-lift {
  --mx: 0;
  --my: 0;
  --lx: 50%;
  --ly: 50%;
  position: relative;
  isolation: isolate;
  transform: perspective(1200px) rotateX(0) rotateY(0) translateY(0);
  transform-style: preserve-3d;
  /* Lift uses a softened overshoot — the spring on .brand-btn is intentional
     because buttons benefit from snap, but a card-sized element overshooting
     can read as a "bulge", especially if the user clicks mid-transition and
     the browser freezes the frame during navigation. cubic-bezier(0.22, 1.2,
     0.36, 1) overshoots ~3% (vs ~8% for the button curve) — feels alive,
     doesn't visibly pop. */
  transition:
    transform 280ms cubic-bezier(0.22, 1.2, 0.36, 1),
    box-shadow 280ms cubic-bezier(0.22, 1.2, 0.36, 1),
    border-color 280ms cubic-bezier(0.22, 1.2, 0.36, 1);
  will-change: transform;
}
.brand-lift:not(:hover) {
  transition:
    transform var(--brand-motion-out-duration) var(--brand-motion-out),
    box-shadow var(--brand-motion-out-duration) var(--brand-motion-out),
    border-color var(--brand-motion-out-duration) var(--brand-motion-out);
}

/* Snap-to-neutral state. Added by brand-motion.js on pointerdown so the click-
   to-navigate frame shows a calm card, not an overshoot peak. Removed after
   ~320ms so subsequent hovers animate normally (matters for in-page anchor
   clicks and bfcache restores). */
.brand-lift.brand-lift--snap,
.brand-lift.brand-lift--snap:hover {
  transform: perspective(1200px) rotateX(0) rotateY(0) translateY(0) !important;
  transition: transform 0ms linear, box-shadow 80ms linear, border-color 80ms linear !important;
}
.brand-lift.brand-lift--snap .brand-lift__image,
.brand-lift.brand-lift--snap:hover .brand-lift__image {
  transform: translate3d(0, 0, 0) scale(1) !important;
  transition: transform 0ms linear !important;
}
.brand-lift.brand-lift--snap::after,
.brand-lift.brand-lift--snap:hover::after { opacity: 0 !important; }

/* Cursor light: a soft Glow-Green radial overlay that sits above the image but
   below the text. pointer-events: none so it never blocks interactions. Hidden
   until hover so the card reads as static at rest. Plain alpha compositing —
   mix-blend-mode: screen can render erratically during the frame-freeze that
   happens when the browser begins a same-origin navigation. */
.brand-lift::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: radial-gradient(
    220px circle at var(--lx) var(--ly),
    rgba(var(--brand-glow), 0.28) 0%,
    rgba(var(--brand-glow), 0.10) 30%,
    rgba(var(--brand-glow), 0) 65%
  );
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--brand-motion-in-duration) var(--brand-motion-curve);
  z-index: 2;
}
.brand-lift:hover {
  transform:
    perspective(1200px)
    rotateX(calc(var(--my) * -3deg))
    rotateY(calc(var(--mx) * 3deg))
    translateY(-8px);
  box-shadow:
    0 20px 36px rgba(var(--brand-emerald), 0.20),
    0 8px 14px rgba(var(--brand-emerald), 0.14),
    0 0 0 1px rgba(var(--brand-emerald), 0.18);
}
.brand-lift:hover::after { opacity: 1; }

/* Inner image parallax + scale on hover. Opt in by adding .brand-lift__image
   to the existing image element. We translate against the cursor (translates
   away from where the cursor is, like the image is being pulled by the
   parallax) and apply a subtle scale-up so the edges don't reveal the card
   background. Uses the same softened spring as the card lift so the image
   doesn't overshoot dramatically on entry. */
.brand-lift__image {
  transform: translate3d(0, 0, 0) scale(1);
  transition: transform 280ms cubic-bezier(0.22, 1.2, 0.36, 1);
}
.brand-lift:hover .brand-lift__image {
  transform:
    translate3d(
      calc(var(--mx) * -6px),
      calc(var(--my) * -6px),
      0
    )
    scale(1.04);
}

/* Content micro-shift: the title rises slightly on hover, CTA fades in from
   below. Both opt in via class — un-classed cards keep their static layout. */
.brand-lift__title {
  transition: transform var(--brand-motion-in-duration) var(--brand-motion-curve);
}
.brand-lift:hover .brand-lift__title {
  transform: translateY(-3px) translateZ(8px);
}

.brand-lift__cta {
  opacity: 0;
  transform: translateY(8px);
  transition:
    opacity var(--brand-motion-in-duration) var(--brand-motion-curve),
    transform var(--brand-motion-in-duration) var(--brand-motion-curve);
}
.brand-lift:hover .brand-lift__cta {
  opacity: 1;
  transform: translateY(0);
}

/* Border draw-in — 4 segments around the card perimeter, staggered. Each is a
   pseudo-element child of a wrapper. To keep it simple, we use 2 pseudo
   elements (::before on .brand-lift handles top+right via clip-path; not
   feasible in pure CSS without extra wrappers). Trade-off: we use a single
   inset shadow that "draws" by transitioning its spread. Cheaper than 4
   wrappers, reads similarly enough at this scale. */
.brand-lift::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  z-index: 1;
  box-shadow: inset 0 0 0 0 rgb(var(--brand-emerald));
  transition: box-shadow var(--brand-motion-in-duration) var(--brand-motion-curve);
}
.brand-lift:hover::before { box-shadow: inset 0 0 0 1.5px rgb(var(--brand-emerald)); }

/* Reduced motion + touch fallback: keep the lift + shadow + emerald border,
   drop tilt, cursor light, parallax, scale, and content shifts. */
@media (prefers-reduced-motion: reduce), (hover: none) {
  .brand-lift, .brand-lift:hover {
    transform: none !important;
  }
  .brand-lift:hover {
    box-shadow: 0 8px 18px rgba(var(--brand-emerald), 0.16) !important;
  }
  .brand-lift::after { display: none !important; }
  .brand-lift:hover .brand-lift__image { transform: none !important; }
  .brand-lift:hover .brand-lift__title { transform: none !important; }
  .brand-lift__cta, .brand-lift:hover .brand-lift__cta {
    opacity: 1 !important;
    transform: none !important;
  }
}

/* ---------- Marquee announcement bar ---------- */
/* The Glow Green strip above the header in the mockup. */

/* The marquee section's outer wrapper pins to the top of the viewport so the
   crosshair-rotation reads as the user scrolls. z-index 5 keeps it above the
   sticky header (z-index 4). --brand-marquee-height is set on :root by
   brand-motion.js after the marquee lays out; the header's own top calc lives
   in sections/header.liquid (ID-level specificity required to beat the
   header's own #shopify-section-... sticky-top rule) and reads the same
   variable to offset its sticky top. */
.brand-marquee-section {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 5;
}

.brand-marquee {
  background: rgb(var(--brand-glow));
  color: rgb(var(--brand-black));
  font-family: var(--brand-font-accent);
  font-size: 12px;
  line-height: 1.4;
  letter-spacing: .14em;
  text-transform: uppercase;
  font-weight: 400;
  overflow: hidden;
  position: relative;
  min-height: 36px;
  display: flex;
  align-items: center;
}
.brand-marquee__track {
  display: flex;
  padding: 10px 0;
  white-space: nowrap;
  animation: brand-marquee-scroll 28s linear infinite;
  will-change: transform;
  flex: 1 1 auto;
}
.brand-marquee__item {
  display: inline-flex;
  align-items: center;
  gap: 64px;
  padding-right: 64px;
}
@keyframes brand-marquee-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
/* Precision+ glyphs in the marquee rotate with page scroll. brand-motion.js
   writes --brand-scroll-rotation on :root once per rAF tick; the variable
   defaults to 0deg when JS hasn't run yet, so the glyphs stay still on the
   first paint and on JS-disabled browsers. Scoped to .brand-marquee so the
   identical .brand-plus glyphs used in section eyebrows, footer link prefixes,
   and reveal cascades stay fixed. */
.brand-marquee .brand-plus {
  transform: rotate(var(--brand-scroll-rotation, 0deg));
  /* No transition — the rAF tick updates the variable smoothly enough on its
     own. Adding a transition lags the rotation behind the scroll and the
     coupling stops feeling tight. */
  will-change: transform;
}
@media (prefers-reduced-motion: reduce) {
  .brand-marquee__track { animation: none; justify-content: center; white-space: normal; }
  .brand-marquee__item { flex-wrap: wrap; justify-content: center; padding-right: 0; }
  .brand-marquee__item[aria-hidden="true"] { display: none; }
  .brand-marquee .brand-plus { transform: none !important; }
}

/* ---------- Precision+ inline mark helper ---------- */

.brand-plus {
  display: inline-block;
  width: 1em;
  height: 1em;
  vertical-align: -0.12em;
  background-color: currentColor;
  mask: var(--brand-plus-glyph) no-repeat center / contain;
  -webkit-mask: var(--brand-plus-glyph) no-repeat center / contain;
}

/* ============================================================
   Brand hero (Phase 3 / task #7)
   Full-bleed Train With Intent homepage lead.
   ============================================================ */

.brand-hero {
  position: relative;
  color: rgb(var(--brand-white));
  background: rgb(var(--brand-black));
  overflow: hidden;
  isolation: isolate;
  margin-top: 0;
}
.brand-hero--full { min-height: clamp(560px, 92vh, 920px); }
.brand-hero--large { min-height: clamp(480px, 75vh, 760px); }
.brand-hero--medium { min-height: clamp(380px, 60vh, 600px); }

.brand-hero__image {
  position: absolute;
  inset: 0;
  z-index: -2;
  display: block;
}
.brand-hero__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.brand-hero__video {
  position: absolute;
  inset: 0;
  z-index: -2;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  /* Slight scale hides any 1px letterbox edges from H.264 sources. */
  transform: scale(1.001);
  background: rgb(var(--brand-black));
}
.brand-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(
      to top,
      rgba(0, 0, 0, var(--brand-hero-overlay, .55)) 0%,
      rgba(0, 0, 0, var(--brand-hero-overlay-mid, .3)) 45%,
      rgba(0, 0, 0, var(--brand-hero-overlay-top, .15)) 100%
    );
}
.brand-hero__content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  min-height: inherit;
  padding-block: 88px;
  gap: 20px;
  max-width: 1440px;
}
.brand-hero__eyebrow { margin: 0; }
.brand-hero__heading {
  max-width: 18ch;
  font-size: 112px;
  line-height: .9;
  letter-spacing: 0;
}
.brand-hero__heading .brand-headline__em { display: inline-block; }
.brand-hero__body {
  max-width: 48ch;
  opacity: .92;
}
.brand-hero__actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 8px;
}

@media (max-width: 1199px) {
  .brand-hero__heading { font-size: 84px; }
}
@media (max-width: 749px) {
  /* Cap the hero so the headline + body + CTAs sit above the fold on small phones.
     100svh accounts for the retractable browser chrome on iOS/Android.
     min-height keeps the image from collapsing on very short viewports. */
  .brand-hero--full {
    min-height: 520px;
    max-height: 100svh;
  }
  .brand-hero__content {
    padding-inline: 20px;
    padding-block: 24px 32px;
  }
  .brand-hero__heading {
    max-width: 11ch;
    font-size: 52px;
  }
  .brand-hero__actions {
    width: 100%;
    align-items: stretch;
  }
  .brand-hero__cta { flex: 1 1 100%; }
}

/* ============================================================
   Header restyle (Phase 3 / task #5)
   Overrides Focal's .header__* classes without touching markup.
   Settings tokens (header_background, header_text_color) are
   already Black/White from the Phase 1 token pass.
   ============================================================ */

.shopify-section--header .header,
.shopify-section-group-header-group .header,
#shopify-section-header .header {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
  border-bottom: 1px solid rgba(var(--brand-white), .08);
}

/* Luxury breathing room — generous desktop padding, larger inter-item gap. */
@media (min-width: 1000px) {
  .header__wrapper { padding-block: clamp(20px, 1.6vw, 30px); }
  .header__linklist { gap: clamp(20px, 2.4vw, 44px); }
}

/* Hide the in-header locale/country popover — footer aside already carries it,
   keeps the dark header bar uncluttered. */
.shopify-section-group-header-group .header__cross-border { display: none; }

/* Nav links: mono accents with Precision+ glyph prefix. Wider letter-spacing
   reads more editorial / less utilitarian. */
.header__linklist-item > .header__linklist-link {
  display: inline-flex;
  align-items: center;
  gap: .55em;
  font-family: var(--brand-font-accent);
  font-weight: 400;
  font-size: 12px;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: rgb(var(--brand-white));
  text-decoration: none;
  padding-block: 10px;
  transition: color .15s ease;
}
.header__linklist-item > .header__linklist-link::before {
  content: "";
  width: 12px;
  height: 12px;
  background-color: rgb(var(--brand-emerald));
  mask: var(--brand-plus-glyph) no-repeat center / contain;
  -webkit-mask: var(--brand-plus-glyph) no-repeat center / contain;
  flex-shrink: 0;
  transition: background-color .15s ease, transform .2s ease;
}
.header__linklist-item > .header__linklist-link:hover,
.header__linklist-item > .header__linklist-link[aria-expanded="true"] {
  color: rgb(var(--brand-emerald));
}
.header__linklist-item > .header__linklist-link:hover::before,
.header__linklist-item > .header__linklist-link[aria-expanded="true"]::before {
  background-color: rgb(var(--brand-neon));
  transform: rotate(90deg);
}

/* Header nav underline timing — tighter than the global .3s default.
   The Focal `.link--animated:after` rule reveals on :hover OR
   [aria-expanded="true"]. Scope a faster transition here so the
   reveal/retract feels paired with the color/glyph timing above
   (≈.18s), and so cross-item traversal doesn't drag a slow underline
   across the next item. */
.header__linklist-item > .header__linklist-link.link--animated:after {
  transition: transform .18s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Icons: white, Emerald on hover. */
.header .header__icon-wrapper,
.header__icon-wrapper svg { color: rgb(var(--brand-white)); }
.header .header__icon-wrapper:hover { color: rgb(var(--brand-emerald)); }

/* Cart count badge in Emerald. */
.header__cart-count {
  background: rgb(var(--brand-emerald)) !important;
  color: rgb(var(--brand-white)) !important;
  font-weight: 600;
}

/* Locale / country popover trigger buttons match dark canvas. */
.header__cross-border .popover-button {
  color: rgba(var(--brand-white), .8);
  font-family: var(--brand-font-accent);
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  font-weight: 400;
}
.header__cross-border .popover-button:hover { color: rgb(var(--brand-white)); }

/* Dropdown menus: dark surface to match. */
.shopify-section-group-header-group .nav-dropdown,
#shopify-section-header .nav-dropdown {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
  border: 1px solid rgba(var(--brand-white), .1);
}
.shopify-section-group-header-group .nav-dropdown__link,
#shopify-section-header .nav-dropdown__link {
  color: rgba(var(--brand-white), .85);
  font-family: var(--brand-font-accent);
  font-weight: 400;
  font-size: 13px;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.shopify-section-group-header-group .nav-dropdown__link:hover,
#shopify-section-header .nav-dropdown__link:hover {
  color: rgb(var(--brand-emerald));
}

/* Mega menu (if a link triggers Focal's mega menu) — dark canvas. */
.shopify-section-group-header-group .mega-menu,
#shopify-section-header .mega-menu {
  background: rgb(var(--brand-black));
  color: rgb(var(--brand-white));
  border-top: 1px solid rgba(var(--brand-white), .08);
}

.mega-menu__guided-title {
  grid-column: 1 / -1;
  margin: 0 0 12px;
  color: rgba(var(--brand-white), .62);
  font-family: var(--brand-font-accent);
  font-size: 11px;
  letter-spacing: 0;
  text-transform: uppercase;
}

/* ============================================================
   Brand mega-menu (Concept C)
   Featured product card + featured collection card + small nav grid.
   Opt-in via the mega_menu block's "Use brand mega-menu layout" toggle.
   ============================================================ */

.mega-menu.mega-menu--brand {
  padding: 0;
  /* Constrain the dark surface itself to match the visual width of the
     header bar — without this, the .mega-menu base inherits Focal's
     `width: 100%; position: absolute; left: 0` (theme.css line 8067-72)
     and spans full viewport, while the grid inside it stays inset. At
     wider viewports that produces a "dark band wider than the content"
     look that reads as inconsistent edge behavior. Centering with a
     max-width fixes that — surface and content share the same edges. */
  left: 50%;
  transform: translateX(-50%);
  width: min(100%, var(--mega-menu-brand-width, 1480px));
  border-left: 1px solid rgba(var(--brand-white), .04);
  border-right: 1px solid rgba(var(--brand-white), .04);
}

/* Kill the Focal page-scrim — full-viewport `.mega-menu:after` rule
   in theme.css line 8079 paints a black 30%-opacity backdrop below
   the open mega-menu. On Shadow Green it reads as a hard shadow
   band underneath the menu. Brand revamp doesn't want it. */
.shopify-section-group-header-group .mega-menu:after,
#shopify-section-header .mega-menu:after {
  display: none;
}

.mega-menu--brand__grid {
  display: grid;
  /* Single layout for all three mega-menus (Shop / Explore / Learn):
     nav column on the left (empty dark space when no Shopify children
     exist for that menu), two hero cards STACKED vertically on the
     right. Cards have identical dimensions in every menu, so their
     typography reads at the same visual scale regardless of which
     trigger you opened. */
  grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
  grid-template-rows: 1fr 1fr;
  min-height: 420px;
  padding-block: 28px;
}

/* Pinned positions — explicit so card placement doesn't shift based
   on whether the nav block is present. Without these, the absence of
   the nav element on Explore / Learn would let auto-flow drop the
   cards into the left column (wrong) or side-by-side in one row
   (different shape from Shop's stacked cards → different visual font
   weight per the owner's report). */
.mega-menu--brand__nav { grid-column: 1; grid-row: 1 / span 2; }
.mega-menu--brand__card--product { grid-column: 2; grid-row: 1; }
.mega-menu--brand__card--collection { grid-column: 2; grid-row: 2; }
.mega-menu--brand__card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 28px 32px;
  overflow: hidden;
  isolation: isolate;
  color: rgb(var(--brand-white));
  text-decoration: none;
  border-left: 1px solid rgba(var(--brand-white), .05);
  /* Cards stacked vertically alongside nav — explicit min-height
     keeps each card legible without bloating overall menu height. */
  min-height: 180px;
}
.mega-menu--brand__card-image {
  position: absolute;
  inset: 0;
  z-index: -2;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform .4s ease;
}
.mega-menu--brand__card::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(0deg, rgba(0,0,0,.85) 0%, rgba(0,0,0,.2) 60%, rgba(0,0,0,0) 100%);
}
.mega-menu--brand__card:hover .mega-menu--brand__card-image { transform: scale(1.04); }
.mega-menu--brand__card-body {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-width: 32ch;
}
.mega-menu--brand__card-eyebrow {
  margin: 0;
  font-family: var(--brand-font-accent);
  font-size: 12px;
  letter-spacing: 0;
  text-transform: uppercase;
  color: rgb(var(--brand-glow));
}
.mega-menu--brand__card-title {
  margin: 0;
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(28px, 2.2vw, 36px);
  line-height: 1;
  letter-spacing: 0;
  text-transform: uppercase;
}
.mega-menu--brand__card-meta {
  margin: 6px 0 14px;
  font-family: var(--brand-font-body);
  font-size: 15px;
  line-height: 1.4;
  color: rgba(var(--brand-white), .82);
}
.mega-menu--brand__card-cta { align-self: flex-start; }

.mega-menu--brand__nav {
  padding: 32px 48px;
  background: rgb(var(--brand-black));
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px 40px;
  align-content: start;
}
.mega-menu--brand__nav-header {
  grid-column: 1 / -1;
  padding-bottom: 4px;
}
.mega-menu--brand__section-label {
  margin: 0 0 10px;
  font-family: var(--brand-font-accent);
  font-size: 12px;
  letter-spacing: 0;
  text-transform: uppercase;
  color: rgb(var(--brand-glow));
}
.mega-menu--brand__nav-heading {
  margin: 0;
  font-family: var(--brand-font-display);
  font-size: clamp(30px, 2.6vw, 40px);
  font-weight: 600;
  line-height: .95;
  letter-spacing: 0;
  text-transform: uppercase;
  color: rgb(var(--brand-white));
}
.mega-menu--brand__nav-col {
  padding-top: 14px;
  border-top: 1px solid rgba(var(--brand-white), .1);
}
.mega-menu--brand__nav-eyebrow {
  display: block;
  font-family: var(--brand-font-accent);
  font-size: 15px;
  line-height: 1.2;
  letter-spacing: 0;
  text-transform: uppercase;
  color: rgb(var(--brand-white));
  text-decoration: none;
}
a.mega-menu--brand__nav-eyebrow:hover { color: rgb(var(--brand-glow)); }

/* Explore / Learn pattern — these mega-menus have Shopify Navigation
   children but no grandchildren, so each top-level child renders via
   .mega-menu--brand__nav-eyebrow with no .mega-menu--brand__nav-links
   list beneath it. In Shop, eyebrows function as CATEGORY HEADERS
   above a list of primary links (Pro Series, Home Series…). In
   Explore / Learn the eyebrow IS the primary link — so the small
   uppercase mono treatment reads as undersized compared to Shop's
   actual link list. Promote it to a body-font primary-link size when
   no .nav-links list exists in the column. */
.mega-menu--brand__nav-col:not(:has(.mega-menu--brand__nav-links)) {
  padding-top: 18px;
}
.mega-menu--brand__nav-col:not(:has(.mega-menu--brand__nav-links)) > .mega-menu--brand__nav-eyebrow {
  font-family: var(--brand-font-body);
  font-size: clamp(20px, 1.5vw, 24px);
  font-weight: 500;
  letter-spacing: 0;
  text-transform: none;
  line-height: 1.25;
  color: rgba(var(--brand-white), .92);
  padding-block: 4px;
  transition: color .15s ease;
}
