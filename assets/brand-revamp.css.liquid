/* --- Product card ------------------------------------------
   Mirrors the CRO grid card's information architecture (paired
   ideal_for / most_popular badges, dimensions line, italic green
   benefit tagline, hardcoded 5-star rating, "View Details" CTA) and
   re-skins it in brand typography. See snippets/product-item-brand.liquid.
   ----------------------------------------------------------- */
.brand-product-card {
  display: flex;
  flex-direction: column;
  background: rgb(var(--brand-white));
  border: 1px solid rgba(var(--brand-shadow), .10);
  border-radius: 10px;
  overflow: hidden;
  transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  color: rgb(var(--brand-shadow));
  height: 100%;
  position: relative;
}
.brand-product-card:hover {
  transform: translateY(-2px);
  border-color: rgba(var(--brand-emerald), .65);
  box-shadow: 0 14px 40px -22px rgba(var(--brand-shadow), .35);
}
.brand-product-card--sold-out { opacity: .72; }

.brand-product-card__media-wrapper {
  position: relative;
  background: rgb(var(--brand-white));
  overflow: hidden;
  border-bottom: 1px solid rgba(var(--brand-shadow), .06);
}
.brand-product-card__media {
  display: block;
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
}
.brand-product-card__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: opacity .3s ease, transform .5s ease;
}
.brand-product-card__image--alt {
  opacity: 0;
}
.brand-product-card:hover .brand-product-card__image--primary { transform: scale(1.03); }
.brand-product-card:hover .brand-product-card__image--alt {
  opacity: 1;
}

/* Badges: left = ideal_for (brand Emerald), right = popular (Shadow). */
.brand-product-card__badges-left {
  position: absolute;
  top: 12px;
  left: 12px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  z-index: 2;
  max-width: calc(50% - 24px);
}
.brand-product-card__badges-right {
  position: absolute;
  top: 12px;
  right: 12px;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 6px;
  z-index: 2;
  max-width: calc(50% - 24px);
}
.brand-product-card__badge {
  font-family: var(--brand-font-accent);
  font-size: 10.5px;
  letter-spacing: .12em;
  text-transform: uppercase;
  font-weight: 500;
  padding: 5px 10px;
  border-radius: 4px;
  line-height: 1.2;
  white-space: nowrap;
}
.brand-product-card__badge--ideal-for {
  background: rgb(var(--brand-emerald));
  color: rgb(var(--brand-white));
}
.brand-product-card__badge--popular {
  background: rgb(var(--brand-shadow));
  color: rgb(var(--brand-white));
}
.brand-product-card__badge--sold-out {
  background: rgba(var(--brand-shadow), .82);
  color: rgb(var(--brand-white));
}
.brand-product-card__badge--save {
  background: rgb(var(--brand-neon));
  color: rgb(var(--brand-shadow));
}

.brand-product-card__body {
  padding: clamp(16px, 1.6vw, 20px);
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1 1 auto;
}

.brand-product-card__title-link {
  text-decoration: none;
  color: inherit;
}
.brand-product-card__title {
  margin: 0;
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(22px, 2vw, 30px);
  letter-spacing: -0.005em;
  line-height: 1;
  text-transform: uppercase;
  color: rgb(var(--brand-shadow));
}

.brand-product-card__spec {
  margin: 0;
  font-family: var(--brand-font-accent);
  font-size: 12px;
  letter-spacing: .06em;
  color: rgba(var(--brand-shadow), .72);
}

.brand-product-card__reviews {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 2px;
}
.brand-product-card__stars {
  display: inline-flex;
  align-items: center;
  gap: 1px;
  color: #f5a623;
}
.brand-product-card__stars svg { display: block; }
.brand-product-card__reviews-text {
  font-family: var(--brand-font-accent);
  font-size: 12px;
  letter-spacing: .04em;
  color: rgba(var(--brand-shadow), .68);
}

.brand-product-card__price-group {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}
.brand-product-card__price {
  font-family: var(--brand-font-display);
  font-weight: 600;
  font-size: clamp(20px, 1.8vw, 26px);
  letter-spacing: -0.005em;
  color: rgb(var(--brand-shadow));
}
.brand-product-card__price--sale {
  color: rgb(var(--brand-emerald));
}
.brand-product-card__price-compare {
  font-family: var(--brand-font-accent);
  font-size: 13px;
  color: rgba(var(--brand-shadow), .55);
  text-decoration: line-through;
}

.brand-product-card__benefit {
  margin: 0;
  font-family: var(--brand-font-body);
  font-style: italic;
  font-size: 14px;
  line-height: 1.35;
  color: rgb(var(--brand-emerald));
}

.brand-product-card__cta {
  margin-top: auto;
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  font-family: var(--brand-font-accent);
  font-size: 13px;
  letter-spacing: .14em;
  text-transform: uppercase;
  font-weight: 600;
  padding: 14px 16px;
  background: rgb(var(--brand-emerald));
  color: rgb(var(--brand-white));
  border-radius: 4px;
  transition: background .2s ease, transform .2s ease;
}
.brand-product-card__cta:hover {
  background: rgb(var(--brand-shadow));
  transform: translateY(-1px);
}
.brand-product-card__cta--disabled {
  background: rgba(var(--brand-shadow), .15);
  color: rgba(var(--brand-shadow), .6);
  pointer-events: none;
}

@media (max-width: 540px) {
  .brand-product-card__body { padding: 14px; gap: 6px; }
  .brand-product-card__title { font-size: 20px; }
  .brand-product-card__badge { font-size: 10px; padding: 4px 8px; }
  .brand-product-card__benefit { font-size: 13px; }
  .brand-product-card__cta { font-size: 12px; padding: 12px 14px; }
}

/* --- Cross-link block -------------------------------------- */
.brand-cross-links {
  padding-block: clamp(48px, 6vw, 80px);
}
.brand-cross-links__inner { position: relative; }
.brand-cross-links__header {
